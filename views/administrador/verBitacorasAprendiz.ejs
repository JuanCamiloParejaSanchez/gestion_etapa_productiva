<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <a class="nav-link" href="/administrador/listar-aprendices">
                    <i class="fas fa-arrow-left me-2"></i>
                    Regresar a la Lista de Aprendices
                </a>
            </li>
        </ul>
    </div>
</nav>

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<%- contentFor('styles') %>
<style>
    .sentiment-score {
        font-size: 1.2em;
        font-weight: bold;
        padding: 0.5rem;
        border-radius: 0.5rem;
        text-align: center;
    }
    .sentiment-very-positive { background-color: #d4edda; color: #155724; }
    .sentiment-positive { background-color: #d1ecf1; color: #0c5460; }
    .sentiment-neutral { background-color: #fff3cd; color: #856404; }
    .sentiment-negative { background-color: #f8d7da; color: #721c24; }
    .sentiment-very-negative { background-color: #f5c6cb; color: #721c24; }
    
    .alert-card {
        border-left: 4px solid;
        margin-bottom: 1rem;
    }
    .alert-high { border-left-color: #dc3545; }
    .alert-medium { border-left-color: #ffc107; }
    .alert-low { border-left-color: #17a2b8; }
    
    .trend-indicator {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
        font-weight: bold;
    }
    .trend-improving { background-color: #d4edda; color: #155724; }
    .trend-stable { background-color: #fff3cd; color: #856404; }
    .trend-worsening { background-color: #f8d7da; color: #721c24; }
</style>

<%- contentFor('body') %>
<!-- Encabezado -->
<div class="container-fluid mt-4">
    <h2 class="mb-4">Bitácoras del Aprendiz</h2>
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Información del Aprendiz</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Nombre:</strong> <%= aprendiz.nombres %> <%= aprendiz.primerApellido %> <%= aprendiz.segundoApellido %></p>
                    <p><strong>Documento:</strong> <%= aprendiz.tipoDocumento %>: <%= aprendiz.numeroDocumento %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Programa:</strong> <%= aprendiz.programaFormacion %></p>
                    <p><strong>Ficha:</strong> <%= aprendiz.numeroFicha %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Análisis de Sentimientos -->
    <% if (erroresAnalisis && erroresAnalisis.some(error => !/Data truncated for column/.test(error.error))) { %>
        <div class="alert alert-warning mb-4">
            <h5 class="mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Advertencias en el Análisis</h5>
            <ul class="mb-0">
                <% erroresAnalisis.forEach(error => { %>
                    <% if (!/Data truncated for column/.test(error.error)) { %>
                    <li>
                        <% if (error.bitacoraId) { %>
                            Error en bitácora #<%= error.bitacoraId %>: <%= error.error %>
                        <% } else { %>
                            <%= error.error %>
                            <% if (error.detalles) { %>
                                - <%= error.detalles %>
                            <% } %>
                        <% } %>
                    </li>
                    <% } %>
                <% }); %>
            </ul>
        </div>
    <% } %>
    <% /* Estado de IBM Watson AI eliminado por solicitud del usuario */ %>

    <!-- Modal de Alertas -->
    <div class="modal fade" id="alertaCompromiso" tabindex="-1" aria-labelledby="alertaCompromisoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="alertaCompromisoLabel">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Estado del Aprendiz
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="estadoAprendiz"></div>
                    <div class="mt-3">
                        <h6 class="mb-2">Acciones Recomendadas:</h6>
                        <ul id="accionesRecomendadas" class="list-group">
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <% if (analisisSentimientos && analisisSentimientos.sentimientoGeneral) { %>
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-brain me-2"></i>Análisis de Sentimientos - IA</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Score Promedio</h6>
                                    <div class="sentiment-score sentiment-<%= analisisSentimientos.sentimientoGeneral.toLowerCase().replace('_', '-') %>">
                                        <%= analisisSentimientos.scorePromedio ? analisisSentimientos.scorePromedio.toFixed(2) : '0.00' %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Tendencia</h6>
                                    <div class="trend-indicator <%= analisisSentimientos.tendencia ? analisisSentimientos.tendencia.toLowerCase() : 'neutral' %>">
                                        <% if (analisisSentimientos.tendencia === 'positiva') { %>
                                            <span class="text-success"><i class="fas fa-arrow-up"></i> Mejorando</span>
                                        <% } else if (analisisSentimientos.tendencia === 'negativa') { %>
                                            <span class="text-danger"><i class="fas fa-arrow-down"></i> Empeorando</span>
                                        <% } else { %>
                                            <span class="text-secondary"><i class="fas fa-arrows-alt-h"></i> Estable</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Variabilidad</h6>
                                    <div class="variability-indicator">
                                        <%= (analisisSentimientos.variabilidad * 100).toFixed(1) %>%
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h6>Nivel de Compromiso</h6>
                                    <div class="engagement-level">
                                        <%= analisisSentimientos && analisisSentimientos.nivelCompromiso ? analisisSentimientos.nivelCompromiso : 0 %>/100
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Gráfico de tendencia de scores históricos -->
                        <% if (bitacoras && bitacoras.length > 1) { %>
                        <div class="row mt-4">
                            <div class="col-12">
                                <canvas id="sentimentTrendChart" height="80"></canvas>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Análisis Detallado de Watson -->
        <% if (analisisSentimientos && analisisSentimientos.analisisDetallado && analisisSentimientos.analisisDetallado.length > 0) { %>
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Análisis Detallado por Bitácora</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Desafíos</th>
                                            <th>Logros</th>
                                            <th>Comunicación</th>
                                            <th>Score Promedio</th>
                                            <th>Confianza</th>
                                            <th>Emociones Detectadas</th>
                                            <th>Palabras Clave</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% analisisSentimientos.analisisDetallado.forEach((analisis, index) => { %>
                                            <tr>
                                                <td><%= bitacoras[index] ? new Date(bitacoras[index].fechaCreacion).toLocaleDateString() : 'N/A' %></td>
                                                <td>
                                                    <div class="small">
                                                        <strong>Score:</strong> <%= analisis.analisisDetallado.desafio.score.toFixed(2) %>
                                                        <br>
                                                        <span class="badge bg-<%= analisis.analisisDetallado.desafio.sentimiento === 'positivo' ? 'success' : 
                                                                                analisis.analisisDetallado.desafio.sentimiento === 'negativo' ? 'danger' : 
                                                                                'warning' %>">
                                                            <%= analisis.analisisDetallado.desafio.sentimiento %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="small">
                                                        <strong>Score:</strong> <%= analisis.analisisDetallado.logro.score.toFixed(2) %>
                                                        <br>
                                                        <span class="badge bg-<%= analisis.analisisDetallado.logro.sentimiento === 'positivo' ? 'success' : 
                                                                                analisis.analisisDetallado.logro.sentimiento === 'negativo' ? 'danger' : 
                                                                                'warning' %>">
                                                            <%= analisis.analisisDetallado.logro.sentimiento %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="small">
                                                        <strong>Score:</strong> <%= analisis.analisisDetallado.comunicacion.score.toFixed(2) %>
                                                        <br>
                                                        <span class="badge bg-<%= analisis.analisisDetallado.comunicacion.sentimiento === 'positivo' ? 'success' : 
                                                                                analisis.analisisDetallado.comunicacion.sentimiento === 'negativo' ? 'danger' : 
                                                                                'warning' %>">
                                                            <%= analisis.analisisDetallado.comunicacion.sentimiento %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <strong><%= analisis.scorePromedio.toFixed(2) %></strong>
                                                </td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar" role="progressbar" 
                                                             style="width: <%= (analisis.confianzaGeneral * 100) %>%"
                                                             aria-valuenow="<%= (analisis.confianzaGeneral * 100) %>" 
                                                             aria-valuemin="0" aria-valuemax="100">
                                                            <%= (analisis.confianzaGeneral * 100).toFixed(0) %>%
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (analisis.analisisDetallado.desafio.emociones && Object.keys(analisis.analisisDetallado.desafio.emociones).length > 0) { %>
                                                        <% Object.entries(analisis.analisisDetallado.desafio.emociones).forEach(([emotion, score]) => { %>
                                                            <% if (score > 0.3) { %>
                                                                <span class="badge bg-info me-1 mb-1">
                                                                    <%= emotion %>: <%= (score * 100).toFixed(0) %>%
                                                                </span>
                                                            <% } %>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <span class="text-muted small">Sin datos</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (analisis.analisisDetallado.desafio.palabrasClave && analisis.analisisDetallado.desafio.palabrasClave.length > 0) { %>
                                                        <% analisis.analisisDetallado.desafio.palabrasClave.slice(0, 3).forEach(palabra => { %>
                                                            <span class="badge bg-secondary me-1 mb-1">
                                                                <%= palabra.text %>
                                                            </span>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <span class="text-muted small">Sin datos</span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recomendaciones de Watson -->
            <% if (analisisSentimientos.recomendaciones && analisisSentimientos.recomendaciones.length > 0) { %>
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-warning text-dark">
                                <h5 class="mb-0"><i class="fas fa-lightbulb me-2"></i>Recomendaciones de IA</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <% analisisSentimientos.recomendaciones.forEach(recomendacion => { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="alert alert-<%= recomendacion.prioridad === 'alta' ? 'danger' : 
                                                                     recomendacion.prioridad === 'media' ? 'warning' : 
                                                                     'info' %>">
                                                <h6 class="alert-heading">
                                                    <i class="fas fa-<%= recomendacion.prioridad === 'alta' ? 'exclamation-triangle' : 
                                                                       recomendacion.prioridad === 'media' ? 'info-circle' : 
                                                                       'check-circle' %> me-2"></i>
                                                    <%= recomendacion.area %>
                                                </h6>
                                                <p class="mb-2"><%= recomendacion.mensaje %></p>
                                                <% if (recomendacion.acciones && recomendacion.acciones.length > 0) { %>
                                                    <ul class="mb-0 small">
                                                        <% recomendacion.acciones.forEach(accion => { %>
                                                            <li><%= accion %></li>
                                                        <% }); %>
                                                    </ul>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Entidades y Contextos Detectados -->
            <% if (analisisSentimientos && analisisSentimientos.analisisDetallado && analisisSentimientos.analisisDetallado.length > 0) { %>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Entidades Detectadas</h5>
                            </div>
                            <div class="card-body">
                                <% 
                                const todasLasEntidades = [];
                                analisisSentimientos.analisisDetallado.forEach(analisis => {
                                    if (analisis.analisisDetallado.desafio.entidades) {
                                        todasLasEntidades.push(...analisis.analisisDetallado.desafio.entidades);
                                    }
                                    if (analisis.analisisDetallado.logro.entidades) {
                                        todasLasEntidades.push(...analisis.analisisDetallado.logro.entidades);
                                    }
                                    if (analisis.analisisDetallado.comunicacion.entidades) {
                                        todasLasEntidades.push(...analisis.analisisDetallado.comunicacion.entidades);
                                    }
                                });
                                const entidadesUnicas = [...new Set(todasLasEntidades.map(e => e.text))];
                                %>
                                <% if (entidadesUnicas.length > 0) { %>
                                    <div class="contexts-container">
                                        <% entidadesUnicas.slice(0, 10).forEach(entidad => { %>
                                            <span class="badge bg-primary me-1 mb-1">
                                                <%= entidad %>
                                            </span>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="text-muted">No se detectaron entidades específicas.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Contextos Identificados</h5>
                            </div>
                            <div class="card-body">
                                <% if (analisisSentimientos.contextosGenerales && analisisSentimientos.contextosGenerales.length > 0) { %>
                                    <div class="contexts-container">
                                        <% analisisSentimientos.contextosGenerales.forEach(contexto => { %>
                                            <span class="badge bg-secondary me-1 mb-1">
                                                <%= contexto %>
                                            </span>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="text-muted">No se identificaron contextos específicos.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% } %>
    <% } else { %>
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No hay suficientes datos para realizar un análisis de sentimientos.
        </div>
    <% } %>

    <!-- Lista de Bitácoras -->
    <% /* Comentada la restricción de 15 días para pruebas */ %>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Bitácoras Registradas</h5>
                </div>
                <div class="card-body">
                    <div class="accordion" id="bitacorasAccordion">
                        <% bitacoras.forEach(function(b, idx) { %>
                            <div class="accordion-item mb-2">
                                <h2 class="accordion-header" id="heading-<%= b.id %>">
                                    <button class="accordion-button <%= idx !== 0 ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= b.id %>" aria-expanded="<%= idx === 0 ? 'true' : 'false' %>" aria-controls="collapse-<%= b.id %>">
                                        <strong>Bitácora del <%= new Date(b.fechaCreacion).toLocaleDateString() %></strong>
                                        &nbsp;| Sentimiento general: <span class="badge bg-<%= b.sentimiento_general === 'positivo' ? 'success' : (b.sentimiento_general === 'negativo' ? 'danger' : 'secondary') %>"><%= b.sentimiento_general %></span>
                                        &nbsp;| Score promedio: <%= b.score_promedio %>
                                    </button>
                                </h2>
                                <div id="collapse-<%= b.id %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>" aria-labelledby="heading-<%= b.id %>" data-bs-parent="#bitacorasAccordion">
                                    <div class="accordion-body">
                                        <div class="card shadow-sm mb-3 border-primary">
                                            <div class="card-body">
                                                <h5 class="card-title mb-3 text-primary"><i class="fas fa-user-edit me-2"></i>Respuestas del Aprendiz</h5>
                                                <div class="row">
                                                    <div class="col-md-4 mb-2">
                                                        <strong>Desafío:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.respuesta_desafio %></p>
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <strong>Logro:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.respuesta_logro %></p>
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <strong>Comunicación:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.respuesta_comunicacion %></p>
                                                    </div>
                                                </div>
                                                <hr>
                                                <h6 class="mb-2 text-success"><i class="fas fa-brain me-2"></i>Métricas de Watson</h6>
                                                <div class="row">
                                                    <div class="col-md-4 mb-2">
                                                        <div class="border rounded p-2 mb-2">
                                                            <strong>Score Desafío:</strong> <%= b.score_desafio %><br>
                                                            <strong>Sentimiento:</strong> <%= b.sentimiento_desafio %><br>
                                                            <strong>Emociones:</strong>
                                                            <ul class="mb-1">
                                                                <% let emocionesDesafio = {}; if (b.emociones_desafio && b.emociones_desafio !== '{}' && b.emociones_desafio !== 'null') { try { emocionesDesafio = JSON.parse(b.emociones_desafio) || {}; } catch(e) { emocionesDesafio = {}; } } %>
                                                                <% if (Object.keys(emocionesDesafio).length > 0) { %>
                                                                    <% for (let emo in emocionesDesafio) { %>
                                                                        <li><%= emo %>: <%= emocionesDesafio[emo] %></li>
                                                                    <% } %>
                                                                <% } else { %>
                                                                    <li class="text-muted">Sin datos</li>
                                                                <% } %>
                                                            </ul>
                                                            <strong>Entidades:</strong>
                                                            <ul class="mb-1">
                                                                <% let entidadesDesafio = []; if (b.entidades_desafio) { try { entidadesDesafio = JSON.parse(b.entidades_desafio) || []; } catch(e) { entidadesDesafio = []; } } %>
                                                                <% entidadesDesafio.forEach(function(e) { %>
                                                                    <li><%= e.text %> (<%= e.type %>)</li>
                                                                <% }) %>
                                                            </ul>
                                                            <strong>Palabras clave:</strong>
                                                            <ul class="mb-1">
                                                                <% let palabrasDesafio = []; if (b.palabras_clave_desafio && b.palabras_clave_desafio !== '[]' && b.palabras_clave_desafio !== 'null') { try { palabrasDesafio = JSON.parse(b.palabras_clave_desafio) || []; } catch(e) { palabrasDesafio = []; } } %>
                                                                <% if (palabrasDesafio.length > 0) { %>
                                                                    <% palabrasDesafio.forEach(function(p) { %>
                                                                        <li><%= p.text %></li>
                                                                    <% }) %>
                                                                <% } else { %>
                                                                    <li class="text-muted">Sin datos</li>
                                                                <% } %>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <div class="border rounded p-2 mb-2">
                                                            <strong>Score Logro:</strong> <%= b.score_logro %><br>
                                                            <strong>Sentimiento:</strong> <%= b.sentimiento_logro %><br>
                                                            <strong>Emociones:</strong>
                                                            <ul class="mb-1">
                                                                <% let emocionesLogro = {}; if (b.emociones_logro) { try { emocionesLogro = JSON.parse(b.emociones_logro) || {}; } catch(e) { emocionesLogro = {}; } } %>
                                                                <% for (let emo in emocionesLogro) { %>
                                                                    <li><%= emo %>: <%= emocionesLogro[emo] %></li>
                                                                <% } %>
                                                            </ul>
                                                            <strong>Entidades:</strong>
                                                            <ul class="mb-1">
                                                                <% let entidadesLogro = []; if (b.entidades_logro) { try { entidadesLogro = JSON.parse(b.entidades_logro) || []; } catch(e) { entidadesLogro = []; } } %>
                                                                <% entidadesLogro.forEach(function(e) { %>
                                                                    <li><%= e.text %> (<%= e.type %>)</li>
                                                                <% }) %>
                                                            </ul>
                                                            <strong>Palabras clave:</strong>
                                                            <ul class="mb-1">
                                                                <% let palabrasLogro = []; if (b.palabras_clave_logro) { try { palabrasLogro = JSON.parse(b.palabras_clave_logro) || []; } catch(e) { palabrasLogro = []; } } %>
                                                                <% palabrasLogro.forEach(function(p) { %>
                                                                    <li><%= p.text %></li>
                                                                <% }) %>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <div class="border rounded p-2 mb-2">
                                                            <strong>Score Comunicación:</strong> <%= b.score_comunicacion %><br>
                                                            <strong>Sentimiento:</strong> <%= b.sentimiento_comunicacion %><br>
                                                            <strong>Emociones:</strong>
                                                            <ul class="mb-1">
                                                                <% let emocionesComunicacion = {}; if (b.emociones_comunicacion) { try { emocionesComunicacion = JSON.parse(b.emociones_comunicacion) || {}; } catch(e) { emocionesComunicacion = {}; } } %>
                                                                <% for (let emo in emocionesComunicacion) { %>
                                                                    <li><%= emo %>: <%= emocionesComunicacion[emo] %></li>
                                                                <% } %>
                                                            </ul>
                                                            <strong>Entidades:</strong>
                                                            <ul class="mb-1">
                                                                <% let entidadesComunicacion = []; if (b.entidades_comunicacion) { try { entidadesComunicacion = JSON.parse(b.entidades_comunicacion) || []; } catch(e) { entidadesComunicacion = []; } } %>
                                                                <% entidadesComunicacion.forEach(function(e) { %>
                                                                    <li><%= e.text %> (<%= e.type %>)</li>
                                                                <% }) %>
                                                            </ul>
                                                            <strong>Palabras clave:</strong>
                                                            <ul class="mb-1">
                                                                <% let palabrasComunicacion = []; if (b.palabras_clave_comunicacion) { try { palabrasComunicacion = JSON.parse(b.palabras_clave_comunicacion) || []; } catch(e) { palabrasComunicacion = []; } } %>
                                                                <% palabrasComunicacion.forEach(function(p) { %>
                                                                    <li><%= p.text %></li>
                                                                <% }) %>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="row">
                                                    <div class="col-md-6 mb-2">
                                                        <strong>Contextos detectados:</strong>
                                                        <ul>
                                                            <% let contextos = []; if (b.contextos_detectados) { try { contextos = JSON.parse(b.contextos_detectados) || []; } catch(e) { contextos = []; } } %>
                                                            <% if (Array.isArray(contextos)) { contextos.forEach(function(c) { %>
                                                                <li><%= c %></li>
                                                            <% }) } else { for (let c in contextos) { %>
                                                                <li><%= c %>: <%= contextos[c] %></li>
                                                            <% } } %>
                                                        </ul>
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <strong>Recomendaciones:</strong>
                                                        <ul>
                                                            <% let recomendaciones = []; if (b.recomendaciones) { try { recomendaciones = JSON.parse(b.recomendaciones) || []; } catch(e) { recomendaciones = []; } } %>
                                                            <% recomendaciones.forEach(function(r) { %>
                                                                <li><%= r.mensaje %> <small>(<%= r.area %>, prioridad: <%= r.prioridad %>)</small></li>
                                                            <% }) %>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-12 mt-2">
                                                        <strong>Comentarios del instructor:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.comentarios_instructor || 'Sin comentarios' %></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estilos específicos -->
