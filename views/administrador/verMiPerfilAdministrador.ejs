<!-- Ruta: vistas/administrador/verMiPerfil.ejs -->
<!-- Propósito: Visualización del perfil personal del administrador -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<style>
.btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

html.dark-mode .fas.fa-edit {
    color: #ffffff;
}

html.dark-mode .btn-primary {
    color: #ffffff !important;
}

html.dark-mode .btn-primary:hover {
    color: #ffffff !important;
    background-color: #0b5ed7 !important;
    border-color: #0b5ed7 !important;
}
</style>

<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/listar-administradores">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar a la lista
            </a>
        </div>    
    </div>
</nav>

<%- contentFor('body') %>
<div class="container mt-4 mb-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0"><%= typeof title !== 'undefined' ? title : 'Mi Perfil de Administrador' %></h2>
        </div>
        <div class="card-body">
            <% if (typeof administrador !== 'undefined' && administrador) { %>
                <p><strong>Nombre completo:</strong> <%= administrador.nombreCompleto || 'N/A' %></p>
                <p><strong>Correo Institucional:</strong> <%= administrador.correoInstitucional || 'N/A' %></p>
                <p><strong>Número de identificación:</strong> <%= administrador.numeroIdentificacion || 'N/A' %></p>
                <p><strong>Teléfono:</strong> <%= administrador.telefono || 'N/A' %></p>
                <p><strong>Departamento:</strong> <%= administrador.departamento || 'N/A' %></p>
                <p><strong>Cargo o rol:</strong> <%= administrador.cargo || 'N/A' %></p>


                <div class="mt-4 text-center">
                    <% if (typeof esMiPerfil !== 'undefined' && esMiPerfil) { %>
                        <a href="/administrador/editar-perfil" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Editar Perfil
                        </a>
                    <% } else { %>
                        <button class="btn btn-secondary disabled" title="Solo puedes editar tu propio perfil" disabled>
                            <i class="fas fa-edit"></i> Editar Administrador
                        </button>
                    <% } %>
                </div>

            <% } else { %>
                <div class="alert alert-danger">
                    No se encontró información para su perfil.
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>