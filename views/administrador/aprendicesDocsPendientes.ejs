                // Configuración simplificada para html2pdf
                const nombreArchivo = `Documentos_${nombreCompleto.replace(/[^a-zA-Z0-9\s]/g, '')}_${aprendizInfo.numeroDocumento}.pdf`;
                
                const opt = {
                    margin: [0, 10, 0, 10], // [top, right, bottom, left] en mm - Solo márgenes laterales
