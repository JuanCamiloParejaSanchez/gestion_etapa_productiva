<!-- Ruta: vistas/administrador/verAprendiz.ejs -->
<!-- Propósito: Muestra los detalles completos de un aprendiz seleccionado en un formato legible.
     Permite visualizar toda la información registrada de un aprendiz específico. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<style>
/* Color blanco para el botón Volver en modo oscuro */
html.dark-mode .btn-primary {
    color: #ffffff !important;
}

html.dark-mode .fas .fa-arrow-left {
    color: #ffffff !important;
}

html.dark-mode .btn-primary:hover {
    color: #ffffff !important;
    background-color: #0b5ed7 !important;
    border-color: #0b5ed7 !important;
}
</style>

<%
// Función auxiliar para formatear fechas correctamente (sin problemas de zona horaria)
function formatearFechaLocal(fecha) {
    if (!fecha) return 'N/A';
    
    // Si es string, parsearlo como fecha local
    let date;
    if (typeof fecha === 'string') {
        const [year, month, day] = fecha.split('T')[0].split('-');
        date = new Date(year, month - 1, day);
    } else {
        date = new Date(fecha);
    }
    
    // Verificar si la fecha es válida
    if (isNaN(date.getTime())) return 'N/A';
    
    return date.toLocaleDateString('es-ES', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

// Función auxiliar para formatear fecha y hora
function formatearFechaHoraLocal(fecha) {
    if (!fecha) return 'N/A';
    
    const date = new Date(fecha);
    if (isNaN(date.getTime())) return 'N/A';
    
    return date.toLocaleString('es-ES', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });
}
%>

<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/listar-aprendices">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar a la lista
            </a>
        </div>
    </div>
</nav>

<%- contentFor('body') %>
<div class="container mt-4 mb-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Detalles del Aprendiz</h2>
        </div>
        <div class="card-body">
            <% if (typeof aprendiz !== 'undefined' && aprendiz) { %>
                <div class="mb-3">
                    <strong>Nombres:</strong>
                    <%= aprendiz.nombres || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Primer Apellido:</strong>
                    <%= aprendiz.primerApellido || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Segundo Apellido:</strong>
                    <%= aprendiz.segundoApellido || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Tipo de Documento:</strong>
                    <%= aprendiz.tipoDocumento || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Número de Documento:</strong>
                    <%= aprendiz.numeroDocumento || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Correo Electrónico:</strong>
                    <%= aprendiz.correoElectronico || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Teléfono Fijo:</strong>
                    <%= aprendiz.telefonoFijo || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Número de Celular:</strong>
                    <%= aprendiz.celular || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Dirección:</strong>
                    <%= aprendiz.direccion || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Barrio:</strong>
                    <%= aprendiz.barrio || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Departamento:</strong>
                    <%= aprendiz.departamento || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Municipio:</strong>
                    <%= aprendiz.municipio || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Fecha de Nacimiento:</strong>
                    <%= formatearFechaLocal(aprendiz.fechaNacimiento) %>
                </div>
                <div class="mb-3">
                    <strong>Género:</strong>
                    <%= aprendiz.genero || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Programa de Formación:</strong>
                    <%= aprendiz.programaFormacion || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Ficha:</strong>
                    <%= aprendiz.numeroFicha || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Estado de Formación:</strong>
                    <%= aprendiz.estadoFormacion ? aprendiz.estadoFormacion.charAt(0).toUpperCase() + aprendiz.estadoFormacion.slice(1) : 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Alternativa Seleccionada:</strong>
                    <%= aprendiz.alternativaSeleccionada ? aprendiz.alternativaSeleccionada.toUpperCase() : 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>EPS:</strong>
                    <%= aprendiz.eps || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Fecha Inicio Etapa Lectiva:</strong>
                    <%= formatearFechaLocal(aprendiz.fechaInicioLectiva) %>
                </div>
                <div class="mb-3">
                    <strong>Fecha Fin Etapa Lectiva:</strong>
                    <%= formatearFechaLocal(aprendiz.fechaFinLectiva) %>
                </div>
                <div class="mb-3">
                    <strong>Instructor Etapa Lectiva:</strong>
                    <%= aprendiz.instructorLectiva || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Instructor Etapa Productiva:</strong>
                    <%= aprendiz.instructorProductiva || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Área de Formación:</strong>
                    <%= aprendiz.areaFormacion ? aprendiz.areaFormacion.toUpperCase() : 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Fecha Inicio Etapa Productiva:</strong>
                    <%= formatearFechaLocal(aprendiz.fechaInicioProductiva) %>
                </div>
                <div class="mb-3">
                    <strong>Fecha Fin Etapa Productiva:</strong>
                    <%= formatearFechaLocal(aprendiz.fechaFinProductiva) %>
                </div>
                <div class="mb-3">
                    <strong>Empresa Patrocinadora:</strong>
                    <%= aprendiz.empresaPatrocinadora || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Área donde Realiza la Práctica:</strong>
                    <%= aprendiz.areaPractica || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Nombre del Jefe Inmediato:</strong>
                    <%= aprendiz.jefeInmediato || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Teléfono Fijo Empresa:</strong>
                    <%= aprendiz.telefonoEmpresa || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Celular Empresa:</strong>
                    <%= aprendiz.celularEmpresa || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Dirección Empresa:</strong>
                    <%= aprendiz.direccionEmpresa || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Correo Empresa:</strong>
                    <%= aprendiz.correoEmpresa || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Horario:</strong>
                    <%= aprendiz.horario || 'N/A' %>
                </div>
                <div class="mb-3">
                    <strong>Fecha creación de usuario:</strong>
                    <%= formatearFechaHoraLocal(aprendiz.created_at) %>
                </div>
            <% } else { %>
                <div class="alert alert-danger">
                    No se encontraron datos del aprendiz.
                </div>
            <% } %>
        </div>
        <div class="card-footer">
            <a href="/administrador/listar-aprendices" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>