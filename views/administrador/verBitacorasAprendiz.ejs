<%- contentFor('scripts') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Función para mostrar el modal con las alertas
        function mostrarAlertaCompromiso(nivelCompromiso, sentimientoGeneral, tendencia) {
            const modal = document.getElementById('alertaCompromiso');
            const estadoDiv = document.getElementById('estadoAprendiz');
            const accionesList = document.getElementById('accionesRecomendadas');
            
            let estado = '';
            let clase = '';
            let acciones = [];
            
            // Determinar estado y acciones según el nivel de compromiso
            if (nivelCompromiso < 50) {
                estado = '<div class="alert alert-danger">¡Atención! Nivel de compromiso bajo</div>';
                acciones = [
                    'Programar reunión inmediata con el aprendiz',
                    'Revisar y ajustar el plan de seguimiento',
                    'Identificar barreras y dificultades específicas',
                    'Considerar apoyo adicional o recursos complementarios'
                ];
            } else if (nivelCompromiso < 75) {
                estado = '<div class="alert alert-warning">Nivel de compromiso medio - Requiere atención</div>';
                acciones = [
                    'Programar check-in de seguimiento',
                    'Revisar objetivos y expectativas',
                    'Proponer estrategias de mejora',
                    'Mantener monitoreo regular'
                ];
            } else {
                estado = '<div class="alert alert-success">¡Buen nivel de compromiso!</div>';
                acciones = [
                    'Mantener el seguimiento regular',
                    'Reconocer y reforzar el buen desempeño',
                    'Identificar oportunidades de crecimiento'
                ];
            }

            // Agregar información adicional basada en sentimiento y tendencia
            if (sentimientoGeneral === 'negativo' && tendencia !== 'positiva') {
                acciones.push('Evaluar posibles factores de desmotivación');
                acciones.push('Considerar intervención del equipo de bienestar');
            }

            // Actualizar el contenido del modal
            estadoDiv.innerHTML = estado;
            accionesList.innerHTML = acciones.map(accion => 
                `<li class="list-group-item">
                    <i class="fas fa-check-circle text-primary me-2"></i>
                    ${accion}
                </li>`
            ).join('');

            // Mostrar el modal
            const modalBootstrap = new bootstrap.Modal(modal);
            modalBootstrap.show();
        }

        // Mostrar el modal automáticamente solo si el sentimiento general es negativo
        <% if (analisisSentimientos && analisisSentimientos.sentimientoGeneral === 'negativo') { %>
            mostrarAlertaCompromiso(
                <%= analisisSentimientos.nivelCompromiso %>,
                '<%= analisisSentimientos.sentimientoGeneral || 'neutral' %>',
                '<%= analisisSentimientos.tendencia || 'sin_datos' %>'
            );
        <% } %>

        // Agregar botón para mostrar el modal manualmente
        const compromiso = document.querySelector('.engagement-level');
        if (compromiso) {
            compromiso.style.cursor = 'pointer';
            compromiso.addEventListener('click', () => {
                mostrarAlertaCompromiso(
                    <%= analisisSentimientos && analisisSentimientos.nivelCompromiso ? analisisSentimientos.nivelCompromiso : 0 %>,
                    '<%= analisisSentimientos && analisisSentimientos.sentimientoGeneral ? analisisSentimientos.sentimientoGeneral : 'neutral' %>',
                    '<%= analisisSentimientos && analisisSentimientos.tendencia ? analisisSentimientos.tendencia : 'sin_datos' %>'
                );
            });
        }

        <% if (analisisSentimientos && analisisSentimientos.analisisPorFecha && analisisSentimientos.analisisPorFecha.length > 0) { %>
            // Datos para el gráfico de tendencias
            const datosSentimientos = <%- JSON.stringify(analisisSentimientos.analisisPorFecha) %>;
            
            const ctx = document.getElementById('sentimentChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: datosSentimientos.map((analisis, index) => {
                        const fecha = new Date(analisis.fecha);
                        return fecha.toLocaleDateString('es-CO', { month: 'short', day: 'numeric' });
                    }),
                    datasets: [{
                        label: 'Score de Sentimiento',
                        data: datosSentimientos.map(analisis => analisis.scoreGeneral),
                        borderColor: 'rgb(75, 192, 192)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.1,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `Score: ${context.parsed.y.toFixed(2)}`;
                                }
                            }
                        }
                    }
                }
            });
        <% } %>
        // Gráfico de tendencia de scores históricos
        <% if (bitacoras && bitacoras.length > 1) { %>
        const ctxTrend = document.getElementById('sentimentTrendChart').getContext('2d');
        const trendScores = [
            <% bitacoras.slice().reverse().forEach(function(b, idx) { %>
                <%= typeof b.score_promedio === 'number' ? b.score_promedio.toFixed(2) : (parseFloat(b.score_promedio) || 0).toFixed(2) %><%= idx < bitacoras.length - 1 ? ',' : '' %>
            <% }); %>
        ];
        const trendLabels = [
            <% bitacoras.slice().reverse().forEach(function(b, idx) { %>
                '<%= new Date(b.fechaCreacion).toLocaleDateString() %>'<%= idx < bitacoras.length - 1 ? ',' : '' %>
            <% }); %>
        ];
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Score de Sentimiento',
                    data: trendScores,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.2,
                    fill: true,
                    pointRadius: 4,
                    pointBackgroundColor: 'rgb(75, 192, 192)'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `Score: ${context.parsed.y}`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        min: -1,
                        max: 1,
                        title: { display: true, text: 'Score' }
                    },
                    x: {
                        title: { display: true, text: 'Fecha' }
                    }
                }
            }
        });
        <% } %>
    });
</script>

