<%- contentFor('body') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12 mb-4">
            <h1 class="mb-0">Bienvenido(a), <%= user.name %>!</h1>
            <p class="lead">Gestiona y supervisa la información de los aprendices y del sistema.</p>
        </div>
    </div>

    <div class="row">
        <!-- Tarjeta de Mi Información Personal -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-orange text-white">
                    <i class="fas fa-user-circle me-2"></i>Mi Información Personal
                </div>
                <div class="card-body">
                    <p class="card-text">Accede y actualiza tus datos de contacto y detalles personales como administrador.</p>
                    <a href="/administrador/perfil" class="btn btn-orange w-100 mt-3 text-white">
                        Ver Mi Perfil
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Gestión de Aprendices -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-blue-custom text-white">
                    <i class="fas fa-users me-2"></i>Gestión de Aprendices
                </div>
                <div class="card-body">
                    <p class="card-text">Visualiza, edita y gestiona la información de todos los aprendices registrados.</p>
                    <a href="/administrador/listar-aprendices" class="btn btn-primary-card w-100 mt-3 text-white">
                        Listar Aprendices
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Documentos Pendientes del Aprendiz -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-warning text-white">
                    <i class="fas fa-book me-2"></i>Documentos Pendientes del Aprendiz
                </div>
                <div class="card-body">
                    <p class="card-text">Planeación, seguimiento y evaluación de la etapa productiva.</p>
                    <a href="/administrador/alertas/bitacora" class="btn btn-warning w-100 mt-3 text-white">
                        Gestionar Documentos
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Reportes y Estadísticas -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-chart-pie me-2"></i>Reportes y Estadísticas
                </div>
                <div class="card-body">
                    <p class="card-text">Analiza datos y visualiza métricas clave sobre el progreso de los aprendices.</p>
                    <a href="/administrador/reportes" class="btn btn-info w-100 mt-3 text-white">
                        Ver Reportes
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Gestión de Administradores -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-user-shield me-2"></i>Gestión de Administradores
                </div>
                <div class="card-body">
                    <p class="card-text">Visualiza y gestiona la información de todos los administradores registrados.</p>
                    <a href="/administrador/listar-administradores" class="btn btn-success w-100 mt-3 text-white">
                        Listar Administradores
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Modal de Confirmación de Cierre de Sesión -->
        <div class="modal fade confirm-logout-modal" id="confirmLogoutModal" tabindex="-1" aria-labelledby="confirmLogoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmLogoutModalLabel">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            Confirmar Cierre de Sesión
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <i class="fas fa-question-circle text-warning" style="font-size: var(--font-size-5xl);"></i>
                        </div>
                        <h4 class="text-warning mb-3">¿Estás seguro?</h4>
                        <p class="mb-0">¿Estás seguro de que deseas cerrar sesión?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-warning px-4" id="confirmLogoutBtn">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            Cerrar Sesión
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal de Chat -->
        <div class="modal fade" id="modalChat" tabindex="-1" aria-labelledby="modalChatLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-success-chat text-white">
                        <button id="btn-regresar-chat" class="btn btn-link text-white" style="display: none;" title="Regresar">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <h5 class="modal-title text-white" id="modalChatLabel">
                            <i class="fas fa-envelope me-2"></i>Chat con Aprendices
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="chat-messages" class="chat-messages">
                            <!-- Los mensajes se cargarán dinámicamente aquí -->
                            <div class="chat-empty">
                                <i class="fas fa-comments fa-2x mb-2"></i>
                                <p>No hay mensajes aún. Selecciona un aprendiz para iniciar una conversación.</p>
                            </div>
                        </div>
                        <div class="chat-input-area">
                            <textarea
                                id="chat-input"
                                class="chat-input form-control"
                                placeholder="Selecciona una conversación para enviar mensajes"
                                rows="1"
                                maxlength="500"
                                disabled></textarea>
                            <button id="send-chat-btn" class="btn btn-info btn-send-chat" disabled>
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Prevenir cualquier inicialización de DataTables en el panel principal
        window.skipDataTableInit = true;
    
        // Limpiar cualquier tabla DataTable residual
        if ($.fn.DataTable && $.fn.DataTable.isDataTable('#aprendicesTable')) {
            $('#aprendicesTable').DataTable().destroy();
            console.log('Tabla DataTable residual eliminada');
        }
    
        // Evitar que se ejecuten scripts de ordenamiento de tabla
        if (window.OrdenamientoTabla) {
            console.log('Prevención de inicialización de OrdenamientoTabla en panel principal');
            return;
        }
    
        // Lógica específica del panel principal
        console.log('Panel principal cargado correctamente');
    
        // Verificar que no hay elementos de tabla que no deberían estar aquí
        const tablaAprendices = document.getElementById('aprendicesTable');
        if (tablaAprendices) {
            console.warn('¡ADVERTENCIA! Se encontró tabla aprendicesTable en panel principal');
            tablaAprendices.remove();
        }
    
        // Agregar event listeners del chat
        const btnChat = document.getElementById('btnChat');
        if (btnChat) {
            btnChat.addEventListener('click', function() {
                chatViewState = 'list';
                document.getElementById('btn-regresar-chat').style.display = 'none';
                document.getElementById('chat-input').disabled = true;
                document.getElementById('chat-input').placeholder = 'Selecciona una conversación para enviar mensajes';
                document.getElementById('send-chat-btn').disabled = true;
                cargarConversaciones();
            });
        }

        // Event listener para el botón de regresar
        const btnRegresar = document.getElementById('btn-regresar-chat');
        if (btnRegresar) {
            btnRegresar.addEventListener('click', function() {
                chatViewState = 'list';
                document.getElementById('btn-regresar-chat').style.display = 'none';
                document.getElementById('modalChatLabel').textContent = 'Chat con Aprendices';
                document.getElementById('chat-input').disabled = true;
                document.getElementById('chat-input').placeholder = 'Selecciona una conversación para enviar mensajes';
                document.getElementById('send-chat-btn').disabled = true;
                mostrarListaConversaciones(cachedConversations);
            });
        }

        const sendBtn = document.getElementById('send-chat-btn');
        if (sendBtn) {
            sendBtn.addEventListener('click', enviarMensaje);
        }

        const chatInput = document.getElementById('chat-input');
        if (chatInput) {
            chatInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    enviarMensaje();
                }
            });
            chatInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 100) + 'px';
            });
        }
    
        // Cargar contador de mensajes no leídos
        cargarContadorChat();
        // Actualizar cada 30 segundos
        setInterval(cargarContadorChat, 30000);
    });
</script>
<script>
    /**
    * Mostrar notificación de éxito/error tipo toast
    */
    function mostrarNotificacionExito(mensaje, tipo = 'success') {
        const overlay = document.createElement('div');
        overlay.className = 'success-popup-overlay';

        let icono = 'fas fa-check-circle';
        let titulo = 'Éxito';
        let borderColor = '#28a745';

        if (tipo === 'danger') {
            icono = 'fas fa-exclamation-circle';
            titulo = 'Error';
            borderColor = '#dc3545';
        } else if (tipo === 'warning') {
            icono = 'fas fa-exclamation-triangle';
            titulo = 'Advertencia';
            borderColor = '#ffc107';
        }

        const popup = document.createElement('div');
        popup.className = 'success-popup';
        popup.style.borderLeftColor = borderColor;

        popup.innerHTML = `
            <div class="success-popup-icon">
                <i class="${icono}"></i>
            </div>
            <div class="success-popup-content">
                <div class="success-popup-title">${titulo}</div>
                <p class="success-popup-message">${mensaje}</p>
            </div>
        `;

        overlay.appendChild(popup);
        document.body.appendChild(overlay);

        // Auto-cerrar después de 4 segundos
        setTimeout(() => {
            overlay.style.animation = 'slideOutRight 0.3s ease-out forwards';
            setTimeout(() => {
                document.body.removeChild(overlay);
            }, 300);
        }, 4000);

        // Cerrar al hacer clic
        overlay.addEventListener('click', () => {
            overlay.style.animation = 'slideOutRight 0.3s ease-out forwards';
            setTimeout(() => {
                document.body.removeChild(overlay);
            }, 300);
        });
    }

    // Funciones del Chat
    let currentChatUser = null;
    let chatViewState = 'list';
    let cachedConversations = [];

    // Cargar contador de mensajes no leídos
    function cargarContadorChat() {
        fetch('/administrador/chat/contador')
            .then(response => response.json())
            .then(data => {
                const badge = document.getElementById('badgeChat');
                if (data.success && data.count > 0) {
                    badge.textContent = data.count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            })
            .catch(error => console.error('Error al cargar contador de chat:', error));
    }

    // Cargar conversaciones disponibles
    function cargarConversaciones() {
        fetch('/administrador/chat/conversaciones')
            .then(response => response.json())
            .then(data => {
                mostrarListaConversaciones(data.conversaciones || []);
            })
            .catch(error => {
                console.error('Error al cargar conversaciones:', error);
                mostrarListaConversaciones([]);
            });
    }

    // Mostrar lista de conversaciones
    function mostrarListaConversaciones(conversaciones) {
        cachedConversations = conversaciones;
        const chatMessages = document.getElementById('chat-messages');
        chatMessages.innerHTML = `
            <div class="mb-3">
                <h6>Buscar Aprendiz:</h6>
                <div class="input-group mb-3">
                    <input type="text" id="search-user-input" class="form-control" placeholder="Escribe el nombre del aprendiz..." autocomplete="off">
                    <button class="btn btn-outline-primary" type="button" onclick="buscarUsuarios()">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <div id="search-results" class="mb-3" style="display: none;"></div>
                <h6>Conversaciones activas:</h6>
                ${conversaciones.length > 0 ? conversaciones.map(conv => `
                    <div class="d-flex justify-content-between align-items-center p-2 border rounded mb-2 cursor-pointer conversation-item"
                        data-otro-usuario-id="${conv.otro_usuario_id}"
                        data-otro-usuario-tipo="${conv.otro_usuario_tipo}">
                        <div class="flex-grow-1">
                            <strong>${conv.nombre}</strong>
                            ${conv.no_leidos > 0 ? `<span class="badge bg-danger ms-2">${conv.no_leidos}</span>` : ''}
                            <br>
                            <small class="text-muted">${new Date(conv.ultimo_mensaje).toLocaleString('es-CO')}</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-danger" onclick="eliminarConversacion(${conv.otro_usuario_id}, '${conv.otro_usuario_tipo}', '${conv.nombre}')" title="Eliminar conversación">
                                <i class="fas fa-trash"></i>
                            </button>
                            <i class="fas fa-chevron-right text-muted"></i>
                        </div>
                    </div>
                `).join('') : '<p class="text-muted">No hay conversaciones activas.</p>'}
            </div>
        `;

        // Agregar event listeners para las conversaciones
        document.querySelectorAll('.conversation-item').forEach(item => {
            item.addEventListener('click', function() {
                const otroUsuarioId = this.dataset.otroUsuarioId;
                const otroUsuarioTipo = this.dataset.otroUsuarioTipo;
                const nombre = this.querySelector('strong').textContent;
                abrirConversacion(otroUsuarioId, otroUsuarioTipo, nombre);
            });
        });

        // Agregar event listener para búsqueda en tiempo real
        document.getElementById('search-user-input').addEventListener('input', function() {
            const query = this.value.trim();
            if (query.length >= 2) {
                buscarUsuarios(query);
            } else {
                document.getElementById('search-results').style.display = 'none';
            }
        });
    }

    // Buscar usuarios
    function buscarUsuarios(query = '') {
        if (!query) {
            query = document.getElementById('search-user-input').value.trim();
        }

        if (query.length < 2) {
            mostrarNotificacionExito('Escribe al menos 2 caracteres para buscar.', 'warning');
            return;
        }

        fetch(`/administrador/chat/buscar-usuarios?q=${encodeURIComponent(query)}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    mostrarResultadosBusqueda(data.usuarios);
                } else {
                    mostrarResultadosBusqueda([]);
                }
            })
            .catch(error => {
                console.error('Error al buscar usuarios:', error);
                mostrarResultadosBusqueda([]);
            });
    }

    // Mostrar resultados de búsqueda
    function mostrarResultadosBusqueda(usuarios) {
        const resultsDiv = document.getElementById('search-results');
        if (usuarios.length > 0) {
            resultsDiv.innerHTML = `
                <div class="list-group">
                    ${usuarios.map(user => `
                        <button type="button" class="list-group-item list-group-item-action search-result-item"
                                data-user-id="${user.id}"
                                data-user-tipo="aprendiz">
                            <i class="fas fa-user-graduate me-2"></i>${user.nombre}
                        </button>
                    `).join('')}
                </div>
            `;
            resultsDiv.style.display = 'block';

            // Agregar event listeners para los resultados de búsqueda
            document.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const userId = this.dataset.userId;
                    const userTipo = this.dataset.userTipo;
                    abrirConversacion(userId, userTipo);
                });
            });
        } else {
            resultsDiv.innerHTML = '<p class="text-muted">No se encontraron aprendices.</p>';
            resultsDiv.style.display = 'block';
        }
    }

    // Abrir conversación específica
    function abrirConversacion(otroUsuarioId, otroUsuarioTipo, nombre) {
        currentChatUser = { id: otroUsuarioId, tipo: otroUsuarioTipo };
        chatViewState = 'messages';
        document.getElementById('btn-regresar-chat').style.display = 'inline-block';
        document.getElementById('modalChatLabel').textContent = `Chat con ${nombre}`;
        document.getElementById('chat-input').disabled = false;
        document.getElementById('chat-input').placeholder = 'Escribe tu mensaje...';
        document.getElementById('send-chat-btn').disabled = false;
        cargarMensajesConversacion(otroUsuarioId, otroUsuarioTipo);
    }

    // Cargar mensajes de una conversación
    function cargarMensajesConversacion(otroUsuarioId, otroUsuarioTipo) {
        const chatMessages = document.getElementById('chat-messages');
        chatMessages.innerHTML = `
            <div class="text-center">
                <div class="spinner-border text-info" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        `;

        fetch(`/administrador/chat/historial/${otroUsuarioId}/${otroUsuarioTipo}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    mostrarMensajes(data.mensajes);
                    // Marcar mensajes como leídos
                    marcarMensajesComoLeidos(data.mensajes);
                } else {
                    chatMessages.innerHTML = '<div class="alert alert-warning">Error al cargar los mensajes.</div>';
                }
            })
            .catch(error => {
                console.error('Error al cargar mensajes:', error);
                chatMessages.innerHTML = '<div class="alert alert-danger">Error al cargar los mensajes.</div>';
            });
    }

    // Mostrar mensajes en el chat
    function mostrarMensajes(mensajes) {
        const chatMessages = document.getElementById('chat-messages');
        if (mensajes.length === 0) {
            chatMessages.innerHTML = `
                <div class="chat-empty">
                    <i class="fas fa-comments fa-2x mb-2"></i>
                    <p>No hay mensajes en esta conversación. ¡Envía el primero!</p>
                </div>
            `;
            return;
        }

        chatMessages.innerHTML = mensajes.map(msg => `
            <div class="chat-message ${msg.es_remitente ? 'sent' : 'received'}">
                <div class="sender">${msg.es_remitente ? 'Tú' : msg.remitente_nombre}</div>
                <div>${msg.mensaje}</div>
                <div class="timestamp">${new Date(msg.fecha_creacion).toLocaleString('es-CO')}</div>
            </div>
        `).join('');

        // Scroll al final
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Marcar mensajes como leídos
    function marcarMensajesComoLeidos(mensajes) {
        const mensajesNoLeidos = mensajes.filter(msg => !msg.es_remitente && !msg.leido);
        mensajesNoLeidos.forEach(msg => {
            fetch(`/administrador/chat/mensajes/${msg.id}/marcar-leido`, {
                method: 'POST'
            }).catch(error => console.error('Error al marcar mensaje como leído:', error));
        });

        // Actualizar contador después de marcar como leídos
        setTimeout(cargarContadorChat, 1000);
    }


    // Eliminar conversación
    function eliminarConversacion(otroUsuarioId, otroUsuarioTipo, nombre) {
        mostrarConfirmacion({
            titulo: '¿Eliminar conversación?',
            mensaje: `¿Estás seguro de que deseas eliminar la conversación con ${nombre}? Solo se eliminará para ti, el otro usuario seguirá viendo los mensajes.`,
            tipo: 'warning',
            textoConfirmar: 'Eliminar',
            textoCancelar: 'Cancelar',
            onConfirm: () => {
                fetch(`/administrador/chat/conversaciones/${otroUsuarioId}/${otroUsuarioTipo}`, {
                    method: 'DELETE'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        mostrarNotificacionExito('Conversación eliminada correctamente.');
                        // Si estamos en la conversación eliminada, regresar a la lista
                        if (currentChatUser && currentChatUser.id == otroUsuarioId && currentChatUser.tipo == otroUsuarioTipo) {
                            chatViewState = 'list';
                            document.getElementById('btn-regresar-chat').style.display = 'none';
                            document.getElementById('modalChatLabel').textContent = 'Chat con Aprendices';
                            document.getElementById('chat-input').disabled = true;
                            document.getElementById('chat-input').placeholder = 'Selecciona una conversación para enviar mensajes';
                            document.getElementById('send-chat-btn').disabled = true;
                            mostrarListaConversaciones(cachedConversations.filter(conv =>
                                !(conv.otro_usuario_id == otroUsuarioId && conv.otro_usuario_tipo == otroUsuarioTipo)
                            ));
                        } else {
                            // Recargar conversaciones
                            cargarConversaciones();
                        }
                    } else {
                        mostrarNotificacionExito(data.message || 'Error al eliminar la conversación.', 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error al eliminar conversación:', error);
                    mostrarNotificacionExito('Error al eliminar la conversación.', 'danger');
                });
            }
        });
    }

    function enviarMensaje() {
        if (!currentChatUser) {
            mostrarNotificacionExito('Selecciona una conversación primero.', 'warning');
            return;
        }

        const input = document.getElementById('chat-input');
        const mensaje = input.value.trim();

        if (!mensaje) {
            mostrarNotificacionExito('Escribe un mensaje antes de enviar.', 'warning');
            return;
        }

        // Deshabilitar botón mientras se envía
        const btn = document.getElementById('send-chat-btn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        fetch('/administrador/chat/enviar', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                destinatarioId: currentChatUser.id,
                destinatarioTipo: currentChatUser.tipo,
                mensaje: mensaje
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                input.value = '';
                // Recargar mensajes
                cargarMensajesConversacion(currentChatUser.id, currentChatUser.tipo);
                mostrarNotificacionExito('Mensaje enviado correctamente.');
            } else {
                mostrarNotificacionExito(data.message || 'Error al enviar el mensaje.', 'danger');
            }
        })
        .catch(error => {
            console.error('Error al enviar mensaje:', error);
            mostrarNotificacionExito('Error al enviar el mensaje.', 'danger');
        })
        .finally(() => {
            // Rehabilitar botón
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i>';
        });
    }
</script>



