                                        <td>${doc.descripcion || 'N/A'}</td>
                                        <td>${doc.fecha}</td>
                                        <td><span class="estado-badge ${doc.estado.toLowerCase()}">${doc.estado}</span></td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    `;
                } else {
                    tablaDocumentos = '<div class="sin-documentos">No hay documentos para mostrar</div>';
                }

                // HTML simplificado para el PDF
                const htmlContent = `
