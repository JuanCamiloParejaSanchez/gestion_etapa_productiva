<!-- Ruta: views/plantillas/autenticacion.ejs -->
<!-- Propósito: Layout para las páginas de autenticación (login, registro, etc.) -->

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSP manejada por el servidor con Helmet -->

    <!-- Script inline para aplicar tema oscuro inmediatamente y evitar flash -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('sena-theme-preference');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark-mode');
            }
        })();
    </script>

    <title><%= typeof title !== 'undefined' ? title : 'SENA - Etapa Productiva' %></title>

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;600;700;800;900&display=swap&v=1.1" rel="stylesheet">

    <!-- Estilos -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/estilos/base/reset.css?v=1.3">
    <link rel="stylesheet" href="/estilos/base/variables.css?v=1.3">
    <link rel="stylesheet" href="/estilos/base/typography.css?v=1.3">
    <link rel="stylesheet" href="/estilos/base/layout.css?v=1.3">
    <link rel="stylesheet" href="/estilos/components/navbar.css?v=1.3">
    <link rel="stylesheet" href="/estilos/components/buttons.css?v=1.3">
    <link rel="stylesheet" href="/estilos/components/forms.css?v=1.3">
    <link rel="stylesheet" href="/estilos/general/estilosBase.css?v=1.3">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.12.0/dist/sweetalert2.min.css">
    <%- defineContent('styles') %>
</head>
<body>
    <main class="app-main">
        <%- body %>
    </main>
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.12.0/dist/sweetalert2.all.min.js"></script>
    <%- defineContent('scripts') %>
</body>
</html>
