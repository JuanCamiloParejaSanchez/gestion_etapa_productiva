<!-- Ruta: vistas/compartido/paginaError.ejs -->
<!-- Propósito: Muestra mensajes de error de forma estandarizada.
     Se utiliza para mostrar errores del sistema de manera amigable al usuario. -->


<%- contentFor('body') %>
<style>
    .dark-mode .btn-primary {
    color: #ffffff !important;
}

.dark-mode .btn-primary:hover {
    color: #ffffff !important;
    background-color: #0b5ed7 !important;    
    border-color: #0b5ed7 !important;
}
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger">
                <h4 class="alert-heading">Error <%= locals.error?.status || '500' %></h4>
                <p><%= locals.message || 'Ha ocurrido un error' %></p>
                <% if (locals.error?.description) { %>
                    <hr>
                    <p class="mb-0"><%= error.description %></p>
                <% } %>
            </div>
            <div class="text-center mt-4 mb-4">
                <a href="/" class="btn btn-primary">Volver al inicio</a>
            </div>
        </div>
    </div>
</div>