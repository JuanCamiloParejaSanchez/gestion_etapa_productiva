<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<style>
    /* Estilos específicos del dashboard de aprendiz */
    .indicator-value {
        font-size: 1.5em;
        font-weight: bold;
        margin-bottom: 5px;
    }
    .indicator-label {
        font-size: 0.9em;
        color: #666;
    }
    .trend-positive {
        color: #28a745;
    }
    .trend-negative {
        color: #dc3545;
    }
    .trend-stable {
        color: #ffc107;
    }
    .badge-alerta-visual {
        position: absolute;
        top: -12px;
        right: -12px;
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        background: linear-gradient(135deg, #ff3b3b 0%, #ff9800 100%);
        color: #fff;
        font-size: 1.15em;
        font-weight: bold;
        border-radius: 50%;
        box-shadow: 0 4px 16px rgba(220,53,69,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        border: 2.5px solid #fff;
        transition: transform 0.2s;
    }
    .badge-alerta-visual[style*="display: none"] {
        display: none !important;
    }

    /* Animación de rebote */
    @keyframes badge-bump {
        0% { transform: scale(1); }
        10% { transform: scale(1.2); }
        30% { transform: scale(0.95); }
        50% { transform: scale(1.05); }
        70% { transform: scale(0.98); }
        100% { transform: scale(1); }
    }
    .badge-alerta-visual.rebote {
        animation: badge-bump 0.4s;
    }

    /* Estilos específicos para modal de alertas */
    .modal-alertas .modal-header {
        background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);
    }
    html.dark-mode .modal-alertas .modal-header {
        background: linear-gradient(135deg, #8b0000 0%, #dc3545 100%);
    }
    html.dark-mode .modal-alertas .modal-body .list-group-item {
        background-color: #334155;
        color: #e6e6e6;
        border-color: #475569;
    }
    html.dark-mode .modal-alertas .modal-body .text-muted {
        color: #94a3b8 !important;
    }
    /* Mejoras UX: hover en items de lista */
    .modal-alertas .list-group-item {
        transition: background-color 0.2s ease;
    }
    .modal-alertas .list-group-item:hover {
        background-color: #f8f9fa;
    }
    html.dark-mode .modal-alertas .list-group-item:hover {
        background-color: #475569;
    }
    /* Mejor padding para el modal */
    .modal-alertas .modal-body {
        padding: 2rem;
    }

    .dark-mode .btn-cerrar-modal:hover {
    background-color: #26292b !important;
    border-color: #26292b !important;
    color: white !important;
}

</style>

<%- contentFor('navigation') %>
<!-- Barra de navegación -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-end align-items-center">
            <!-- Notificaciones -->
            <div class="position-relative me-3">
                <button class="btn btn-outline-light position-relative" 
                        data-bs-toggle="modal" 
                        data-bs-target="#modalNotificaciones"
                        id="btnNotificaciones">
                    <i class="fas fa-bell"></i>
                    <span id="badgeNotificaciones" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                        0
                    </span>
                </button>
            </div>
            <!-- Cerrar Sesión -->
            <a href="#" class="btn btn-primary btn-navbar" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                <i class="fas fa-sign-out-alt me-2"></i>
                Cerrar Sesión
            </a>
        </div>
    </div>
</nav>

<%- contentFor('body') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12 mb-4">
            <h1 class="mb-0">Bienvenido, <%= user.name %>!</h1>
            <p class="lead">Aquí podrás gestionar la información relevante de tu etapa productiva.</p>
        </div>
    </div>

    <div class="row">
        <!-- Tarjeta de Información Personal -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-user-circle me-2"></i>Mi Información Personal
                </div>
                <div class="card-body">
                    <p>Accede y actualiza tus datos de contacto y detalles personales.</p>
                    <a href="/aprendiz/perfil" class="btn btn-success w-100 mt-3 text-white">Ver Mi Perfil</a>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Alertas -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card alertas-card position-relative">
                <div class="card-header bg-danger text-white d-flex align-items-center position-relative">
                    <i class="fas fa-bell me-2"></i>Alertas
                    <!-- Badge en la esquina superior derecha -->
                    <span id="badge-alertas" class="badge-alerta-visual" style="display:none;">0</span>
                </div>
                <div class="card-body">
                    <p>Revisa tus alertas y mantente al día con tus pendientes.</p>
                    <button id="btn-ver-alertas" class="btn btn-danger w-100 mt-3 text-white" data-bs-toggle="modal" data-bs-target="#modalAlertas">
                        Ver Alertas
                    </button>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Documentación -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-warning text-white">
                    <i class="fas fa-folder-open me-2"></i>Gestión de Documentos
                </div>
                <div class="card-body">
                    <p>Sube y administra los documentos requeridos para tu seguimiento.</p>
                    <a href="/aprendiz/documentos" class="btn btn-warning w-100 mt-3 text-white">Gestionar Documentos</a>
                </div>
            </div>
        </div>
        
        <!-- Tarjeta de Bitácora -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-book-open me-2"></i>Mi progreso
                </div>
                <div class="card-body">
                    <p>Registra tus avances, desafíos y logros. Registra tus avances, desafíos y logros.</p>
                    <a href="/aprendiz/bitacora" class="btn btn-info w-100 mt-3 text-white">Registrar Progreso</a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<!-- Modal de Notificaciones de Documentos -->
<div class="modal fade" id="modalNotificaciones" tabindex="-1" aria-labelledby="modalNotificacionesLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="modalNotificacionesLabel">
          <i class="fas fa-bell me-2"></i>Notificaciones
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div id="listaNotificaciones">
          <!-- Las notificaciones se cargarán dinámicamente aquí -->
          <div class="text-center">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Cargando...</span>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-primary" onclick="marcarTodasComoLeidas()">
          <i class="fas fa-check-double me-2"></i>Marcar todas como leídas
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Alertas -->
<div class="modal fade modal-alertas" id="modalAlertas" tabindex="-1" aria-labelledby="modalAlertasLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-white" id="modalAlertasLabel"><i class="fas fa-bell me-2 text-white"></i>Documentos Pendientes</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <ul id="lista-alertas" class="list-group">
          <!-- Aquí se insertan las alertas dinámicamente -->
        </ul>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-cerrar-modal" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Confirmación de Cierre de Sesión -->
<div class="modal fade confirm-logout-modal" id="confirmLogoutModal" tabindex="-1" aria-labelledby="confirmLogoutModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmLogoutModalLabel">
          <i class="fas fa-sign-out-alt me-2"></i>
          Confirmar Cierre de Sesión
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <i class="fas fa-question-circle text-warning" style="font-size: var(--font-size-5xl);"></i>
        </div>
        <h4 class="text-warning mb-3">¿Estás seguro?</h4>
        <p class="mb-0">¿Estás seguro de que deseas cerrar sesión?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
          <i class="fas fa-times me-2"></i>
          Cancelar
        </button>
        <button type="button" class="btn btn-warning px-4" id="confirmLogoutBtn">
          <i class="fas fa-sign-out-alt me-2"></i>
          Cerrar Sesión
        </button>
      </div>
    </div>
  </div>
</div>


<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
document.getElementById('confirmLogoutBtn').addEventListener('click', function() {
  window.location.href = '/auth/logout';
});

// Cargar notificaciones al abrir el modal
document.getElementById('modalNotificaciones').addEventListener('show.bs.modal', function() {
    cargarNotificaciones();
});

// Cargar notificaciones al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    cargarContadorNotificaciones();
    // Actualizar cada 30 segundos
    setInterval(cargarContadorNotificaciones, 30000);
});

function cargarContadorNotificaciones() {
    fetch('/aprendiz/notificaciones/contador')
        .then(response => response.json())
        .then(data => {
            const badge = document.getElementById('badgeNotificaciones');
            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        })
        .catch(error => console.error('Error al cargar contador:', error));
}

function cargarNotificaciones() {
    const contenedor = document.getElementById('listaNotificaciones');
    contenedor.innerHTML = `
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    `;

    fetch('/aprendiz/notificaciones')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.notificaciones.length > 0) {
                contenedor.innerHTML = data.notificaciones.map(notif => `
                    <div class="card mb-3 ${notif.leida ? 'border-secondary' : 'border-primary'}">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="card-title mb-1">
                                        ${!notif.leida ? '<span class="badge bg-primary me-2">Nuevo</span>' : ''}
                                        ${notif.titulo}
                                    </h6>
                                    <p class="card-text text-muted mb-2">${notif.mensaje}</p>
                                    ${notif.retroalimentacion ? `
                                        <div class="alert alert-warning mb-2">
                                            <strong>Retroalimentación del tutor:</strong><br>
                                            ${notif.retroalimentacion}
                                        </div>
                                    ` : ''}
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        ${new Date(notif.fecha_creacion).toLocaleString('es-CO')}
                                    </small>
                                </div>
                                ${!notif.leida ? `
                                    <button class="btn btn-sm btn-outline-primary ms-2" onclick="marcarComoLeida(${notif.id})">
                                        <i class="fas fa-check"></i>
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `).join('');
            } else {
                contenedor.innerHTML = `
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-bell-slash fa-3x mb-3"></i>
                        <p>No tienes notificaciones</p>
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            contenedor.innerHTML = `
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error al cargar las notificaciones
                </div>
            `;
        });
}

function marcarComoLeida(notificacionId) {
    fetch(`/aprendiz/notificaciones/${notificacionId}/marcar-leida`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            cargarNotificaciones();
            cargarContadorNotificaciones();
        }
    })
    .catch(error => console.error('Error:', error));
}

function marcarTodasComoLeidas() {
    fetch('/aprendiz/notificaciones/marcar-todas-leidas', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            cargarNotificaciones();
            cargarContadorNotificaciones();
        }
    })
    .catch(error => console.error('Error:', error));
}
</script>
<script src="/js/alertasDashboard.js"></script>
