// Función auxiliar para formatear fechas a YYYY-MM-DD sin problemas de zona horaria
function formatearFechaParaInput(fecha) {
    if (!fecha) return '';
    
    // Si es string, extraer la parte de fecha
    if (typeof fecha === 'string') {
        const partes = fecha.split('T')[0].split('-');
        if (partes.length === 3) {
            // Ya está en formato correcto YYYY-MM-DD
            return fecha.split('T')[0];
        }
    }
    
    // Si es un objeto Date o necesita procesamiento
    const date = new Date(fecha);
    if (isNaN(date.getTime())) return '';
    
    // Extraer año, mes y día en zona horaria local
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    
    return `${year}-${month}-${day}`;
}
%>

<style>
    /* Estilos específicos para editar perfil de aprendiz */
    .edit-profile-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    .edit-header {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        border-radius: 10px 10px 0 0;
        padding: 1.5rem;
        text-align: center;
    }
    .form-section {
        border-left: 4px solid #007bff;
        background: #f8f9fa;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 0 8px 8px 0;
    }
    .section-title {
        color: #007bff;
        font-weight: 600;
        margin-bottom: 1rem;
        font-size: var(--font-size-lg);
    }
    .btn-save-profile {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s;
    }
    .btn-save-profile:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40,167,69,0.3);
    }
    .btn-cancel {
        border: 2px solid #6c757d;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        color: #6c757d;
        background: transparent;
        transition: all 0.3s;
    }
    .btn-cancel:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-2px);
    }

    /* Estilos para modo oscuro */
    html.dark-mode .edit-profile-card {
        background-color: #1e293b;
        color: #f1f5f9;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    html.dark-mode .edit-header {
        background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
    }

    html.dark-mode .form-section {
        background: #334155;
        border-left-color: #60a5fa;
    }

    html.dark-mode .section-title {
        color: #60a5fa;
    }
</style>

