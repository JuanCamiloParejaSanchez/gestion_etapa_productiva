<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
document.getElementById('confirmLogoutBtn').addEventListener('click', function() {
  window.location.href = '/auth/logout';
});

// Cargar notificaciones al abrir el modal
document.getElementById('modalNotificaciones').addEventListener('show.bs.modal', function() {
    cargarNotificaciones();
});

// Cargar notificaciones al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    cargarContadorNotificaciones();
    // Actualizar cada 30 segundos
    setInterval(cargarContadorNotificaciones, 30000);
});

function cargarContadorNotificaciones() {
    fetch('/aprendiz/notificaciones/contador')
        .then(response => response.json())
        .then(data => {
            const badge = document.getElementById('badgeNotificaciones');
            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        })
        .catch(error => console.error('Error al cargar contador:', error));
}

function cargarNotificaciones() {
    const contenedor = document.getElementById('listaNotificaciones');
    contenedor.innerHTML = `
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    `;

    fetch('/aprendiz/notificaciones')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.notificaciones.length > 0) {
                contenedor.innerHTML = data.notificaciones.map(notif => `
                    <div class="card mb-3 ${notif.leida ? 'border-secondary' : 'border-primary'}" id="notificacion-${notif.id}">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="card-title mb-1">
                                        ${!notif.leida ? '<span class="badge bg-primary me-2">Nuevo</span>' : ''}
                                        ${notif.titulo}
                                    </h6>
                                    <p class="card-text text-muted mb-2">${notif.mensaje}</p>
                                    ${notif.retroalimentacion ? `
                                        <div class="alert alert-warning mb-0">
                                            <strong>Retroalimentación del tutor:</strong>
                                            <span class="retroalimentacion-texto">${notif.retroalimentacion}</span>
                                        </div>
                                    ` : ''}
                                    ${notif.archivo_adjunto ? `
                                        <div class="mt-2">
                                            <a href="${notif.archivo_adjunto}" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-download me-1"></i>Descargar Archivo Adjunto
                                            </a>
                                        </div>
                                    ` : ''}
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        ${new Date(notif.fecha_creacion).toLocaleString('es-CO')}
                                    </small>
                                </div>
                                <div class="d-flex flex-column gap-2 ms-2">
                                    ${!notif.leida ? `
                                        <button class="btn btn-sm btn-outline-primary" onclick="marcarComoLeida(${notif.id})" title="Marcar como leída">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    ` : ''}
                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminarNotificacion(${notif.id})" title="Eliminar notificación">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');
            } else {
                contenedor.innerHTML = `
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-bell-slash fa-3x mb-3"></i>
                        <p>No tienes notificaciones</p>
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            contenedor.innerHTML = `
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error al cargar las notificaciones
                </div>
            `;
        });
}

function marcarComoLeida(notificacionId) {
    fetch(`/aprendiz/notificaciones/${notificacionId}/marcar-leida`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            cargarNotificaciones();
            cargarContadorNotificaciones();
        }
    })
    .catch(error => console.error('Error:', error));
}

function marcarTodasComoLeidas() {
    fetch('/aprendiz/notificaciones/marcar-todas-leidas', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            cargarNotificaciones();
            cargarContadorNotificaciones();
        }
    })
    .catch(error => console.error('Error:', error));
}

/**
 * Eliminar una notificación específica
 */
function eliminarNotificacion(notificacionId) {
    mostrarConfirmacion({
        titulo: '¿Eliminar notificación?',
        mensaje: '¿Estás seguro de que deseas eliminar esta notificación? Esta acción no se puede deshacer.',
        tipo: 'danger',
        textoConfirmar: 'Eliminar',
        textoCancelar: 'Cancelar',
        onConfirm: () => {
            fetch(`/aprendiz/notificaciones/${notificacionId}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Animación de salida opcional
                    const elemento = document.getElementById(`notificacion-${notificacionId}`);
                    if (elemento) {
                        elemento.style.transition = 'opacity 0.3s, transform 0.3s';
                        elemento.style.opacity = '0';
                        elemento.style.transform = 'translateX(100px)';
                        setTimeout(() => {
                            cargarNotificaciones();
                            cargarContadorNotificaciones();
                            mostrarNotificacionExito('Notificación eliminada correctamente');
                        }, 300);
                    } else {
                        cargarNotificaciones();
                        cargarContadorNotificaciones();
                        mostrarNotificacionExito('Notificación eliminada correctamente');
                    }
                } else {
                    mostrarNotificacionExito(data.message || 'Error al eliminar la notificación', 'danger');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                mostrarNotificacionExito('Error al eliminar la notificación', 'danger');
            });
        }
    });
}

/**
 * Eliminar todas las notificaciones leídas
 */
function eliminarTodasLeidas() {
    mostrarConfirmacion({
        titulo: '¿Eliminar todas las notificaciones leídas?',
        mensaje: 'Se eliminarán todas las notificaciones que ya has marcado como leídas. Esta acción no se puede deshacer.',
        tipo: 'warning',
        textoConfirmar: 'Sí, eliminar',
        textoCancelar: 'Cancelar',
        onConfirm: () => {
            fetch('/aprendiz/notificaciones/eliminar-leidas', {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    mostrarNotificacionExito(data.message || 'Notificaciones eliminadas correctamente');
                    cargarNotificaciones();
                    cargarContadorNotificaciones();
                } else {
                    mostrarNotificacionExito(data.message || 'Error al eliminar las notificaciones', 'danger');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                mostrarNotificacionExito('Error al eliminar las notificaciones', 'danger');
            });
        }
    });
}

/**
 * Mostrar popup de confirmación elegante
 */
function mostrarConfirmacion({ titulo, mensaje, tipo = 'warning', textoConfirmar = 'Confirmar', textoCancelar = 'Cancelar', onConfirm, onCancel }) {
    // Crear overlay
    const overlay = document.createElement('div');
    overlay.className = 'confirm-popup-overlay';
    
    // Crear popup
    const popup = document.createElement('div');
    popup.className = 'confirm-popup';
    
    // Determinar icono según tipo
    let icono = 'fas fa-exclamation-triangle';
    if (tipo === 'success') icono = 'fas fa-check-circle';
    if (tipo === 'danger') icono = 'fas fa-exclamation-circle';
    
    popup.innerHTML = `
        <div class="confirm-popup-icon ${tipo}">
            <i class="${icono}"></i>
        </div>
        <h3 class="confirm-popup-title text-center">${titulo}</h3>
        <p class="confirm-popup-message text-center">${mensaje}</p>
        <div class="confirm-popup-buttons">
            <button class="confirm-popup-btn confirm-popup-btn-cancel" id="popup-cancel">
                <i class="fas fa-times me-2"></i>${textoCancelar}
            </button>
            <button class="confirm-popup-btn confirm-popup-btn-confirm" id="popup-confirm">
                <i class="fas fa-check me-2"></i>${textoConfirmar}
            </button>
        </div>
    `;
    
    overlay.appendChild(popup);
    document.body.appendChild(overlay);
    
    // Función para cerrar el popup
    const cerrarPopup = () => {
        overlay.style.animation = 'fadeOut 0.2s forwards';
        popup.style.animation = 'popOut 0.2s forwards';
        setTimeout(() => {
            document.body.removeChild(overlay);
        }, 200);
    };
    
    // Event listeners
    document.getElementById('popup-cancel').addEventListener('click', () => {
        cerrarPopup();
        if (onCancel) onCancel();
    });
    
    document.getElementById('popup-confirm').addEventListener('click', () => {
        cerrarPopup();
        if (onConfirm) onConfirm();
    });
    
    // Cerrar al hacer clic fuera del popup
    overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
            cerrarPopup();
            if (onCancel) onCancel();
        }
    });
    
    // Cerrar con tecla Escape
    const handleEscape = (e) => {
        if (e.key === 'Escape') {
            cerrarPopup();
            if (onCancel) onCancel();
            document.removeEventListener('keydown', handleEscape);
        }
    };
    document.addEventListener('keydown', handleEscape);
}

/**
 * Mostrar notificación de éxito/error tipo toast
 */
function mostrarNotificacionExito(mensaje, tipo = 'success') {
    const overlay = document.createElement('div');
    overlay.className = 'success-popup-overlay';
    
    let icono = 'fas fa-check-circle';
    let titulo = 'Éxito';
    let borderColor = '#28a745';
    
    if (tipo === 'danger') {
        icono = 'fas fa-exclamation-circle';
        titulo = 'Error';
        borderColor = '#dc3545';
    } else if (tipo === 'warning') {
        icono = 'fas fa-exclamation-triangle';
        titulo = 'Advertencia';
        borderColor = '#ffc107';
    }
    
    const popup = document.createElement('div');
    popup.className = 'success-popup';
    popup.style.borderLeftColor = borderColor;
    
    popup.innerHTML = `
        <div class="success-popup-icon">
            <i class="${icono}"></i>
        </div>
        <div class="success-popup-content">
            <div class="success-popup-title">${titulo}</div>
            <p class="success-popup-message">${mensaje}</p>
        </div>
    `;
    
    overlay.appendChild(popup);
    document.body.appendChild(overlay);
    
    // Auto-cerrar después de 4 segundos
    setTimeout(() => {
        overlay.style.animation = 'slideOutRight 0.3s ease-out forwards';
        setTimeout(() => {
            document.body.removeChild(overlay);
        }, 300);
    }, 4000);
    
    // Cerrar al hacer clic
    overlay.addEventListener('click', () => {
        overlay.style.animation = 'slideOutRight 0.3s ease-out forwards';
        setTimeout(() => {
            document.body.removeChild(overlay);
        }, 300);
    });
}

// Funciones del Chat
let currentChatUser = null;
let chatViewState = 'list';
let cachedConversations = [];

// Eliminar conversación (frontend)
function eliminarConversacion(otroUsuarioId, otroUsuarioTipo, nombre) {
    // Si existe la función mostrarConfirmacion, usarla; si no, usar confirm nativo
    if (typeof mostrarConfirmacion === 'function') {
        mostrarConfirmacion({
            titulo: '¿Eliminar conversación?',
            mensaje: `¿Seguro que deseas eliminar la conversación con ${nombre}? Esta acción no se puede deshacer.`,
            tipo: 'danger',
            textoConfirmar: 'Eliminar',
            textoCancelar: 'Cancelar',
            onConfirm: () => {
                eliminarConversacionBackend(otroUsuarioId, otroUsuarioTipo);
            }
        });
    } else {
        if (confirm(`¿Seguro que deseas eliminar la conversación con ${nombre}? Esta acción no se puede deshacer.`)) {
            eliminarConversacionBackend(otroUsuarioId, otroUsuarioTipo);
        }
    }
}

function eliminarConversacionBackend(otroUsuarioId, otroUsuarioTipo) {
    fetch(`/aprendiz/chat/eliminar-conversacion/${otroUsuarioId}/${otroUsuarioTipo}`, {
        method: 'DELETE'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            mostrarNotificacionExito('Conversación eliminada correctamente');
            // Refrescar lista de conversaciones y limpiar mensajes
            cargarConversaciones();
            document.getElementById('chat-messages').innerHTML = `<div class='chat-empty'><i class='fas fa-comments fa-2x mb-2'></i><p>No hay mensajes aún. Selecciona un administrador para iniciar una conversación.</p></div>`;
            document.getElementById('chat-input').value = '';
            document.getElementById('chat-input').disabled = true;
            document.getElementById('send-chat-btn').disabled = true;
            document.getElementById('btn-regresar-chat').style.display = 'none';
            chatViewState = 'list';
            currentChatUser = null;
        } else {
            mostrarNotificacionExito(data.message || 'Error al eliminar la conversación', 'danger');
        }
    })
    .catch(error => {
        console.error('Error al eliminar conversación:', error);
        mostrarNotificacionExito('Error al eliminar la conversación', 'danger');
    });
}

// Cargar contador de mensajes no leídos al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    cargarContadorChat();
    // Actualizar cada 30 segundos
    setInterval(cargarContadorChat, 30000);

    // Event listener para el botón de regresar
    document.getElementById('btn-regresar-chat').addEventListener('click', function() {
        chatViewState = 'list';
        document.getElementById('btn-regresar-chat').style.display = 'none';
        document.getElementById('modalChatLabel').textContent = 'Chat con Administrador';
        document.getElementById('chat-input').disabled = true;
        document.getElementById('chat-input').placeholder = 'Selecciona una conversación para enviar mensajes';
        document.getElementById('send-chat-btn').disabled = true;
        mostrarListaConversaciones(cachedConversations);
    });
});

// Cargar contador de mensajes no leídos
function cargarContadorChat() {
    fetch('/aprendiz/chat/contador')
        .then(response => response.json())
        .then(data => {
            const badge = document.getElementById('badgeChat');
            if (data.success && data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        })
        .catch(error => console.error('Error al cargar contador de chat:', error));
}

// Abrir modal de chat
document.getElementById('btnChat').addEventListener('click', function() {
    chatViewState = 'list';
    document.getElementById('btn-regresar-chat').style.display = 'none';
    document.getElementById('chat-input').disabled = true;
    document.getElementById('chat-input').placeholder = 'Selecciona una conversación para enviar mensajes';
    document.getElementById('send-chat-btn').disabled = true;
    cargarConversaciones();
});

// Cargar conversaciones disponibles
function cargarConversaciones() {
    fetch('/aprendiz/chat/conversaciones')
        .then(response => response.json())
        .then(data => {
            mostrarListaConversaciones(data.conversaciones || []);
        })
        .catch(error => {
            console.error('Error al cargar conversaciones:', error);
            mostrarListaConversaciones([]);
        });
}

// Mostrar lista de conversaciones
function mostrarListaConversaciones(conversaciones) {
    cachedConversations = conversaciones;
    const chatMessages = document.getElementById('chat-messages');
    chatMessages.innerHTML = `
        <div class="mb-3">
            <h6>Buscar Administrador:</h6>
            <div class="input-group mb-3">
                <input type="text" id="search-user-input" class="form-control" placeholder="Escribe el nombre del administrador..." autocomplete="off">
                <button class="btn btn-outline-primary" type="button" onclick="buscarUsuarios()">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div id="search-results" class="mb-3" style="display: none;"></div>
            <h6>Conversaciones activas:</h6>
            ${conversaciones.length > 0 ? conversaciones.map(conv => `
                <div class="d-flex justify-content-between align-items-center p-2 border rounded mb-2 cursor-pointer conversation-item"
                  data-otro-usuario-id="${conv.otro_usuario_id}"
                  data-otro-usuario-tipo="${conv.otro_usuario_tipo}"
                  data-nombre="${conv.nombre}">
                <div class="flex-grow-1">
                    <strong>${conv.nombre}</strong>
                    ${conv.no_leidos > 0 ? `<span class="badge bg-danger ms-2">${conv.no_leidos}</span>` : ''}
                    <br>
                    <small class="text-muted">${new Date(conv.ultimo_mensaje).toLocaleString('es-CO')}</small>
                </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-danger" onclick="eliminarConversacion(${conv.otro_usuario_id}, '${conv.otro_usuario_tipo}', '${conv.nombre}')" title="Eliminar conversación">
                            <i class="fas fa-trash"></i>
                        </button>
                        <i class="fas fa-chevron-right text-muted"></i>
                    </div>
                </div>
            `).join('') : '<p class="text-muted">No hay conversaciones activas.</p>'}
        </div>
    `;

    // Agregar event listeners para las conversaciones
    document.querySelectorAll('.conversation-item').forEach(item => {
        item.addEventListener('click', function() {
            const otroUsuarioId = this.dataset.otroUsuarioId;
            const otroUsuarioTipo = this.dataset.otroUsuarioTipo;
            const nombre = this.dataset.nombre;
            abrirConversacion(otroUsuarioId, otroUsuarioTipo, nombre);
        });
    });

    // Agregar event listener para búsqueda en tiempo real
    document.getElementById('search-user-input').addEventListener('input', function() {
        const query = this.value.trim();
        if (query.length >= 2) {
            buscarUsuarios(query);
        } else {
            document.getElementById('search-results').style.display = 'none';
        }
    });
}

// Buscar usuarios
function buscarUsuarios(query = '') {
    if (!query) {
        query = document.getElementById('search-user-input').value.trim();
    }

    if (query.length < 2) {
        mostrarNotificacionExito('Escribe al menos 2 caracteres para buscar.', 'warning');
        return;
    }

    fetch(`/aprendiz/chat/buscar-usuarios?q=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                mostrarResultadosBusqueda(data.usuarios);
            } else {
                mostrarResultadosBusqueda([]);
            }
        })
        .catch(error => {
            console.error('Error al buscar usuarios:', error);
            mostrarResultadosBusqueda([]);
        });
}

// Mostrar resultados de búsqueda
function mostrarResultadosBusqueda(usuarios) {
    const resultsDiv = document.getElementById('search-results');
    if (usuarios.length > 0) {
        resultsDiv.innerHTML = `
            <div class="list-group">
                ${usuarios.map(user => `
                    <button type="button" class="list-group-item list-group-item-action search-result-item"
                            data-user-id="${user.id}"
                            data-user-tipo="admin">
                        <i class="fas fa-user-shield me-2"></i>${user.nombre}
                    </button>
                `).join('')}
            </div>
        `;
        resultsDiv.style.display = 'block';

        // Agregar event listeners para los resultados de búsqueda
        document.querySelectorAll('.search-result-item').forEach(item => {
            item.addEventListener('click', function() {
                const userId = this.dataset.userId;
                const userTipo = this.dataset.userTipo;
                // Extraer el nombre del texto del botón (después del icono)
                const nombreCompleto = this.textContent.trim();
                abrirConversacion(userId, userTipo, nombreCompleto);
            });
        });
    } else {
        resultsDiv.innerHTML = '<p class="text-muted">No se encontraron administradores.</p>';
        resultsDiv.style.display = 'block';
    }
}

// Abrir conversación específica
function abrirConversacion(otroUsuarioId, otroUsuarioTipo, nombre) {
    currentChatUser = { id: otroUsuarioId, tipo: otroUsuarioTipo };
    chatViewState = 'messages';
    document.getElementById('btn-regresar-chat').style.display = 'inline-block';
    document.getElementById('modalChatLabel').textContent = `Chat con ${nombre || 'Usuario'}`;
    document.getElementById('chat-input').disabled = false;
    document.getElementById('chat-input').placeholder = 'Escribe tu mensaje...';
    document.getElementById('send-chat-btn').disabled = false;
    cargarMensajesConversacion(otroUsuarioId, otroUsuarioTipo);
    // El badge se actualiza automáticamente en marcarMensajesComoLeidos
}

// Cargar mensajes de una conversación
function cargarMensajesConversacion(otroUsuarioId, otroUsuarioTipo) {
    const chatMessages = document.getElementById('chat-messages');
    chatMessages.innerHTML = `
        <div class="text-center">
            <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    `;

    fetch(`/aprendiz/chat/historial/${otroUsuarioId}/${otroUsuarioTipo}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                mostrarMensajes(data.mensajes);
                // Marcar mensajes como leídos
                marcarMensajesComoLeidos(data.mensajes);
            } else {
                chatMessages.innerHTML = '<div class="alert alert-warning">Error al cargar los mensajes.</div>';
            }
        })
        .catch(error => {
            console.error('Error al cargar mensajes:', error);
            chatMessages.innerHTML = '<div class="alert alert-danger">Error al cargar los mensajes.</div>';
        });
}

// Mostrar mensajes en el chat
function mostrarMensajes(mensajes) {
    const chatMessages = document.getElementById('chat-messages');
    if (mensajes.length === 0) {
        chatMessages.innerHTML = `
            <div class="chat-empty">
                <i class="fas fa-comments fa-2x mb-2"></i>
                <p>No hay mensajes en esta conversación. ¡Envía el primero!</p>
            </div>
        `;
        return;
    }

    chatMessages.innerHTML = mensajes.map(msg => `
        <div class="chat-message ${msg.es_remitente ? 'sent' : 'received'}">
            <div class="sender">${msg.es_remitente ? 'Tú' : msg.remitente_nombre}</div>
            <div>${msg.mensaje}</div>
            <div class="timestamp">${new Date(msg.fecha_creacion).toLocaleString('es-CO')}</div>
        </div>
    `).join('');

    // Scroll al final
    chatMessages.scrollTop = chatMessages.scrollHeight;
}

// Marcar mensajes como leídos
function marcarMensajesComoLeidos(mensajes) {
    const mensajesNoLeidos = mensajes.filter(msg => !msg.es_remitente && !msg.leido);
    if (mensajesNoLeidos.length === 0) {
        return;
    }
    
    mensajesNoLeidos.forEach(msg => {
        fetch(`/aprendiz/chat/mensajes/${msg.id}/marcar-leido`, {
            method: 'POST'
        }).catch(error => console.error('Error al marcar mensaje como leído:', error));
    });

    // Actualizar contador inmediatamente y después de un breve delay
    cargarContadorChat();
    setTimeout(cargarContadorChat, 500);
}

// Enviar mensaje
document.getElementById('send-chat-btn').addEventListener('click', enviarMensaje);
document.getElementById('chat-input').addEventListener('keypress', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        enviarMensaje();
    }
});

function enviarMensaje() {
    if (!currentChatUser) {
        mostrarNotificacionExito('Selecciona una conversación primero.', 'warning');
        return;
    }

    const input = document.getElementById('chat-input');
    const mensaje = input.value.trim();

    if (!mensaje) {
        mostrarNotificacionExito('Escribe un mensaje antes de enviar.', 'warning');
        return;
    }

    // Deshabilitar botón mientras se envía
    const btn = document.getElementById('send-chat-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    fetch('/aprendiz/chat/enviar', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            destinatarioId: currentChatUser.id,
            destinatarioTipo: currentChatUser.tipo,
            mensaje: mensaje
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            input.value = '';
            // Recargar mensajes con delay para asegurar que el backend haya procesado
            setTimeout(() => {
                cargarMensajesConversacion(currentChatUser.id, currentChatUser.tipo);
            }, 1000);
            mostrarNotificacionExito('Mensaje enviado correctamente.');
        } else {
            mostrarNotificacionExito(data.message || 'Error al enviar el mensaje.', 'danger');
        }
    })
    .catch(error => {
        console.error('Error al enviar mensaje:', error);
        mostrarNotificacionExito('Error al enviar el mensaje.', 'danger');
    })
    .finally(() => {
        // Rehabilitar botón
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i>';
    });
}

// Eliminar conversación
function eliminarConversacion(otroUsuarioId, otroUsuarioTipo, nombre) {
    mostrarConfirmacion({
        titulo: '¿Eliminar conversación?',
        mensaje: `¿Estás seguro de que deseas eliminar la conversación con ${nombre}? Solo se eliminará para ti, el otro usuario seguirá viendo los mensajes.`,
        tipo: 'warning',
        textoConfirmar: 'Eliminar',
        textoCancelar: 'Cancelar',
        onConfirm: () => {
            fetch(`/aprendiz/chat/conversaciones/${otroUsuarioId}/${otroUsuarioTipo}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    mostrarNotificacionExito('Conversación eliminada correctamente.');
                    // Si estamos en la conversación eliminada, regresar a la lista
                    if (currentChatUser && currentChatUser.id == otroUsuarioId && currentChatUser.tipo == otroUsuarioTipo) {
                        chatViewState = 'list';
                        document.getElementById('btn-regresar-chat').style.display = 'none';
                        document.getElementById('modalChatLabel').textContent = 'Chat con Administrador';
                        document.getElementById('chat-input').disabled = true;
                        document.getElementById('chat-input').placeholder = 'Selecciona una conversación para enviar mensajes';
                        document.getElementById('send-chat-btn').disabled = true;
                        mostrarListaConversaciones(cachedConversations.filter(conv =>
                            !(conv.otro_usuario_id == otroUsuarioId && conv.otro_usuario_tipo == otroUsuarioTipo)
                        ));
                    } else {
                        // Recargar conversaciones
                        cargarConversaciones();
                    }
                } else {
                    mostrarNotificacionExito(data.message || 'Error al eliminar la conversación.', 'danger');
                }
            })
            .catch(error => {
                console.error('Error al eliminar conversación:', error);
                mostrarNotificacionExito('Error al eliminar la conversación.', 'danger');
            });
        }
    });
}

// Auto-resize del textarea
document.getElementById('chat-input').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 100) + 'px';
});
