<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Gráfico de evolución de métricas
        if (document.getElementById('metricasChart')) {
            const analisisData = <%- JSON.stringify(analisisSentimientos.analisisDetallado || []) %>;

            if (analisisData && analisisData.length > 1) {
                // Preparar datos para el gráfico
                const labels = analisisData.map((item, index) => `Bitácora ${index + 1}`);
                const estadoEmocional = analisisData.map(item => item.scorePromedio || 0);
                const compromiso = analisisData.map(item => item.nivelCompromiso || 0);

                // Crear gráfico de líneas
                const ctx = document.getElementById('metricasChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Estado Emocional',
                            data: estadoEmocional,
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.1)',
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgb(75, 192, 192)',
                            yAxisID: 'y'
                        }, {
                            label: 'Compromiso (%)',
                            data: compromiso,
                            borderColor: 'rgb(255, 99, 132)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgb(255, 99, 132)',
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Estado Emocional (-5 a 5)'
                                },
                                min: -5,
                                max: 5,
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Compromiso (%)'
                                },
                                min: 0,
                                max: 100,
                                grid: {
                                    drawOnChartArea: false,
                                },
                            }
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.datasetIndex === 0) {
                                            // Estado emocional
                                            label += context.parsed.y.toFixed(1);
                                        } else {
                                            // Compromiso
                                            label += context.parsed.y + '%';
                                        }
                                        return label;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }
    });
</script>
