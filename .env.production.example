# Archivo de ejemplo para variables de entorno en producción (Azure)
# IMPORTANTE: Las variables reales deben configurarse en Azure App Service > Configuration

# Entorno
NODE_ENV=production
PORT=8080

# Base de Datos MySQL - Azure Database for MySQL
DB_HOST=mysql-sena-etapa-productiva.mysql.database.azure.com
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=gestion_etapa_productiva
DB_PORT=3306
DB_SSL_CA=/home/site/wwwroot/DigiCertGlobalRootG2.crt.pem

# Azure Blob Storage
USE_AZURE_BLOB=true
AZURE_STORAGE_ACCOUNT_NAME=tu_cuenta_storage
AZURE_STORAGE_ACCOUNT_KEY=tu_key_storage
AZURE_STORAGE_CONNECTION_STRING=tu_connection_string
AZURE_STORAGE_CONTAINER_NAME=documentos

# Sesiones
SESSION_SECRET=tu_session_secret_muy_largo_y_seguro

# Redis (Opcional)
REDIS_HOST=tu_redis_host.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=tu_redis_password
USE_REDIS=false

# Email (Opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email
EMAIL_PASSWORD=tu_password_email

# Watson Assistant (Opcional)
WATSON_ASSISTANT_ID=tu_assistant_id
WATSON_API_KEY=tu_watson_api_key
WATSON_URL=tu_watson_url
