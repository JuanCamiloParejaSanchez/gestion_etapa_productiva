                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Error -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error de Validación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: var(--font-size-5xl);"></i>
                </div>
                <h4 class="text-danger mb-3">Fechas Inválidas</h4>
                <div id="errorModalBody"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('editarMiPerfilForm');
        const messageContainer = document.getElementById('messageContainer');

        // Animación de entrada
        document.querySelector('.edit-profile-card').style.opacity = '0';
        document.querySelector('.edit-profile-card').style.transform = 'translateY(20px)';
        
        setTimeout(() => {
            document.querySelector('.edit-profile-card').style.transition = 'all 0.5s ease-in-out';
            document.querySelector('.edit-profile-card').style.opacity = '1';
            document.querySelector('.edit-profile-card').style.transform = 'translateY(0)';
        }, 100);

        if (form) {
            form.addEventListener('submit', async function(event) {
                event.preventDefault();

                // Validar fechas antes de enviar
                const fechaInicioLectiva = document.getElementById('fechaInicioLectiva').value;
                const fechaFinLectiva = document.getElementById('fechaFinLectiva').value;
                const fechaInicioProductiva = document.getElementById('fechaInicioProductiva').value;
                const fechaFinProductiva = document.getElementById('fechaFinProductiva').value;

                if (fechaInicioLectiva && fechaFinLectiva && new Date(fechaFinLectiva) < new Date(fechaInicioLectiva)) {
                    const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    document.getElementById('errorModalBody').innerHTML = '<p>La fecha de fin de la etapa lectiva no puede ser anterior a la fecha de inicio.</p>';
                    errorModal.show();
                    return;
                }

                if (fechaInicioProductiva && fechaFinProductiva && new Date(fechaFinProductiva) < new Date(fechaInicioProductiva)) {
                    const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    document.getElementById('errorModalBody').innerHTML = '<p>La fecha de fin de la etapa productiva no puede ser anterior a la fecha de inicio.</p>';
                    errorModal.show();
                    return;
                }

                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...';

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(form.action, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok) {
                        // Mostrar modal de éxito
                        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                        successModal.show();

                        // Configurar el botón de aceptar para redirigir
                        document.getElementById('confirmButton').addEventListener('click', function() {
                            window.location.href = '/aprendiz/perfil?t=' + Date.now();
                        });
                    } else {
                        throw new Error(result.message || 'Ocurrió un error en el servidor.');
                    }
                } catch (error) {
                    console.error('Error al enviar el formulario:', error);
                    messageContainer.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
                    submitButton.disabled = false;
                    submitButton.innerHTML = '<i class="fas fa-save me-2"></i> Guardar Cambios';
                }
            });
        }

        // Cargar datos de ubicación
        const cargarDatosUbicacion = async () => {
            try {
                const response = await fetch('/data/colombia.json');

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                const departamentoSelect = document.getElementById('departamento');
                const municipioSelect = document.getElementById('municipio');

                if (!departamentoSelect || !municipioSelect) {
                    return;
                }

                // Obtener valores guardados (normalizar para comparación case-insensitive)
                const departamentoGuardado = '<%- aprendiz.departamento || "" %>'.trim();
                const municipioGuardado = '<%- aprendiz.municipio || "" %>'.trim();

                // Cargar departamentos
                departamentoSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                data.forEach(item => {
                    if (item && item.departamento) {
                        const option = document.createElement('option');
                        option.value = item.departamento;
                        option.textContent = item.departamento.toUpperCase();
                        
                        // Comparación case-insensitive
                        if (item.departamento.toLowerCase() === departamentoGuardado.toLowerCase()) {
                            option.selected = true;
                        }
                        departamentoSelect.appendChild(option);
                    }
                });

                // Función para cargar municipios según departamento
                const cargarMunicipios = (depValue, municipioASeleccionar = null) => {
                    municipioSelect.innerHTML = '<option value="">SELECCIONE UN MUNICIPIO...</option>';
                    if (!depValue) return;

                    const departamento = data.find(d => d.departamento.toLowerCase() === depValue.toLowerCase());
                    if (departamento?.ciudades) {
                        departamento.ciudades.forEach(ciudad => {
                            const option = document.createElement('option');
                            option.value = ciudad;
                            option.textContent = ciudad.toUpperCase();
                            
                            // Si se proporciona un municipio para seleccionar, comparar case-insensitive
                            if (municipioASeleccionar && ciudad.toLowerCase() === municipioASeleccionar.toLowerCase()) {
                                option.selected = true;
                            }
                            municipioSelect.appendChild(option);
                        });
                    }
                };

                // Evento change para departamentos
                departamentoSelect.addEventListener('change', function() {
                    const selectedDep = this.value;
                    cargarMunicipios(selectedDep);
                });

                // Cargar municipios del departamento actual si existe
                if (departamentoGuardado) {
                    cargarMunicipios(departamentoGuardado, municipioGuardado);
                }
            } catch (error) {
                console.error('Error cargando datos:', error);
            }
        };

        // Inicializar carga de datos
        cargarDatosUbicacion();

        // Normalizar inputs y selects a mayúsculas en frontend (EXCEPTO EMAIL)
        const upperCaseInputs = document.querySelectorAll('input[type="text"], input[type="tel"]');
        upperCaseInputs.forEach(input => {
            input.style.textTransform = 'uppercase';
            input.addEventListener('input', function() {
                this.value = this.value.toUpperCase();
            });
        });

        // Manejar email por separado (convertir a minúsculas)
        const emailInput = document.querySelector('input[type="email"]');
        if (emailInput) {
            emailInput.style.textTransform = 'lowercase';
            emailInput.addEventListener('input', function() {
                this.value = this.value.toLowerCase();
            });
        }

        // Normalizar selects a mayúsculas visualmente
        const selects = document.querySelectorAll('select');
        selects.forEach(select => {
            select.style.textTransform = 'uppercase';
        });

        // Restringir entrada en campos de texto (solo letras, espacios y caracteres especiales), excepto dirección y horario
        const textInputs = document.querySelectorAll('input[type="text"]:not([name="numeroDocumento"]):not([name="numeroFicha"]):not([name="direccion"]):not([name="direccionEmpresa"]):not([name="horario"])');
        textInputs.forEach(input => {
            input.addEventListener('input', function() {
                this.value = this.value.replace(/[^a-zA-Z\sáéíóúÁÉÍÓÚñÑ]/g, '');
            });
        });

        // Restringir entrada en campos numéricos (solo dígitos)
        const numberInputs = document.querySelectorAll('input[type="tel"], input[name="numeroDocumento"], input[name="numeroFicha"]');
        numberInputs.forEach(input => {
            input.addEventListener('input', function() {
                this.value = this.value.replace(/\D/g, '');
            });
        });
    });
</script>