<!-- Ruta: vistas/administrador/editarAprendiz.ejs -->
<!-- Propósito: Interfaz para modificar la información de un aprendiz existente.
     Permite actualizar todos los campos del registro de un aprendiz. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/components/forms.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<%- contentFor('styles') %>

<%- contentFor('body') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/listar-aprendices">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar
            </a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Editar Aprendiz</h2>
        </div>
        <div class="card-body">
            <div id="messageContainer"></div>

            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <%= successMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= errorMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

    <% if (typeof aprendiz !== 'undefined') { %>
                <form id="editarAprendizForm"
                      data-tipo="admin"
                      method="POST"
                      action="/administrador/aprendiz/actualizar/<%= aprendiz.id %>">
            <% for (let key in aprendiz) { %>
                <% if (key !== 'id' && key !== 'password' && key !== 'fechaUltimoCorreoAlerta') { %>
                    <div class="mb-3">
                        <label for="<%= key %>" class="form-label">
                            <% if (key === 'created_at') { %>
                                Fecha creación de usuario
                            <% } else if (key === 'updated_at') { %>
                                Fecha última actualización
                            <% } else { %>
                                <%= key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1').trim() %>
                            <% } %>
                        </label>

                        <% if (key.toLowerCase().includes('fecha')) { %>
                            <input type="date"
                                   class="form-control"
                                   id="<%= key %>"
                                   name="<%= key %>"
                                   value="<%= aprendiz[key] ? new Date(aprendiz[key]).toISOString().split('T')[0] : '' %>">

                        <% } else if (key === 'tipoDocumento') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="CC" <%= aprendiz[key] === 'CC' ? 'selected' : '' %>>Cédula de Ciudadanía</option>
                                <option value="TI" <%= aprendiz[key] === 'TI' ? 'selected' : '' %>>Tarjeta de Identidad</option>
                                <option value="CE" <%= aprendiz[key] === 'CE' ? 'selected' : '' %>>Cédula de Extranjería</option>
                                <option value="PEP" <%= aprendiz[key] === 'PEP' ? 'selected' : '' %>>Permiso Especial de Permanencia</option>
                                <option value="PPT" <%= aprendiz[key] === 'PPT' ? 'selected' : '' %>>Permiso por Protección Temporal</option>
                            </select>

                        <% } else if (key === 'alternativaSeleccionada') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="contratoAprendizaje" <%= aprendiz[key] === 'contratoAprendizaje' ? 'selected' : '' %>>
                                    Contrato de Aprendizaje
                                </option>
                                <option value="pasantia" <%= aprendiz[key] === 'pasantia' ? 'selected' : '' %>>
                                    Pasantía
                                </option>
                                <option value="apoyoEntidades" <%= aprendiz[key] === 'apoyoEntidades' ? 'selected' : '' %>>
                                    Apoyo a Entidades
                                </option>
                                <option value="proyectosProductivos" <%= aprendiz[key] === 'proyectosProductivos' ? 'selected' : '' %>>
                                    Proyecto Productivo
                                </option>
                                <option value="monitoria" <%= aprendiz[key] === 'monitoria' ? 'selected' : '' %>>
                                    Monitoría
                                </option>
                            </select>

                        <% } else if (key === 'estadoFormacion') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="activo" <%= aprendiz[key] === 'activo' ? 'selected' : '' %>>Activo</option>
                                <option value="inactivo" <%= aprendiz[key] === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
                                <option value="aplazado" <%= aprendiz[key] === 'aplazado' ? 'selected' : '' %>>Aplazado</option>
                                <option value="retirado" <%= aprendiz[key] === 'retirado' ? 'selected' : '' %>>Retirado</option>
                                <option value="certificado" <%= aprendiz[key] === 'certificado' ? 'selected' : '' %>>Certificado</option>
                            </select>

                        <% } else if (key === 'eps') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="">SELECCIONE...</option>
                                <option value="COOSALUD EPS-S" <%= aprendiz[key] === 'COOSALUD EPS-S' ? 'selected' : '' %>>COOSALUD EPS-S</option>
                                <option value="NUEVA EPS" <%= aprendiz[key] === 'NUEVA EPS' ? 'selected' : '' %>>NUEVA EPS</option>
                                <option value="MUTUAL SER" <%= aprendiz[key] === 'MUTUAL SER' ? 'selected' : '' %>>MUTUAL SER</option>
                                <option value="ALIANSALUD EPS" <%= aprendiz[key] === 'ALIANSALUD EPS' ? 'selected' : '' %>>ALIANSALUD EPS</option>
                                <option value="SALUD TOTAL EPS S.A." <%= aprendiz[key] === 'SALUD TOTAL EPS S.A.' ? 'selected' : '' %>>SALUD TOTAL EPS S.A.</option>
                                <option value="EPS SANITAS" <%= aprendiz[key] === 'EPS SANITAS' ? 'selected' : '' %>>EPS SANITAS</option>
                                <option value="EPS SURA" <%= aprendiz[key] === 'EPS SURA' ? 'selected' : '' %>>EPS SURA</option>
                                <option value="FAMISANAR" <%= aprendiz[key] === 'FAMISANAR' ? 'selected' : '' %>>FAMISANAR</option>
                                <option value="SERVICIO OCCIDENTAL DE SALUD EPS SOS" <%= aprendiz[key] === 'SERVICIO OCCIDENTAL DE SALUD EPS SOS' ? 'selected' : '' %>>SERVICIO OCCIDENTAL DE SALUD EPS SOS</option>
                                <option value="SALUD MIA" <%= aprendiz[key] === 'SALUD MIA' ? 'selected' : '' %>>SALUD MIA</option>
                                <option value="COMFENALCO VALLE" <%= aprendiz[key] === 'COMFENALCO VALLE' ? 'selected' : '' %>>COMFENALCO VALLE</option>
                                <option value="COMPENSAR EPS" <%= aprendiz[key] === 'COMPENSAR EPS' ? 'selected' : '' %>>COMPENSAR EPS</option>
                                <option value="EPM - EMPRESAS PUBLICAS DE MEDELLIN" <%= aprendiz[key] === 'EPM - EMPRESAS PUBLICAS DE MEDELLIN' ? 'selected' : '' %>>EPM - EMPRESAS PUBLICAS DE MEDELLIN</option>
                                <option value="FONDO DE PASIVO SOCIAL DE FERROCARRILES NACIONALES DE COLOMBIA" <%= aprendiz[key] === 'FONDO DE PASIVO SOCIAL DE FERROCARRILES NACIONALES DE COLOMBIA' ? 'selected' : '' %>>FONDO DE PASIVO SOCIAL DE FERROCARRILES NACIONALES DE COLOMBIA</option>
                                <option value="CAJACOPI ATLANTICO" <%= aprendiz[key] === 'CAJACOPI ATLANTICO' ? 'selected' : '' %>>CAJACOPI ATLANTICO</option>
                                <option value="CAPRESOCA" <%= aprendiz[key] === 'CAPRESOCA' ? 'selected' : '' %>>CAPRESOCA</option>
                                <option value="COMFACHOCO" <%= aprendiz[key] === 'COMFACHOCO' ? 'selected' : '' %>>COMFACHOCO</option>
                                <option value="COMFAORIENTE" <%= aprendiz[key] === 'COMFAORIENTE' ? 'selected' : '' %>>COMFAORIENTE</option>
                                <option value="EPS FAMILIAR DE COLOMBIA" <%= aprendiz[key] === 'EPS FAMILIAR DE COLOMBIA' ? 'selected' : '' %>>EPS FAMILIAR DE COLOMBIA</option>
                                <option value="ASMET SALUD" <%= aprendiz[key] === 'ASMET SALUD' ? 'selected' : '' %>>ASMET SALUD</option>
                                <option value="EMSSANAR E.S.S." <%= aprendiz[key] === 'EMSSANAR E.S.S.' ? 'selected' : '' %>>EMSSANAR E.S.S.</option>
                                <option value="CAPITAL SALUD EPS-S" <%= aprendiz[key] === 'CAPITAL SALUD EPS-S' ? 'selected' : '' %>>CAPITAL SALUD EPS-S</option>
                                <option value="SAVIA SALUD EPS" <%= aprendiz[key] === 'SAVIA SALUD EPS' ? 'selected' : '' %>>SAVIA SALUD EPS</option>
                                <option value="DUSAKAWI EPSI" <%= aprendiz[key] === 'DUSAKAWI EPSI' ? 'selected' : '' %>>DUSAKAWI EPSI</option>
                                <option value="ASOCIACION INDIGENA DEL CAUCA EPSI" <%= aprendiz[key] === 'ASOCIACION INDIGENA DEL CAUCA EPSI' ? 'selected' : '' %>>ASOCIACION INDIGENA DEL CAUCA EPSI</option>
                                <option value="ANAS WAYUU EPSI" <%= aprendiz[key] === 'ANAS WAYUU EPSI' ? 'selected' : '' %>>ANAS WAYUU EPSI</option>
                                <option value="MALLAMAS EPSI" <%= aprendiz[key] === 'MALLAMAS EPSI' ? 'selected' : '' %>>MALLAMAS EPSI</option>
                                <option value="PIJAOS SALUD EPSI" <%= aprendiz[key] === 'PIJAOS SALUD EPSI' ? 'selected' : '' %>>PIJAOS SALUD EPSI</option>
                                <option value="SALUD BÓLIVAR EPS SAS" <%= aprendiz[key] === 'SALUD BÓLIVAR EPS SAS' ? 'selected' : '' %>>SALUD BÓLIVAR EPS SAS</option>
                                <option value="NO APLICA" <%= aprendiz[key] === 'NO APLICA' ? 'selected' : '' %>>NO APLICA</option>
                            </select>

                        <% } else if (key === 'departamento') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="">SELECCIONE...</option>
                            </select>

                        <% } else if (key === 'municipio') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="">SELECCIONE UN MUNICIPIO...</option>
                            </select>

                        <% } else if (key === 'programaFormacion') { %>
                            <select class="form-select" id="<%= key %>" name="<%= key %>">
                                <option value="">SELECCIONE...</option>
                                <option value="tecnoActividadFisica" <%= aprendiz[key] === 'tecnoActividadFisica' ? 'selected' : '' %>>TECNOLOGÍA EN ACTIVIDAD FÍSICA</option>
                                <option value="tecnoEntrenamientoDeportivo" <%= aprendiz[key] === 'tecnoEntrenamientoDeportivo' ? 'selected' : '' %>>TECNOLOGÍA EN ENTRENAMIENTO DEPORTIVO</option>
                                <option value="tecnoAnalisisDesarrollo" <%= aprendiz[key] === 'tecnoAnalisisDesarrollo' ? 'selected' : '' %>>TECNÓLOGO EN ANÁLISIS Y DESARROLLO DE SOFTWARE</option>
                                <option value="tecProcesamientoPruebas" <%= aprendiz[key] === 'tecProcesamientoPruebas' ? 'selected' : '' %>>TÉCNICO EN PROCESAMIENTO DE PRUEBAS DE SOFTWARE</option>
                                <option value="tecProgramacion" <%= aprendiz[key] === 'tecProgramacion' ? 'selected' : '' %>>TÉCNICO EN PROGRAMACIÓN DE SOFTWARE</option>
                            </select>

                        <% } else if (key === 'created_at') { %>
                            <input type="text"
                                   class="form-control"
                                   id="<%= key %>"
                                   name="<%= key %>"
                                   value="<%= aprendiz[key] ? new Date(aprendiz[key]).toLocaleString('es-ES', {
                                       weekday: 'long',
                                       year: 'numeric',
                                       month: 'long',
                                       day: 'numeric',
                                       hour: '2-digit',
                                       minute: '2-digit',
                                       second: '2-digit'
                                   }) : '' %>"
                                   readonly>

                        <% } else if (key === 'updated_at') { %>
                            <input type="text"
                                   class="form-control"
                                   id="<%= key %>"
                                   name="<%= key %>"
                                   value="<%= aprendiz[key] ? new Date(aprendiz[key]).toLocaleString('es-ES', {
                                       weekday: 'long',
                                       year: 'numeric',
                                       month: 'long',
                                       day: 'numeric',
                                       hour: '2-digit',
                                       minute: '2-digit',
                                       second: '2-digit'
                                   }) + ' - Usuario: ' + (typeof userName !== 'undefined' ? userName : 'Administrador') : '' %>"
                                   readonly>

                        <% } else { %>
                            <input type="text"
                                   class="form-control"
                                   id="<%= key %>"
                                   name="<%= key %>"
                                   value="<%= aprendiz[key] || '' %>">
                        <% } %>
                    </div>
                <% } %>
            <% } %>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>
                    Guardar Cambios
                </button>
                <a href="/administrador/listar-aprendices" class="btn btn-secondary btn-cancel-editar">Cancelar</a>
            </div>
        </form>
    <% } else { %>
        <div class="alert alert-danger">
            No se encontraron datos del aprendiz.
        </div>
            <% } %>
        </div>
    </div>
</div>
<!-- Modal de Éxito -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle me-2"></i>
                    ¡Éxito!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-check-circle text-success" style="font-size: var(--font-size-5xl);"></i>
                </div>
                <h4 class="text-success mb-3">Aprendiz Actualizado</h4>
                <p class="mb-0">La información del aprendiz ha sido actualizada exitosamente.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success px-4" id="confirmButton">
                    <i class="fas fa-check me-2"></i>
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Error -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error de Validación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: var(--font-size-5xl);"></i>
                </div>
                <h4 class="text-danger mb-3">Fechas Inválidas</h4>
                <div id="errorModalBody"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>


<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('editarAprendizForm');
        const messageContainer = document.getElementById('messageContainer');

        // Animación de entrada
        document.querySelector('.container').style.opacity = '0';
        document.querySelector('.container').style.transform = 'translateY(20px)';

        setTimeout(() => {
            document.querySelector('.container').style.transition = 'all 0.5s ease-in-out';
            document.querySelector('.container').style.opacity = '1';
            document.querySelector('.container').style.transform = 'translateY(0)';
        }, 100);

        if (form) {
            form.addEventListener('submit', async function(event) {
                event.preventDefault();

                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...';

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok) {
                        // Mostrar modal de éxito
                        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                        successModal.show();

                        // Configurar el botón de aceptar para recargar la página
                        document.getElementById('confirmButton').addEventListener('click', function() {
                            window.location.reload();
                        });
                    } else {
                        throw new Error(result.message || 'Ocurrió un error en el servidor.');
                    }
                } catch (error) {
                    console.error('Error al enviar el formulario:', error);
                    messageContainer.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
                    submitButton.disabled = false;
                    submitButton.innerHTML = '<i class="fas fa-save me-2"></i> Guardar Cambios';
                }
            });
        } else {
            // PRUEBA DE ERROR: El script no encontró el formulario
            console.error('ERROR: ¡El script se ejecutó PERO no pudo encontrar el formulario!');
        }

        console.log('Formulario de edición de aprendiz cargado correctamente');

        // Cargar datos de ubicación para edición
        const cargarDatosUbicacionEdicion = async () => {
            try {
                console.log('Iniciando carga de datos de ubicación para edición...');
                const response = await fetch('/data/colombia.json');

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                console.log('Datos de ubicación cargados:', data);

                const departamentoSelect = document.getElementById('departamento');
                const municipioSelect = document.getElementById('municipio');

                if (!departamentoSelect || !municipioSelect) {
                    console.error('Selectores de ubicación no encontrados');
                    return;
                }

                // Cargar departamentos
                departamentoSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                data.forEach(item => {
                    if (item && item.departamento) {
                        const option = document.createElement('option');
                        option.value = item.departamento;
                        option.textContent = item.departamento.toUpperCase();
                        // Preseleccionar si coincide con el valor actual del aprendiz
                        if (item.departamento === '<%= aprendiz.departamento %>') {
                            option.selected = true;
                        }
                        departamentoSelect.appendChild(option);
                    }
                });

                // Evento change para departamentos
                departamentoSelect.addEventListener('change', function() {
                    const selectedDep = this.value;
                    console.log('Departamento seleccionado:', selectedDep);

                    municipioSelect.innerHTML = '<option value="">SELECCIONE UN MUNICIPIO...</option>';
                    if (!selectedDep) return;

                    const departamento = data.find(d => d.departamento === selectedDep);
                    if (departamento?.ciudades) {
                        departamento.ciudades.forEach(ciudad => {
                            const option = document.createElement('option');
                            option.value = ciudad;
                            option.textContent = ciudad.toUpperCase();
                            // Preseleccionar si coincide con el valor actual del aprendiz
                            if (ciudad === '<%= aprendiz.municipio %>') {
                                option.selected = true;
                            }
                            municipioSelect.appendChild(option);
                        });
                    }
                });

                // Cargar municipios del departamento actual si existe
                const currentDep = '<%= aprendiz.departamento %>';
                if (currentDep) {
                    const departamento = data.find(d => d.departamento === currentDep);
                    if (departamento?.ciudades) {
                        municipioSelect.innerHTML = '<option value="">SELECCIONE UN MUNICIPIO...</option>';
                        departamento.ciudades.forEach(ciudad => {
                            const option = document.createElement('option');
                            option.value = ciudad;
                            option.textContent = ciudad.toUpperCase();
                            if (ciudad === '<%= aprendiz.municipio %>') {
                                option.selected = true;
                            }
                            municipioSelect.appendChild(option);
                        });
                    }
                }

            } catch (error) {
                console.error('Error cargando datos de ubicación:', error);
            }
        };

        // Inicializar carga de datos de ubicación
        cargarDatosUbicacionEdicion();
    });
</script>
