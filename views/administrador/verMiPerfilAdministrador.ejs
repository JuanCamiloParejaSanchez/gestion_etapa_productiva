<!-- Ruta: vistas/administrador/verMiPerfil.ejs -->
<!-- Propósito: Visualización del perfil personal del administrador -->

<%- contentFor('styles') %>
<%- contentFor('body') %>
<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/panel">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar al Panel de Administrador
            </a>
        </div>    
    </div>
</nav>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Mi Perfil de Administrador</h2>
        </div>
        <div class="card-body">
            <% if (typeof administrador !== 'undefined' && administrador) { %>
                <p><strong>Nombre completo:</strong> <%= administrador.nombreCompleto || 'N/A' %></p>
                <p><strong>Correo Institucional:</strong> <%= administrador.correoInstitucional || 'N/A' %></p>
                <p><strong>Número de identificación:</strong> <%= administrador.numeroIdentificacion || 'N/A' %></p>
                <p><strong>Teléfono:</strong> <%= administrador.telefono || 'N/A' %></p>
                <p><strong>Departamento:</strong> <%= administrador.departamento || 'N/A' %></p>
                <p><strong>Cargo o rol:</strong> <%= administrador.cargo || 'N/A' %></p>


                <div class="mt-4 text-center">
                    <a href="/administrador/editar-perfil" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Editar Perfil
                    </a>
                </div>

            <% } else { %>
                <div class="alert alert-danger">
                    No se encontró información para su perfil.
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>