<style>
/* Tooltips para botones deshabilitados */
.action-btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    position: relative;
}
.action-btn.disabled:hover::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #333;
    color: white;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    z-index: 1000;
    margin-bottom: 5px;
    pointer-events: none;
}
.action-btn.disabled:hover::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: #333;
    margin-bottom: -5px;
    pointer-events: none;
}

/* Alerta de confirmación elegante */
.custom-alert-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.custom-alert-overlay.active {
    opacity: 1;
    visibility: visible;
}

.custom-alert-box {
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    max-width: 450px;
    width: 90%;
    overflow: hidden;
    transform: scale(0.7);
    transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.custom-alert-overlay.active .custom-alert-box {
    transform: scale(1);
}

.custom-alert-header {
    background: linear-gradient(135deg, #ff4444, #cc0000);
    padding: 30px;
    text-align: center;
    position: relative;
}

.custom-alert-icon {
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 15px;
    animation: pulse 2s infinite;
}

.custom-alert-icon i {
    font-size: 40px;
    color: #ffffff;
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    }
    50% {
        transform: scale(1.05);
        box-shadow: 0 0 0 10px rgba(255, 255, 255, 0);
    }
}

.custom-alert-header h3 {
    color: #ffffff;
    margin: 0;
    font-size: 24px;
    font-weight: 700;
}

.custom-alert-body {
    padding: 30px;
    text-align: center;
}

.custom-alert-body p {
    color: #555555;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
}

.custom-alert-footer {
    padding: 20px 30px 30px;
    display: flex;
    gap: 15px;
    justify-content: center;
}

.custom-alert-btn {
    flex: 1;
    padding: 14px 28px;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.custom-alert-btn-cancel {
    background: #f0f0f0;
    color: #666666;
}

.custom-alert-btn-cancel:hover {
    background: #e0e0e0;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.custom-alert-btn-confirm {
    background: linear-gradient(135deg, #ff4444, #cc0000);
    color: #ffffff;
    position: relative;
    overflow: hidden;
}

.custom-alert-btn-confirm::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.custom-alert-btn-confirm:hover::before {
    width: 300px;
    height: 300px;
}

.custom-alert-btn-confirm:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(255, 68, 68, 0.4);
}

/* Modo oscuro */
@media (prefers-color-scheme: dark) {
    .custom-alert-box {
        background: #2d2d2d;
    }

    .custom-alert-body p {
        color: #e0e0e0;
    }

    .custom-alert-btn-cancel {
        background: #3d3d3d;
        color: #e0e0e0;
    }

    .custom-alert-btn-cancel:hover {
        background: #4d4d4d;
    }
}

/* Responsive */
@media (max-width: 576px) {
    .custom-alert-box {
        max-width: 95%;
    }

    .custom-alert-header {
        padding: 20px;
    }

    .custom-alert-icon {
        width: 60px;
        height: 60px;
    }

    .custom-alert-icon i {
        font-size: 30px;
    }

    .custom-alert-header h3 {
        font-size: 20px;
    }

    .custom-alert-body {
        padding: 20px;
    }

    .custom-alert-footer {
        flex-direction: column;
        padding: 15px 20px 20px;
    }

    .custom-alert-btn {
        width: 100%;
    }
}
</style>

