<!-- Ruta: vistas/administrador/verMiPerfil.ejs -->
<!-- Propósito: Visualización del perfil personal del administrador -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<style>
.btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

html.dark-mode .fas.fa-edit {
    color: #ffffff;
}

html.dark-mode .btn-primary {
    color: #ffffff !important;
}

html.dark-mode .btn-primary:hover {
    color: #ffffff !important;
    background-color: #0b5ed7 !important;
    border-color: #0b5ed7 !important;
}

/* Estilos para la foto de perfil */
.profile-photo-section {
    display: flex;
    justify-content: center;
    margin-bottom: 30px;
    padding: 20px;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border-radius: 15px;
}

html.dark-mode .profile-photo-section {
    background: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);
}

.profile-photo-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
}

.profile-photo-display {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 5px solid #007bff;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 25px rgba(0, 123, 255, 0.3);
    transition: all 0.3s ease;
}

.profile-photo-display:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 35px rgba(0, 123, 255, 0.5);
}

.profile-photo-display img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-photo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-align: center;
    padding: 20px;
}

.profile-photo-placeholder i {
    font-size: 60px;
    margin-bottom: 10px;
    opacity: 0.7;
}

.profile-photo-placeholder span {
    font-size: 14px;
    font-weight: 500;
}

@media (max-width: 768px) {
    .profile-photo-display {
        width: 140px;
        height: 140px;
    }
    
    .profile-photo-placeholder i {
        font-size: 48px;
    }
}
</style>

<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/listar-administradores">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar a la lista
            </a>
        </div>    
    </div>
</nav>

<%- contentFor('body') %>
<div class="container mt-4 mb-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0"><%= typeof title !== 'undefined' ? title : 'Mi Perfil de Administrador' %></h2>
        </div>
        <div class="card-body">
            <% if (typeof administrador !== 'undefined' && administrador) { %>
                
                <!-- Sección de Foto de Perfil -->
                <div class="profile-photo-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-display">
                            <% 
                            // Construir la ruta correcta de la foto
                            let rutaFoto = null;
                            if (administrador.fotoPerfilPath) {
                                // Si tiene fotoPerfilPath, usarla (puede ser ruta relativa ya correcta)
                                rutaFoto = administrador.fotoPerfilPath.startsWith('/') ? administrador.fotoPerfilPath : '/' + administrador.fotoPerfilPath;
                            } else if (administrador.fotoPerfil) {
                                // Si solo tiene fotoPerfil (nombre del archivo), construir ruta completa
                                rutaFoto = `/uploads/fotos/optimized/${administrador.fotoPerfil}`;
                            }
                            
                            // Agregar timestamp para evitar caché del navegador
                            if (rutaFoto) {
                                rutaFoto += '?t=' + Date.now();
                            }
                            %>
                            
                            <% if (rutaFoto) { %>
                                <img src="<%= rutaFoto %>" alt="Foto de perfil de <%= administrador.nombreCompleto %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="profile-photo-placeholder" style="display: none;">
                                    <i class="fas fa-user"></i>
                                    <span>Sin foto</span>
                                </div>
                            <% } else { %>
                                <div class="profile-photo-placeholder">
                                    <i class="fas fa-user"></i>
                                    <span>Sin foto</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <p><strong>Nombre completo:</strong> <%= administrador.nombreCompleto || 'N/A' %></p>
                <p><strong>Correo Institucional:</strong> <%= administrador.correoInstitucional || 'N/A' %></p>
                <p><strong>Número de identificación:</strong> <%= administrador.numeroIdentificacion || 'N/A' %></p>
                <p><strong>Teléfono:</strong> <%= administrador.telefono || 'N/A' %></p>
                <p><strong>Departamento:</strong> <%= administrador.departamento || 'N/A' %></p>
                <p><strong>Cargo o rol:</strong> <%= administrador.cargo || 'N/A' %></p>


                <div class="mt-4 text-center">
                    <% if ((typeof esMiPerfil !== 'undefined' && esMiPerfil) || (administrador.cargo && administrador.cargo.toLowerCase() !== 'administrador')) { %>
                        <% if (typeof esMiPerfil !== 'undefined' && esMiPerfil) { %>
                            <a href="/administrador/editar-perfil" class="btn btn-primary">
                                <i class="fas fa-edit"></i> Editar Perfil
                            </a>
                        <% } else { %>
                            <a href="/administrador/administrador/editar/<%= administrador.id %>" class="btn btn-primary">
                                <i class="fas fa-edit"></i> Editar Administrador
                            </a>
                        <% } %>
                    <% } else { %>
                        <button class="btn btn-secondary disabled" title="No puedes editar administradores" disabled>
                            <i class="fas fa-edit"></i> Editar Administrador
                        </button>
                    <% } %>
                </div>

            <% } else { %>
                <div class="alert alert-danger">
                    No se encontró información para su perfil.
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>