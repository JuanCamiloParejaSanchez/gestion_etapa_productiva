# Base de datos
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=tu_base_datos
DB_PORT=3306

# Sesiones
SESSION_SECRET=tu_clave_secreta_para_sesiones

# Correo electrónico
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_email

# Watson AI
WATSON_API_KEY=tu_api_key_watson
WATSON_SERVICE_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com/instances/tu_instance_id
WATSON_VERSION=2022-04-07

# Almacenamiento de archivos
# Cloudinary (gratuito - recomendado para pruebas)
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000