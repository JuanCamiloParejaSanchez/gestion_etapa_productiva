<style>
    .is-valid {
        border-color: #28a745 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='m2.3 6.73.8.78 4.05-4.05-.78-.78L3.09 5.9z'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right calc(0.375em + 0.1875rem) center !important;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem) !important;
    }

    .is-invalid {
        border-color: #dc3545 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 4.6 2.4 2.4m-2.4 0 2.4-2.4'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right calc(0.375em + 0.1875rem) center !important;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem) !important;
    }

    .form-text.text-danger {
        display: none;
        margin-top: 0.25rem;
        font-size: 0.875em;
        color: #dc3545 !important;
    }

    /* Estilos para la foto de perfil */
    .profile-photo-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .profile-photo-preview {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #e0e0e0;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .profile-photo-preview:hover {
        border-color: #007bff;
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(0, 123, 255, 0.2);
    }

    .profile-photo-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .profile-photo-preview img.active {
        display: block;
    }

    .profile-photo-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 14px;
        text-align: center;
        padding: 20px;
    }

    .profile-photo-placeholder i {
        font-size: 48px;
        margin-bottom: 10px;
        opacity: 0.5;
    }

    .profile-photo-input {
        display: none;
    }
    
    .profile-photo-input.is-invalid + .profile-photo-label {
        border: 2px solid #dc3545;
        animation: shake 0.5s;
    }
    
    .profile-photo-input.is-valid + .profile-photo-label {
        border: 2px solid #28a745;
    }
    
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
        20%, 40%, 60%, 80% { transform: translateX(5px); }
    }

    .profile-photo-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 25px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .profile-photo-label:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    }

    .profile-photo-label i {
        font-size: 16px;
    }

    .profile-photo-remove {
        display: none;
        padding: 8px 16px;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 10px rgba(220, 53, 69, 0.3);
    }

    .profile-photo-remove:hover {
        background: #c82333;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.5);
    }

    .profile-photo-remove.active {
        display: inline-block;
    }

    .profile-photo-info {
        font-size: 12px;
        color: #6c757d;
        text-align: center;
        max-width: 200px;
    }

    @media (max-width: 768px) {
        .profile-photo-preview {
            width: 120px;
            height: 120px;
        }
    }
</style>

