<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
</style>

<%- contentFor('body') %>
<div class="container-fluid mt-4">
    <div class="modern-table-container">
        <div class="modern-table-header">
            <h2>
                <i class="fas fa-users header-icon"></i>
                Listado de Administradores
            </h2>
        </div>
        
        <div class="card-body" style="padding: 1rem;">
            <!-- Filtros de búsqueda -->
            <div class="filters-container">
                <form id="searchForm" method="GET">
                    <div class="filters-row">
                        <div class="form-group">
                            <label for="nombreBusqueda" class="modern-form-label">
                                <i class="fas fa-user me-1"></i>Nombre o Apellido
                            </label>
                            <input type="text" class="form-control modern-form-control" id="nombreBusqueda" name="nombre" placeholder="Ingrese nombre o apellido">
                        </div>
                        <div class="form-group">
                            <label for="documentoBusqueda" class="modern-form-label">
                                <i class="fas fa-id-card me-1"></i>Número de Documento
                            </label>
                            <input type="text" class="form-control modern-form-control" id="documentoBusqueda" name="documento" placeholder="Ingrese número de documento">
                        </div>
                    </div>
                    <div class="filters-actions">
                        <button type="submit" class="btn-custom btn-custom-primary" style="width: 140px; height: 38px;">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button type="button" id="limpiarFiltrosBtn" class="btn-custom btn-custom-secondary" style="width: 140px; height: 38px;">
                            <i class="fas fa-eraser"></i> Limpiar
                        </button>
                        <button type="button" id="resetearOrdenamientoBtn" class="btn-custom btn-custom-sena" style="width: 160px; height: 38px;">
                            <i class="fas fa-undo-alt"></i> Resetear Orden
                        </button>
                    </div>
                </form>
            </div>

            <!-- Controles de tabla -->
            <div class="table-controls">
                <div class="table-controls-left">
                    <!-- Selector de registros por página -->
                    <div class="d-flex align-items-center">
                        <label class="form-label mb-0 me-2">Mostrar</label>
                        <div class="registros-selector">
                            <button type="button" class="registros-selector-btn" id="registrosSelectorBtn">
                                <span id="registrosActual">10</span>
                                <i class="fas fa-chevron-down ms-auto"></i>
                            </button>
                            <div class="registros-selector-dropdown" id="registrosSelectorDropdown">
                                <div class="registros-selector-header">Seleccionar cantidad</div>
                                <div class="registros-selector-list">
                                    <div class="registros-option active" data-value="10">10 registros</div>
                                    <div class="registros-option" data-value="25">25 registros</div>
                                    <div class="registros-option" data-value="50">50 registros</div>
                                    <div class="registros-option" data-value="-1">Todos</div>
                                </div>
                            </div>
                        </div>
                        <span class="ms-2 registros-label">registros</span>
                    </div>
                    
                    <!-- Selector de columnas -->
                    <div class="column-selector">
                        <button type="button" class="column-selector-btn" id="columnSelectorBtn">
                            <i class="fas fa-columns"></i>
                            <span>Columnas</span>
                            <i class="fas fa-chevron-down ms-auto"></i>
                        </button>
                        <div class="column-selector-dropdown" id="columnSelectorDropdown">
                            <div class="column-selector-header">Seleccionar Columnas</div>
                            <div class="column-selector-list" id="columnSelectorList">
                                <!-- Las opciones se generarán dinámicamente -->
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Botones de exportación -->
                <div class="table-controls-right">
                    <button type="button" id="btnExportExcel" class="btn-custom btn-custom-excel" style="width: 120px; height: 32px;">
                        <i class="fas fa-file-excel"></i> Excel
                    </button>
                    <button type="button" id="btnExportPDF" class="btn-custom btn-custom-pdf" style="width: 120px; height: 32px;">
                        <i class="fas fa-file-pdf"></i> PDF
                    </button>
                </div>
            </div>

            <!-- Tabla de Administradores -->
            <div class="table-responsive">
                <table id="administradoresTable" class="modern-table">
                    <thead>
                        <tr>
                            <th data-column="numeroIdentificacion">Documento</th>
                            <th data-column="nombreCompleto">Nombre</th>
                            <th data-column="correoInstitucional">Correo institucional</th>
                            <th data-column="telefono">Teléfono</th>
                            <th data-column="departamento">Departamento</th>
                            <th data-column="cargo">Cargo</th>
                            <th data-column="acciones" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar a este administrador? Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/admin/ordenamientoTabla.js"></script>
<script type="module">
    import utilidadesAdmin from '/js/admin/utilidadesAdmin.js';
    
    // Crear una versión adaptada de OrdenamientoTabla para administradores
    class OrdenamientoTablaAdministradores extends OrdenamientoTabla {
        agregarIconosOrdenamiento() {
            const tabla = document.getElementById('administradoresTable'); // Cambiar aquí el ID
            if (!tabla) {
                console.log('Tabla administradoresTable no encontrada, no se ejecutará el ordenamiento');
                return;
            }

            const thead = tabla.querySelector('thead tr');
            if (!thead) {
                console.log('Header de tabla no encontrado, reintentando...');
                setTimeout(() => this.agregarIconosOrdenamiento(), 100);
                return;
            }

            // Verificar si ya se agregaron los íconos
            if (thead.querySelector('.sortable-header')) {
                console.log('Íconos de ordenamiento ya agregados');
                return;
            }

            console.log('Agregando íconos de ordenamiento...');

            // Crear contenedor global para dropdowns
            if (!document.getElementById('global-dropdown-container')) {
                const dropdownContainer = document.createElement('div');
                dropdownContainer.id = 'global-dropdown-container';
                dropdownContainer.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 99999;';
                document.body.appendChild(dropdownContainer);
            }

            // Obtener todas las columnas excepto la última (acciones)
            const columnas = thead.querySelectorAll('th:not(:last-child)');
            
            columnas.forEach((th, index) => {
                const columnaData = th.getAttribute('data-column');
                if (!columnaData || columnaData === 'acciones') return;

                // Obtener el texto original del header
                const headerText = th.textContent.trim();
                
                // Crear contenedor para el header
                th.innerHTML = `
                    <div class="header-content">
                        <span class="header-text">${headerText}</span>
                        <div class="sort-icon" data-column="${columnaData}" data-index="${index}">
                            <i class="fas fa-sort"></i>
                        </div>
                    </div>
                `;
                
                // Agregar clase sortable-header al th
                th.classList.add('sortable-header');
            });

            console.log('Íconos de ordenamiento agregados exitosamente');
            
            // Configurar evento para cuando se muestren columnas ocultas
            this.configurarEventoColumnasVisibles();
        }

        configurarEventoColumnasVisibles() {
            // Escuchar cambios en la visibilidad de columnas para administradores
            const tabla = $('#administradoresTable').DataTable(); // Cambiar aquí el ID
            if (tabla) {
                tabla.on('column-visibility.dt', (e, settings, column, state) => {
                    if (state) {
                        // Si se muestra una columna, agregar íconos de ordenamiento después de un breve delay
                        setTimeout(() => {
                            this.agregarIconosAColumnasOcultas();
                        }, 100);
                    }
                });
            }
        }

        agregarIconosAColumnasOcultas() {
            const tabla = document.getElementById('administradoresTable'); // Cambiar aquí el ID
            if (!tabla) return;

            const thead = tabla.querySelector('thead tr');
            if (!thead) return;

            // Obtener todas las columnas excepto la última (acciones)
            const columnas = thead.querySelectorAll('th:not(:last-child)');
            
            columnas.forEach((th, index) => {
                const columnaData = th.getAttribute('data-column');
                if (!columnaData || columnaData === 'acciones') return;

                // Verificar si ya tiene controles de ordenamiento
                if (th.querySelector('.sort-icon')) return;

                // Obtener el texto del header
                const headerText = th.textContent.trim();
                
                // Crear contenedor para el header con controles de ordenamiento
                th.innerHTML = `
                    <div class="header-content">
                        <span class="header-text">${headerText}</span>
                        <div class="sort-icon" data-column="${columnaData}" data-index="${index}">
                            <i class="fas fa-sort"></i>
                        </div>
                    </div>
                `;
                
                // Agregar clase sortable-header al th
                th.classList.add('sortable-header');
            });

            console.log('Íconos agregados a columnas ocultas');
        }

        aplicarOrdenamientoDataTable(columna, tipoOrden) {
            // Obtener la instancia de DataTable para administradores
            const tabla = $('#administradoresTable').DataTable(); // Cambiar aquí el ID
            if (!tabla) {
                console.log('DataTable no encontrado');
                return;
            }

            console.log('Aplicando ordenamiento:', { columna, tipoOrden });

            // Actualizar variable global para que se use en la próxima recarga
            window.ordenamientoActual = {
                columna: columna,
                direccion: tipoOrden
            };

            // Recargar la tabla para aplicar el ordenamiento
            tabla.ajax.reload(() => {
                console.log('Tabla recargada con nuevo ordenamiento');
            });
        }

        // Método para obtener el tipo de columna específico para administradores
        getColumnType(columna) {
            const columnTypes = {
                'numeroIdentificacion': 'number',
                'nombreCompleto': 'text',
                'correoInstitucional': 'text',
                'telefono': 'number',
                'departamento': 'text',
                'cargo': 'text'
            };
            
            return columnTypes[columna] || 'text';
        }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        // Configuración de columnas
        const columnasConfig = [
            { data: "numeroIdentificacion", title: "Documento", visible: true },
            { data: "nombreCompleto", title: "Nombre", visible: true },
            { data: "correoInstitucional", title: "Correo institucional", visible: true },
            { data: "telefono", title: "Teléfono", visible: true },
            { data: "departamento", title: "Departamento", visible: true },
            { data: "cargo", title: "Cargo", visible: true },
            { data: "acciones", title: "Acciones", visible: true, orderable: false }
        ];

        // Inicializar selector de registros
        function inicializarSelectorRegistros() {
            const dropdown = document.getElementById('registrosSelectorDropdown');
            const btn = document.getElementById('registrosSelectorBtn');
            const actualSpan = document.getElementById('registrosActual');

            // Eventos del botón
            btn.addEventListener('click', () => {
                dropdown.classList.toggle('show');
                btn.classList.toggle('active');
            });

            // Cerrar al hacer clic fuera
            document.addEventListener('click', (e) => {
                if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.remove('show');
                    btn.classList.remove('active');
                }
            });

            // Manejar selección de opciones
            dropdown.addEventListener('click', (e) => {
                if (e.target.classList.contains('registros-option')) {
                    const value = e.target.getAttribute('data-value');
                    const text = e.target.textContent.replace(' registros', '').replace('Todos', '-1');

                    // Actualizar el texto del botón
                    actualSpan.textContent = text === '-1' ? 'Todos' : text;

                    // Cambiar la clase active
                    document.querySelectorAll('.registros-option').forEach(opt => opt.classList.remove('active'));
                    e.target.classList.add('active');

                    // Cambiar registros en la tabla
                    const valor = parseInt(value);
                    tabla.page.len(valor).draw();

                    // Cerrar dropdown
                    dropdown.classList.remove('show');
                    btn.classList.remove('active');
                }
            });
        }

        // Inicializar selector de columnas
        function inicializarSelectorColumnas() {
            const dropdown = document.getElementById('columnSelectorDropdown');
            const list = document.getElementById('columnSelectorList');
            const btn = document.getElementById('columnSelectorBtn');

            // Generar opciones de columnas
            columnasConfig.forEach(col => {
                if (col.data !== 'acciones') { // Excluir columna de acciones
                    const item = document.createElement('div');
                    item.className = 'column-selector-item';
                    item.innerHTML = `
                        <input type="checkbox" id="col_${col.data}" ${col.visible ? 'checked' : ''}>
                        <label for="col_${col.data}">${col.title}</label>
                    `;
                    list.appendChild(item);
                }
            });

            // Eventos del selector
            btn.addEventListener('click', () => {
                dropdown.classList.toggle('show');
                btn.classList.toggle('active');
            });

            // Cerrar al hacer clic fuera
            document.addEventListener('click', (e) => {
                if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.remove('show');
                    btn.classList.remove('active');
                }
            });

            // Manejar cambios en las columnas
            list.addEventListener('change', (e) => {
                if (e.target.type === 'checkbox') {
                    const columnData = e.target.id.replace('col_', '');
                    const isVisible = e.target.checked;

                    // Actualizar configuración
                    const colConfig = columnasConfig.find(col => col.data === columnData);
                    if (colConfig) {
                        colConfig.visible = isVisible;
                    }

                    // Actualizar tabla
                    if (tabla) {
                        const columnIndex = tabla.column(`[data-column="${columnData}"]`).index();
                        if (columnIndex !== -1) {
                            tabla.column(columnIndex).visible(isVisible);

                            // Si se está mostrando la columna, agregar íconos de ordenamiento
                            if (isVisible && window.ordenamientoTabla) {
                                setTimeout(() => {
                                    window.ordenamientoTabla.agregarIconosAColumnasOcultas();
                                }, 100);
                            }
                        }
                    }
                }
            });
        }

        // Función para formatear fechas
        function formatearFecha(fecha) {
            if (!fecha) return '';
            const date = new Date(fecha);
            return date.toLocaleDateString('es-ES', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
            });
        }

        // Función para obtener clase de estado
        function getEstadoClass(estado) {
            const estadoLower = estado.toLowerCase();
            if (estadoLower.includes('activo') || estadoLower.includes('en curso')) {
                return 'estado-activo';
            } else if (estadoLower.includes('inactivo') || estadoLower.includes('finalizado')) {
                return 'estado-inactivo';
            } else {
                return 'estado-pendiente';
            }
        }

        // Función para obtener datos de ordenamiento
        function getOrderData() {
            const ordenamiento = window.ordenamientoActual;
            if (!ordenamiento || !ordenamiento.columna) {
                console.log('No hay ordenamiento activo');
                return null;
            }
            
            console.log('Ordenamiento actual:', ordenamiento);
            
            // Mapear el tipo de ordenamiento a dirección
            let direccion = 'asc';
            if (ordenamiento.direccion === 'desc' || ordenamiento.direccion === 'newest') {
                direccion = 'desc';
            }
            
            // Mapear nombre de columna a índice y tipo
            const columnMapping = {
                'numeroIdentificacion': { index: 0, type: 'number' },
                'nombreCompleto': { index: 1, type: 'text' },
                'correoInstitucional': { index: 2, type: 'text' },
                'telefono': { index: 3, type: 'number' },
                'departamento': { index: 4, type: 'text' },
                'cargo': { index: 5, type: 'text' }
            };
            
            const columnInfo = columnMapping[ordenamiento.columna];
            if (columnInfo) {
                const orderData = [{
                    column: columnInfo.index,
                    dir: direccion
                }];
                console.log('Datos de ordenamiento enviados:', orderData);
                return orderData;
            }
            
            console.log('Columna no encontrada en el mapeo:', ordenamiento.columna);
            return null;
        }

        const tabla = utilidadesAdmin.inicializarTablaAdministradores('#administradoresTable', {
            ajax: { 
                url: '/administrador/administradores-data', 
                type: 'POST', 
                data: d => ({ 
                    ...d, 
                    nombre: $('#nombreBusqueda').val(), 
                    documento: $('#documentoBusqueda').val(),
                    order: getOrderData()
                }) 
            },
            language: { url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json' },
            info: false,
            dom: 'rtip',
            pageLength: 10,
            ordering: false, // Deshabilitar ordenamiento nativo de DataTables
            columns: columnasConfig.map(col => {
                if (col.data === 'acciones') {
                    return {
                        data: null,
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        visible: col.visible,
                        render: (data, type, row) => `
                            <div class="action-buttons">
                                <a href="/administrador/administrador/${row.id}" class="action-btn btn-view" title="Ver Perfil Completo">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/administrador/administrador/editar/${row.id}" class="action-btn btn-edit" title="Editar Administrador">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button class="action-btn btn-delete eliminar-administrador" data-id="${row.id}" title="Eliminar Administrador">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        `
                    };
                } else if (col.data.includes('fecha') || col.data.includes('Fecha')) {
                    return {
                        data: col.data,
                        visible: col.visible,
                        render: (data, type, row) => {
                            if (type === 'display') {
                                return formatearFecha(data);
                            }
                            return data;
                        }
                    };
                } else {
                    return {
                        data: col.data,
                        visible: col.visible
                    };
                }
            })
        });

        // Inicializar selector de columnas
        inicializarSelectorColumnas();

        // Inicializar selector de registros
        inicializarSelectorRegistros();

        // Inicializar sistema de ordenamiento después de que DataTables termine de cargar
        tabla.on('draw.dt', function() {
            if (!window.ordenamientoInicializado) {
                window.ordenamientoTabla = new OrdenamientoTablaAdministradores();
                window.ordenamientoInicializado = true;
            }
        });

        // Inicialización alternativa después de un breve delay
        setTimeout(() => {
            if (!window.ordenamientoInicializado) {
                window.ordenamientoTabla = new OrdenamientoTablaAdministradores();
                window.ordenamientoInicializado = true;
            }
        }, 1000);

        // Eventos de formulario
        $('#searchForm').on('submit', e => { 
            e.preventDefault(); 
            tabla.ajax.reload(); 
        });
        
        $('#limpiarFiltrosBtn').on('click', () => { 
            $('#searchForm')[0].reset(); 
            tabla.ajax.reload(); 
        });
        
        $('#resetearOrdenamientoBtn').on('click', () => {
            if (window.ordenamientoTabla) {
                window.ordenamientoTabla.resetearOrdenamiento();
                tabla.ajax.reload();
            }
        });
        
        // Modal de eliminación
        const confirmDeleteModal = new bootstrap.Modal($('#confirmDeleteModal'));
        let administradorAEliminar = null;
        
        $('#administradoresTable').on('click', '.eliminar-administrador', function() {
            administradorAEliminar = $(this).data('id');
            confirmDeleteModal.show();
        });

        $('#confirmDelete').on('click', async () => {
            if (!administradorAEliminar) return;
            try {
                const response = await fetch(`/administrador/administrador/${administradorAEliminar}`, { method: 'DELETE' });
                const data = await response.json();
                if (response.ok && data.success) {
                    tabla.ajax.reload();
                } else {
                    throw new Error(data.message || 'Error al eliminar');
                }
            } catch (err) {
                console.error('Error al eliminar administrador:', err);
            } finally {
                confirmDeleteModal.hide();
                administradorAEliminar = null;
            }
        });

        // Botones de exportación
        $('#btnExportExcel').on('click', function() {
            tabla.button('.buttons-excel').trigger();
        });

        $('#btnExportPDF').on('click', function() {
            tabla.button('.buttons-pdf').trigger();
        });
    });
</script>
