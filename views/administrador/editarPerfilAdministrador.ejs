<!-- Ruta: vistas/administrador/editarMiPerfil.ejs -->
<!-- Propósito: Formulario para editar el perfil personal del administrador -->

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<%- contentFor('styles') %>
<style>
    .edit-profile-card {
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    .edit-header {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        border-radius: 10px 10px 0 0;
        padding: 1.5rem;
        text-align: center;
    }
    .form-section {
        border-left: 4px solid #007bff;
        background: #f8f9fa;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 0 8px 8px 0;
    }
    .section-title {
        color: #007bff;
        font-weight: 600;
        margin-bottom: 1rem;
        font-size: var(--font-size-lg);
    }
    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }
    .form-control:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,0.25);
    }
    .required {
        color: #dc3545;
    }
    .btn-save-profile {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s;
    }
    .btn-save-profile:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40,167,69,0.3);
    }
    .btn-cancel {
        border: 2px solid #6c757d;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        color: #6c757d;
        background: transparent;
        transition: all 0.3s;
    }
    .btn-cancel:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-2px);
    }
}

/* Estilos para modo oscuro */
html.dark-mode .edit-profile-card {
    background-color: #1e293b;
    color: #f1f5f9;
    border-color: #334155;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

html.dark-mode .edit-header {
    background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
}

html.dark-mode .form-section {
    background: #334155;
    border-left-color: #60a5fa;
}

html.dark-mode .section-title {
    color: #60a5fa;
}

html.dark-mode .form-label {
    color: #cbd5e1;
}

html.dark-mode .required {
    color: #dc3545;
}
</style>

<%- contentFor('body') %>

<!-- Barra de navegación -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="navbar-nav w-100 justify-content-start">
            <a href="/administrador/perfil" class="btn btn-primary btn-navbar">
                <i class="fas fa-arrow-left me-2"></i>
                Volver al Perfil
            </a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card edit-profile-card">
                <div class="edit-header">
                    <h2 class="mb-1">
                        <i class="fas fa-user-edit me-2"></i>
                        <%= typeof title !== 'undefined' ? title : 'Editar Mi Perfil' %>
                    </h2>
                    <p class="mb-0 opacity-75"><%= typeof esMiPerfil !== 'undefined' && esMiPerfil ? 'Actualiza tu información personal y profesional' : 'Actualiza la información del administrador' %></p>
                </div>
                
                <div class="card-body p-4">
                    <div id="messageContainer" class="mb-3"></div>
                    
                    <form id="editProfileForm" action="<%= typeof esMiPerfil !== 'undefined' && esMiPerfil ? '/administrador/actualizar-perfil' : '/administrador/administrador/actualizar/' + administrador.id %>" method="POST">
                        <!-- Datos Personales -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fas fa-user me-2"></i>
                                Datos Personales
                            </h3>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="nombreCompleto" class="form-label">
                                        Nombre completo <span class="required">*</span>
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="nombreCompleto" 
                                           name="nombreCompleto" 
                                           value="<%= administrador.nombreCompleto || '' %>"
                                           required 
                                           placeholder="Ej: JUAN CARLOS PÉREZ GÓMEZ">
                                    <small id="nombreCompletoHelp" class="form-text text-danger" style="display:none;"></small>
                                </div>
                                
                                <div class="col-md-6">
                                    <label for="correoInstitucional" class="form-label">
                                        Correo institucional <span class="required">*</span>
                                    </label>
                                    <input type="email" 
                                           class="form-control" 
                                           id="correoInstitucional" 
                                           name="correoInstitucional" 
                                           value="<%= administrador.correoInstitucional || '' %>"
                                           required 
                                           placeholder="Ej: juan.perez@sena.edu.co">
                                    <small id="correoInstitucionalHelp" class="form-text text-danger" style="display:none;"></small>
                                </div>
                                
                                <div class="col-md-6">
                                    <label for="numeroIdentificacion" class="form-label">
                                        Número de identificación <span class="required">*</span>
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="numeroIdentificacion" 
                                           name="numeroIdentificacion" 
                                           value="<%= administrador.numeroIdentificacion || '' %>"
                                           required 
                                           placeholder="Ej: 1234567890">
                                    <small id="numeroIdentificacionHelp" class="form-text text-danger" style="display:none;"></small>
                                </div>
                                
                                <div class="col-md-6">
                                    <label for="telefono" class="form-label">
                                        Teléfono de contacto <span class="required">*</span>
                                    </label>
                                    <input type="tel" 
                                           class="form-control" 
                                           id="telefono" 
                                           name="telefono" 
                                           value="<%= administrador.telefono || '' %>"
                                           required 
                                           placeholder="Ej: 3001234567"
                                           minlength="10"
                                           maxlength="10"
                                           pattern="\d{10}"
                                           title="Debe contener exactamente 10 dígitos">
                                    <small id="telefonoHelp" class="form-text text-danger" style="display:none;"></small>
                                </div>
                            </div>
                        </div>

                        <!-- Información Institucional -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fas fa-building me-2"></i>
                                Información Institucional
                            </h3>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="departamento" class="form-label">
                                        Departamento o área <span class="required">*</span>
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="departamento" 
                                           name="departamento" 
                                           value="<%= administrador.departamento || '' %>"
                                           required 
                                           placeholder="Ej: TECNOLOGÍA DE LA INFORMACIÓN">
                                    <small id="departamentoHelp" class="form-text text-danger" style="display:none;"></small>
                                </div>
                                
                                <div class="col-md-6">
                                    <label for="cargo" class="form-label">
                                        Cargo o rol <span class="required">*</span>
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="cargo" 
                                           name="cargo" 
                                           value="<%= administrador.cargo || '' %>"
                                           required 
                                           placeholder="Ej: COORDINADOR ACADÉMICO">
                                    <small id="cargoHelp" class="form-text text-danger" style="display:none;"></small>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="text-center">
                            <button type="submit" class="btn btn-success btn-save-profile me-3">
                                <i class="fas fa-save me-2"></i>
                                Guardar Cambios
                            </button>
                            <a href="<%= typeof esMiPerfil !== 'undefined' && esMiPerfil ? '/administrador/perfil' : '/administrador/administrador/' + administrador.id %>" class="btn btn-cancel">
                                <i class="fas fa-times me-2"></i>
                                Cancelar
                            </a>
                        </div>
                        
                        <p class="text-center mt-3" style="font-size:var(--font-size-sm);">
                            <span class="required">*</span> Campos obligatorios
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Éxito -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle me-2"></i>
                    ¡Éxito!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-check-circle text-success" style="font-size: var(--font-size-5xl);"></i>
                </div>
                <h4 class="text-success mb-3">Perfil Actualizado</h4>
                <p class="mb-0">Tu información personal ha sido actualizada exitosamente.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success px-4" id="confirmButton">
                    <i class="fas fa-check me-2"></i>
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script type="module">
    import { showSuccessMessage, showErrorMessage } from '/js/utilidades/utils.js';
    
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('editProfileForm');
        const messageContainer = document.getElementById('messageContainer');
        
        // Animación de entrada
        document.querySelector('.edit-profile-card').style.opacity = '0';
        document.querySelector('.edit-profile-card').style.transform = 'translateY(20px)';
        
        setTimeout(() => {
            document.querySelector('.edit-profile-card').style.transition = 'all 0.5s ease-in-out';
            document.querySelector('.edit-profile-card').style.opacity = '1';
            document.querySelector('.edit-profile-card').style.transform = 'translateY(0)';
        }, 100);
        
        // Validación del formulario
        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            // Limpiar mensajes previos
            messageContainer.innerHTML = '';

            // Validaciones básicas
            const nombreCompleto = document.getElementById('nombreCompleto').value.trim();
            const correoInstitucional = document.getElementById('correoInstitucional').value.trim();
            const numeroIdentificacion = document.getElementById('numeroIdentificacion').value.trim();
            const telefono = document.getElementById('telefono').value.trim();
            const departamento = document.getElementById('departamento').value.trim();
            const cargo = document.getElementById('cargo').value.trim();

            let isValid = true;

            // Validar nombre completo
            if (!nombreCompleto || nombreCompleto.length < 3) {
                showFieldError('nombreCompleto', 'El nombre completo debe tener al menos 3 caracteres');
                isValid = false;
            }

            // Validar correo
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!correoInstitucional || !emailRegex.test(correoInstitucional)) {
                showFieldError('correoInstitucional', 'Ingrese un correo electrónico válido');
                isValid = false;
            }

            // Validar número de identificación
            if (!numeroIdentificacion || !/^\d{7,12}$/.test(numeroIdentificacion)) {
                showFieldError('numeroIdentificacion', 'El número de identificación debe tener entre 7 y 12 dígitos');
                isValid = false;
            }

            // Validar teléfono
            if (!telefono || !/^\d{10}$/.test(telefono)) {
                showFieldError('telefono', 'El teléfono debe tener exactamente 10 dígitos');
                isValid = false;
            }

            if (isValid) {
                // Deshabilitar botón de envío
                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...';

                // Enviar datos con fetch
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok) {
                        // Mostrar modal de éxito
                        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                        successModal.show();

                        // Configurar el botón de aceptar para redirigir
                        document.getElementById('confirmButton').addEventListener('click', function() {
                            window.location.href = '<%= typeof esMiPerfil !== "undefined" && esMiPerfil ? "/administrador/perfil" : "/administrador/administrador/" + administrador.id %>';
                        });
                    } else {
                        throw new Error(result.message || 'Ocurrió un error en el servidor.');
                    }
                } catch (error) {
                    console.error('Error al enviar el formulario:', error);
                    messageContainer.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
                    submitButton.disabled = false;
                    submitButton.innerHTML = '<i class="fas fa-save me-2"></i> Guardar Cambios';
                }
            }
        });
        
        function showFieldError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const helpElement = document.getElementById(fieldId + 'Help');
            
            field.classList.add('is-invalid');
            helpElement.textContent = message;
            helpElement.style.display = 'block';
            
            // Limpiar error al escribir
            field.addEventListener('input', function() {
                this.classList.remove('is-invalid');
                helpElement.style.display = 'none';
            });
        }
        
        console.log('Formulario de edición de perfil cargado correctamente');
        
        // Agregar validaciones y conversión a mayúscula
        const textFields = ['nombreCompleto', 'departamento', 'cargo'];
        const numberFields = ['numeroIdentificacion', 'telefono'];
        
        textFields.forEach(fieldId => {
            const field = document.getElementById(fieldId);
            field.addEventListener('input', function() {
                this.value = this.value.toUpperCase().replace(/[^A-ZÁÉÍÓÚÑ\s]/gi, '');
            });
        });
        
        numberFields.forEach(fieldId => {
            const field = document.getElementById(fieldId);
            field.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
        });
    });
</script>
