<%- contentFor('body') %>

<div class="container-fluid mt-4">
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">Información del Aprendiz</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title"><%= aprendiz.nombres %> <%= aprendiz.primerApellido %> <%= aprendiz.segundoApellido %></h5>
            <p class="card-text"><strong>Documento:</strong> <%= aprendiz.tipoDocumento %> - <%= aprendiz.numeroDocumento %></p>
            <p class="card-text"><strong>Programa de Formación:</strong> <%= aprendiz.programaFormacion %></p>
            <p class="card-text"><strong>Email:</strong> <%= aprendiz.correoElectronico %></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Documentos Entregados</h4>
        </div>
        <div class="card-body">
            <% if (documentos && documentos.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Tipo de Documento</th>
                                <th>Descripción</th>
                                <th>Nombre del Archivo</th>
                                <th>Fecha de Subida</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% documentos.forEach(doc => { %>
                                <%
                                    // Hacemos el código robusto para aceptar tanto camelCase como snake_case
                                    const tipoDocumento = doc.tipoDocumento || doc.tipo_documento;
                                    const descripcion = doc.descripcion;
                                    const nombreOriginal = doc.nombreOriginal || doc.nombre_original;
                                    const fechaSubida = doc.fechaSubida || doc.fecha_subida;
                                    const nombreGuardado = doc.nombreGuardado || doc.nombre_guardado;
                                    const rutaArchivo = doc.rutaArchivo || doc.ruta_archivo;
                                    const estado = doc.estado || 'pendiente';
                                    const idDocumento = doc.id;
                                    const retroalimentacion = doc.retroalimentacion;

                                    let fileUrl;
                                    // Verificar si estamos usando Azure Blob Storage (variable pasada desde el controlador)
                                    if (typeof useAzure !== 'undefined' && useAzure) {
                                        // Si ya tenemos una URL SAS generada desde el controlador, usarla
                                        if (doc.sasUrl) {
                                            fileUrl = doc.sasUrl;
                                        }
                                        // Si rutaArchivo ya es una URL completa (http/https), la usamos directamente
                                        else if (rutaArchivo && (rutaArchivo.startsWith('http://') || rutaArchivo.startsWith('https://'))) {
                                            fileUrl = rutaArchivo;
                                        } else {
                                            // Construir URL de Azure Blob Storage
                                            // rutaArchivo suele ser "documentos/archivo.pdf" (blobName)
                                            const path = rutaArchivo || nombreGuardado;
                                            // Limpiar slash inicial si existe
                                            const cleanPath = path && path.startsWith('/') ? path.substring(1) : path;
                                            
                                            if (cleanPath) {
                                                fileUrl = `https://${azureAccountName}.blob.core.windows.net/${azureContainerName}/${cleanPath}`;
                                            } else {
                                                fileUrl = '#'; // Fallback si no hay path
                                            }
                                        }
                                    } else {
                                        // Entorno local o servidor sin Azure Blob
                                        // Usar rutaArchivo si existe, o construir la ruta local por defecto
                                        fileUrl = rutaArchivo || `/uploads/documentos/${nombreGuardado}`;
                                    }
                                %>
                                <tr>
                                    <td><%= tipoDocumento %></td>
                                    <td><%= descripcion || 'N/A' %></td>
                                    <td><%= nombreOriginal %></td>
                                    <td><%= formatearFechaLocal(fechaSubida) %></td>
                                    <td>
                                        <% if (estado === 'aprobado') { %>
                                            <span class="badge bg-success">Aprobado</span>
                                        <% } else if (estado === 'rechazado') { %>
                                            <span class="badge bg-danger">Rechazado</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="<%= fileUrl %>" 
                                               class="btn btn-info btn-sm" 
                                               target="_blank" 
                                               title="Ver Documento">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <!-- Botón aprobar siempre visible -->
                                            <button class="btn btn-success btn-sm" 
                                                    onclick="aprobarDocumento(<%= idDocumento %>)" 
                                                    title="Aprobar">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <!-- Botón rechazar siempre visible -->
                                            <button class="btn btn-danger btn-sm" 
                                                    onclick="mostrarModalRetroalimentacion(<%= idDocumento %>, '<%= tipoDocumento %>')" 
                                                    title="Rechazar">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <% if (retroalimentacion) { %>
                                                <%
                                                    // Determinar título según el estado
                                                    let tituloBoton = 'Ver Retroalimentación';
                                                    let iconoSwal = 'info';
                                                    let tituloSwal = 'Retroalimentación';
                                                    
                                                    if (estado === 'aprobado') {
                                                        tituloBoton = 'Ver Comentario de Aprobación';
                                                        iconoSwal = 'success';
                                                        tituloSwal = 'Comentario del Tutor';
                                                    } else if (estado === 'rechazado') {
                                                        tituloBoton = 'Ver Motivo de Rechazo';
                                                        iconoSwal = 'warning';
                                                        tituloSwal = 'Motivo del Rechazo';
                                                    }
                                                %>
                                                <button class="btn btn-warning btn-sm" 
                                                        onclick="Swal.fire({
                                                            title: '<%= tituloSwal %>', 
                                                            html: '<div style=&quot;text-align: left; white-space: pre-wrap;&quot;><%= retroalimentacion.replace(/'/g, "\\'").replace(/\n/g, "<br>") %></div>', 
                                                            icon: '<%= iconoSwal %>',
                                                            confirmButtonText: 'Cerrar',
                                                            width: '600px'
                                                        })" 
                                                        title="<%= tituloBoton %>">
                                                    <i class="fas fa-comment"></i>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-warning" role="alert">
                    El aprendiz aún no ha subido ningún documento.
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Modal de Retroalimentación para Rechazo -->
<div class="modal fade" id="modalRetroalimentacion" tabindex="-1" aria-labelledby="modalRetroalimentacionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger" style="background-color: #dc3545 !important; background-image: none !important; border-color: #dc3545 !important;">
                <h5 class="modal-title text-white" id="modalRetroalimentacionLabel" style="color: #ffffff !important;">Rechazar Documento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formRetroalimentacion">
                    <input type="hidden" id="documentoId" name="documentoId">
                    <p>Vas a rechazar el documento: <strong id="tipoDocumentoTexto"></strong></p>
                    <div class="mb-3">
                        <label for="retroalimentacion" class="form-label">Motivo del rechazo / Retroalimentación:</label>
                        <textarea class="form-control" 
                                  id="retroalimentacion" 
                                  name="retroalimentacion" 
                                  rows="4" 
                                  required 
                                  placeholder="Explica al aprendiz qué debe corregir en el documento..."></textarea>
                        <small class="text-muted">Esta retroalimentación será enviada al aprendiz para que pueda corregir el documento.</small>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" 
                               type="checkbox" 
                               id="enviarEmail" 
                               name="enviarEmail" 
                               checked>
                        <label class="form-check-label" for="enviarEmail">
                            Enviar notificación por correo electrónico
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="rechazarDocumento()">Rechazar Documento</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Retroalimentación para Aprobación -->
<div class="modal fade" id="modalRetroalimentacionAprobacion" tabindex="-1" aria-labelledby="modalRetroalimentacionAprobacionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white" style="background-color: #28a745 !important; background-image: none !important; border-color: #28a745 !important;">
                <h5 class="modal-title text-white" id="modalRetroalimentacionAprobacionLabel" style="color: #ffffff !important;">Aprobar Documento con Retroalimentación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formRetroalimentacionAprobacion">
                    <input type="hidden" id="documentoIdAprobacion" name="documentoIdAprobacion">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Puedes agregar comentarios positivos, sugerencias o felicitaciones al aprendiz.
                    </div>
                    <div class="mb-3">
                        <label for="retroalimentacionAprobacion" class="form-label">Comentarios / Retroalimentación (opcional):</label>
                        <textarea class="form-control"
                                  id="retroalimentacionAprobacion"
                                  name="retroalimentacionAprobacion"
                                  rows="4"
                                  placeholder="Ejemplo: Excelente trabajo, el documento está muy bien estructurado. Sigue así..."></textarea>
                        <small class="text-muted">Esta retroalimentación será enviada al aprendiz junto con la notificación de aprobación.</small>
                    </div>
                    <div class="mb-3">
                        <label for="archivoAdjunto" class="form-label">Archivo adjunto (opcional):</label>
                        <input type="file"
                               class="form-control"
                               id="archivoAdjunto"
                               name="archivoAdjunto"
                               accept=".pdf,.doc,.docx,.xlsx,.jpg,.jpeg,.png,.zip">
                        <small class="text-muted">Puedes adjuntar un documento adicional (PDF, DOC, DOCX, XLSX), guía o recurso para el aprendiz (máx. 10MB).</small>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" 
                               type="checkbox" 
                               id="enviarEmailAprobacion" 
                               name="enviarEmailAprobacion" 
                               checked>
                        <label class="form-check-label" for="enviarEmailAprobacion">
                            Enviar notificación por correo electrónico
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="aprobarConRetroalimentacion()">Aprobar con Comentario</button>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
    let modalRetroalimentacion;
    let modalRetroalimentacionAprobacion;

    document.addEventListener('DOMContentLoaded', function() {
        const modalEl = document.getElementById('modalRetroalimentacion');
        if (modalEl) {
            modalRetroalimentacion = new bootstrap.Modal(modalEl);
        }
        
        const modalAprobacionEl = document.getElementById('modalRetroalimentacionAprobacion');
        if (modalAprobacionEl) {
            modalRetroalimentacionAprobacion = new bootstrap.Modal(modalAprobacionEl);
        }
    });

    function aprobarDocumento(idDocumento) {
        Swal.fire({
            title: '¿Aprobar documento?',
            text: "Puedes aprobar directamente o agregar una retroalimentación",
            icon: 'question',
            showCancelButton: true,
            showDenyButton: true,
            confirmButtonColor: '#28a745',
            denyButtonColor: '#17a2b8',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Aprobar sin comentario',
            denyButtonText: 'Aprobar con comentario',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                // Aprobar sin retroalimentación
                enviarAprobacion(idDocumento, null, false);
            } else if (result.isDenied) {
                // Mostrar modal para agregar retroalimentación
                mostrarModalAprobacion(idDocumento);
            }
        });
    }

    function mostrarModalAprobacion(idDocumento) {
        document.getElementById('documentoIdAprobacion').value = idDocumento;
        document.getElementById('retroalimentacionAprobacion').value = '';
        modalRetroalimentacionAprobacion.show();
    }

    function aprobarConRetroalimentacion() {
        const idDocumento = document.getElementById('documentoIdAprobacion').value;
        const retroalimentacion = document.getElementById('retroalimentacionAprobacion').value;
        const enviarEmail = document.getElementById('enviarEmailAprobacion').checked;
        const archivoInput = document.getElementById('archivoAdjunto');
        const archivo = archivoInput.files[0];

        if (!retroalimentacion.trim() && !archivo) {
            Swal.fire('Atención', 'Debes proporcionar una retroalimentación o adjuntar un archivo', 'warning');
            return;
        }

        // Validar archivo si existe
        if (archivo) {
            const maxSize = 10 * 1024 * 1024; // 10MB
            const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                        'image/jpeg', 'image/png', 'image/jpg', 'application/zip'];

            if (archivo.size > maxSize) {
                Swal.fire('Archivo demasiado grande', 'El archivo no puede superar los 10MB', 'error');
                return;
            }

            if (!allowedTypes.includes(archivo.type)) {
                Swal.fire('Tipo de archivo no permitido', 'Solo se permiten PDF, DOC, DOCX, XLSX, imágenes y archivos ZIP', 'error');
                return;
            }
        }

        modalRetroalimentacionAprobacion.hide();

        // Crear FormData para enviar archivo
        const formData = new FormData();
        formData.append('retroalimentacion', retroalimentacion);
        formData.append('enviarEmail', enviarEmail);
        if (archivo) {
            formData.append('archivoAdjunto', archivo);
        }

        enviarAprobacionConArchivo(idDocumento, formData);
    }

    function enviarAprobacion(idDocumento, retroalimentacion, enviarEmail) {
        const body = {};
        if (retroalimentacion) {
            body.retroalimentacion = retroalimentacion;
            body.enviarEmail = enviarEmail;
        }

        fetch(`/administrador/documentos/${idDocumento}/aprobar`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(body)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('¡Aprobado!', 'El documento ha sido aprobado', 'success')
                    .then(() => location.reload());
            } else {
                Swal.fire('Error', data.message || 'No se pudo aprobar el documento', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire('Error', 'Ocurrió un error al aprobar el documento', 'error');
        });
    }

    function enviarAprobacionConArchivo(idDocumento, formData) {
        fetch(`/administrador/documentos/${idDocumento}/aprobar`, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('¡Aprobado!', 'El documento ha sido aprobado', 'success')
                    .then(() => location.reload());
            } else {
                Swal.fire('Error', data.message || 'No se pudo aprobar el documento', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire('Error', 'Ocurrió un error al aprobar el documento', 'error');
        });
    }

    function mostrarModalRetroalimentacion(idDocumento, tipoDocumento) {
        document.getElementById('documentoId').value = idDocumento;
        document.getElementById('retroalimentacion').value = '';
        document.getElementById('tipoDocumentoTexto').textContent = tipoDocumento || 'este documento';
        modalRetroalimentacion.show();
    }

    function rechazarDocumento() {
        const idDocumento = document.getElementById('documentoId').value;
        const retroalimentacion = document.getElementById('retroalimentacion').value;
        const enviarEmail = document.getElementById('enviarEmail').checked;

        if (!retroalimentacion.trim()) {
            Swal.fire('Atención', 'Debes proporcionar una retroalimentación', 'warning');
            return;
        }

        fetch(`/administrador/documentos/${idDocumento}/rechazar`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                retroalimentacion: retroalimentacion,
                enviarEmail: enviarEmail
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                modalRetroalimentacion.hide();
                Swal.fire('¡Rechazado!', 'El aprendiz ha sido notificado', 'success')
                    .then(() => location.reload());
            } else {
                Swal.fire('Error', data.message || 'No se pudo rechazar el documento', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire('Error', 'Ocurrió un error al rechazar el documento', 'error');
        });
    }
</script>