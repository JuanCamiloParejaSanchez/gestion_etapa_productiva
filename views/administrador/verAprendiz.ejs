<!-- Ruta: vistas/administrador/verAprendiz.ejs -->
<!-- Propósito: Muestra los detalles completos de un aprendiz seleccionado en un formato legible.
     Permite visualizar toda la información registrada de un aprendiz específico. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<%- contentFor('styles') %>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>

<%- contentFor('body') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/listar-aprendices">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar
            </a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Detalles del Aprendiz</h2>
        </div>
        <div class="card-body">
            <% for (let key in aprendiz) { %>
                <% if (key !== 'id' && key !== 'password') { %>
                    <div class="mb-3">
                        <strong>
                        <% if (key === 'created_at') { %>
                            Fecha creación de usuario
                        <% } else if (key === 'updated_at') { %>
                            Fecha última actualización
                        <% } else { %>
                            <%= key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1').trim() %>
                        <% } %>
                        :</strong>
                        <% if (key.toLowerCase().includes('fecha') || key === 'created_at' || key === 'updated_at') { %>
                            <% if (key === 'updated_at') { %>
                                <%= new Date(aprendiz[key]).toLocaleString('es-ES', {
                                    weekday: 'long',
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    second: '2-digit'
                                }) + ' - Usuario: ' + (typeof userName !== 'undefined' ? userName : 'Administrador') %>
                            <% } else { %>
                                <%= new Date(aprendiz[key]).toLocaleString('es-ES', {
                                    weekday: 'long',
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    second: '2-digit'
                                }) %>
                            <% } %>
                        <% } else { %>
                            <%= aprendiz[key] %>
                        <% } %>
                    </div>
                <% } %>
            <% } %>
        </div>
        <div class="card-footer">
            <a href="/administrador/listar-aprendices" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>