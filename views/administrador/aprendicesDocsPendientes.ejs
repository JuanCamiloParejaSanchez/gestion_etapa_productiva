        // Función para exportar el modal a PDF - Versión Simplificada
        function exportarModalAPDF(aprendizInfo) {
            try {
                // Verificar que existe la librería html2pdf
                if (typeof html2pdf === 'undefined') {
                    throw new Error('La librería html2pdf no está disponible');
                }

                // Construir nombre completo del aprendiz
                const nombreCompleto = `${aprendizInfo.nombres} ${aprendizInfo.primerApellido} ${aprendizInfo.segundoApellido || ''}`.trim();
                const tipoYDocumento = `${aprendizInfo.tipoDocumento} - ${aprendizInfo.numeroDocumento}`;
                
                // Obtener contadores
                const contadorSubidos = document.getElementById('contadorSubidos');
                const contadorPendientes = document.getElementById('contadorPendientes');
                const numSubidos = contadorSubidos ? contadorSubidos.textContent : '0';
                const numPendientes = contadorPendientes ? contadorPendientes.textContent : '0';
                const totalDocs = parseInt(numSubidos) + parseInt(numPendientes);

                // Recopilar documentos subidos
                const documentosSubidos = [];
                const contenedorSubidos = document.getElementById('documentosSubidos');
                if (contenedorSubidos) {
                    const docsSubidos = contenedorSubidos.querySelectorAll('.documento-item');
                    docsSubidos.forEach(doc => {
                        const nombre = doc.querySelector('.documento-nombre')?.textContent?.trim() || 'Documento sin nombre';
                        const tipo = doc.querySelector('.documento-tipo')?.textContent?.trim() || 'N/A';
                        const fecha = doc.querySelector('.documento-fecha')?.textContent?.trim() || 'N/A';
                        const descripcion = doc.querySelector('.documento-descripcion')?.textContent?.trim() || '';
                        documentosSubidos.push({ nombre, tipo, descripcion, fecha, estado: 'SUBIDO' });
                    });
                }

                // Recopilar documentos pendientes
                const documentosPendientes = [];
                const contenedorPendientes = document.getElementById('documentosPendientes');
                if (contenedorPendientes) {
                    const docsPendientes = contenedorPendientes.querySelectorAll('.documento-item');
                    docsPendientes.forEach(doc => {
                        const nombre = doc.querySelector('.documento-nombre')?.textContent?.trim() || 'Documento sin nombre';
                        const tipo = doc.querySelector('.documento-tipo')?.textContent?.trim() || 'N/A';
                        documentosPendientes.push({ nombre, tipo, fecha: 'Pendiente', estado: 'PENDIENTE' });
                    });
                }

                // Generar fecha
                const fechaGeneracion = new Date().toLocaleDateString('es-ES', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                // Crear tabla de documentos
                let tablaDocumentos = '';
                const todosDocumentos = [...documentosSubidos, ...documentosPendientes];

                if (todosDocumentos.length > 0) {
                    tablaDocumentos = `
                        <table class="tabla-documentos">
