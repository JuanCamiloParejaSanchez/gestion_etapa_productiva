<!-- Propósito: Formulario principal para el registro de nuevos aprendices. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/components/forms.css">
<link rel="stylesheet" href="/estilos/components/tables.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<style>

    .validating {
        position: relative;
    }

    .validating::after {
        content: '';
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        border: 2px solid #007bff;
        border-top: 2px solid transparent;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: translateY(-50%) rotate(0deg); }
        100% { transform: translateY(-50%) rotate(360deg); }
    }

    .popup-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9998;
    }

    .popup-overlay.active {
        display: block;
    }

    .popup-info {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 9999;
        max-width: 90%;
        max-height: 80%;
        overflow-y: auto;
    }

    .popup-info.active {
        display: block;
    }

    /* Estilos para la foto de perfil */
    .profile-photo-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .profile-photo-preview {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #e0e0e0;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .profile-photo-preview:hover {
        border-color: #007bff;
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(0, 123, 255, 0.2);
    }

    .profile-photo-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .profile-photo-preview img.active {
        display: block;
    }

    .profile-photo-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 14px;
        text-align: center;
        padding: 20px;
    }

    .profile-photo-placeholder i {
        font-size: 48px;
        margin-bottom: 10px;
        opacity: 0.5;
    }

    .profile-photo-input {
        display: none;
    }
    
    .profile-photo-input.is-invalid + .profile-photo-label {
        border: 2px solid #dc3545;
        animation: shake 0.5s;
    }
    
    .profile-photo-input.is-valid + .profile-photo-label {
        border: 2px solid #28a745;
    }
    
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
        20%, 40%, 60%, 80% { transform: translateX(5px); }
    }

    .profile-photo-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 25px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .profile-photo-label:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    }

    .profile-photo-label i {
        font-size: 16px;
    }

    .profile-photo-remove {
        display: none;
        padding: 8px 16px;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 10px rgba(220, 53, 69, 0.3);
    }

    .profile-photo-remove:hover {
        background: #c82333;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.5);
    }

    .profile-photo-remove.active {
        display: inline-block;
    }

    .profile-photo-info {
        font-size: 12px;
        color: #6c757d;
        text-align: center;
        max-width: 200px;
    }

    @media (max-width: 768px) {
        .profile-photo-preview {
            width: 120px;
            height: 120px;
        }
    }
</style>

<%- contentFor('navigation') %>
<!-- Barra de navegación -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar
            </a>
        </div>
    </div>
</nav>

<%- contentFor('body') %>
<div class="container mt-4">
    <div class="row justify-content-center">
        <!-- Formulario principal -->
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="form-header mb-0">DATOS DEL APRENDIZ</h2>
                </div>
                <div class="card-body">
                    <div id="messageContainer" class="mb-3"></div>
                    
                    <!-- Formulario único con todos los campos -->
                    <form id="aprendizForm" action="/registrar-aprendiz" method="POST" enctype="multipart/form-data">
                        
                        <!-- Contenedor para foto de perfil y botón informativo -->
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <!-- Foto de perfil - Lado izquierdo -->
                            <div class="profile-photo-container">
                                <label class="form-label text-center w-100 mb-2">
                                    <strong>Foto de Perfil</strong>
                                    <span class="required">*</span>
                                </label>
                                <div class="profile-photo-preview" id="photoPreview">
                                    <img id="photoImage" src="" alt="Foto de perfil">
                                    <div class="profile-photo-placeholder">
                                        <i class="fas fa-user-circle"></i>
                                        <span>Foto de perfil</span>
                                    </div>
                                </div>
                                <input type="file" 
                                    class="profile-photo-input" 
                                    id="fotoPerfil" 
                                    name="fotoPerfil" 
                                    accept="image/jpeg,image/jpg,image/png"
                                    required>
                                <label for="fotoPerfil" class="profile-photo-label">
                                    <i class="fas fa-camera"></i>
                                    Seleccionar foto
                                </label>
                                <button type="button" class="profile-photo-remove" id="removePhoto">
                                    <i class="fas fa-times"></i> Eliminar foto
                                </button>
                                <small class="profile-photo-info">
                                    JPG, JPEG o PNG - Máximo 2MB<br>
                                    <span style="color: #dc3545; font-weight: 600;">* Campo obligatorio</span>
                                </small>
                            </div>
                            
                            <!-- Botón informativo - Lado derecho -->
                            <div class="text-end">
                                <button type="button" class="btn btn-outline-info btn-sm" id="btnInfo">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Alternativas de Etapa Productiva
                                </button>
                            </div>
                        </div>

                        <h3 class="form-subheader mt-4">Datos Personales</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="nombres" class="form-label">Nombres<span class="required">*</span></label>
                                <input type="text" class="form-control" id="nombres" name="nombres" required placeholder="Ej: JUAN CARLOS">
                                <small id="nombresHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="primerApellido" class="form-label">Primer apellido<span class="required">*</span></label>
                                <input type="text" class="form-control" id="primerApellido" name="primerApellido" required placeholder="Ej: PÉREZ">
                                <small id="primerApellidoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="segundoApellido" class="form-label">Segundo apellido</label>
                                <input type="text" class="form-control" id="segundoApellido" name="segundoApellido" placeholder="Ej: GÓMEZ">
                                <small id="segundoApellidoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="tipoDocumento" class="form-label">Tipo de documento<span class="required">*</span></label>
                                <select class="form-select" id="tipoDocumento" name="tipoDocumento" required>
                                    <option value="">SELECCIONE...</option>
                                    <% if (typeof opciones !== 'undefined' && opciones.tipoDocumento) { %>
                                        <% opciones.tipoDocumento.forEach(opcion => { %>
                                            <option value="<%= opcion.value %>"><%= opcion.label %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="genero" class="form-label">Género<span class="required">*</span></label>
                                <select class="form-select" id="genero" name="genero" required>
                                    <option value="">SELECCIONE...</option>
                                    <% if (typeof opciones !== 'undefined' && opciones.genero) { %>
                                        <% opciones.genero.forEach(opcion => { %>
                                            <option value="<%= opcion.value %>"><%= opcion.label %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="numeroDocumento" class="form-label">Número de documento<span class="required">*</span></label>
                                <input type="text" class="form-control" id="numeroDocumento" name="numeroDocumento" required placeholder="Ej: 1234567890" minlength="7" maxlength="10" pattern="\d{7,10}" title="Debe contener entre 7 y 10 dígitos">
                                <small id="numeroDocumentoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="fechaNacimiento" class="form-label">Fecha de nacimiento<span class="required">*</span></label>
                                <input type="date" class="form-control" id="fechaNacimiento" name="fechaNacimiento" required aria-label="Fecha de nacimiento">
                                <small id="fechaNacimientoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="eps" class="form-label">EPS<span class="required">*</span></label>
                                <select class="form-select" id="eps" name="eps" required>
                                    <option value="">SELECCIONE...</option>
                                    <% if (typeof opciones !== 'undefined' && opciones.eps) { %>
                                        <% opciones.eps.forEach(opcion => { %>
                                            <option value="<%= opcion.value %>"><%= opcion.label %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <h3 class="form-subheader mt-4">Datos de Ubicación</h3>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="telefonoFijo" class="form-label">Teléfono fijo</label>
                                <input type="tel" class="form-control" id="telefonoFijo" name="telefonoFijo" placeholder="Ej: 6012345678" minlength="10" maxlength="10" pattern="\d{10}" title="Debe contener exactamente 10 dígitos">
                                <small id="telefonoFijoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="celular" class="form-label">Celular<span class="required">*</span></label>
                                <input type="tel" class="form-control" id="celular" name="celular" required placeholder="Ej: 3001234567" minlength="10" maxlength="10" pattern="\d{10}" title="Debe contener exactamente 10 dígitos">
                                <small id="celularHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="direccion" class="form-label">Dirección de residencia<span class="required">*</span></label>
                                <input type="text" class="form-control" id="direccion" name="direccion" required placeholder="Ej: CRA 10 #20-30">
                                <small id="direccionHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="barrio" class="form-label">Barrio<span class="required">*</span></label>
                                <input type="text" class="form-control" id="barrio" name="barrio" required placeholder="Ej: CENTRO">
                                <small id="barrioHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="departamento" class="form-label">Departamento<span class="required">*</span></label>
                                <select class="form-select" id="departamento" name="departamento" required>
                                    <option value="">SELECCIONE...</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label for="municipio" class="form-label">Municipio<span class="required">*</span></label>
                                <select class="form-select" id="municipio" name="municipio" required>
                                    <option value="">SELECCIONE UN MUNICIPIO...</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label for="correoElectronico" class="form-label">Correo electrónico<span class="required">*</span></label>
                                <input type="email" class="form-control" id="correoElectronico" name="correoElectronico" required placeholder="Ej: ejemplo@correo.com">
                                <small id="correoElectronicoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                        </div>

                        <h3 class="form-subheader mt-4">Datos de la Formación</h3>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="fechaInicioLectiva" class="form-label">Fecha inicio etapa lectiva<span class="required">*</span></label>
                                <input type="date" class="form-control" id="fechaInicioLectiva" name="fechaInicioLectiva" required aria-label="Fecha inicio etapa lectiva">
                                <small id="fechaInicioLectivaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="fechaFinLectiva" class="form-label">Fecha fin etapa lectiva<span class="required">*</span></label>
                                <input type="date" class="form-control" id="fechaFinLectiva" name="fechaFinLectiva" required aria-label="Fecha fin etapa lectiva">
                                <small id="fechaFinLectivaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="instructorLectiva" class="form-label">Instructor/a responsable etapa lectiva<span class="required">*</span></label>
                                <input type="text" class="form-control" id="instructorLectiva" name="instructorLectiva" required placeholder="Ej: MARÍA GONZÁLEZ">
                                <small id="instructorLectivaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="instructorProductiva" class="form-label">Instructor/a responsable etapa productiva<span class="required">*</span></label>
                                <select class="form-select" id="instructorProductiva" name="instructorProductiva" required>
                                    <option value="">SELECCIONE UN INSTRUCTOR...</option>
                                    <!-- Opciones se cargarán dinámicamente -->
                                </select>
                                <small id="instructorProductivaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="numeroFicha" class="form-label">Número de ficha o grupo<span class="required">*</span></label>
                                <input type="text" class="form-control" id="numeroFicha" name="numeroFicha" required placeholder="Ej: 1234567">
                                <small id="numeroFichaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-9">
                                <label for="programaFormacion" class="form-label">Programa de formación<span class="required">*</span></label>
                                <select class="form-select" id="programaFormacion" name="programaFormacion" required>
                                    <option value="">SELECCIONE...</option>
                                    <% if (typeof opciones !== 'undefined' && opciones.programaFormacion) { %>
                                        <% opciones.programaFormacion.forEach(opcion => { %>
                                            <option value="<%= opcion.value %>"><%= opcion.label %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <h3 class="form-subheader mt-4">Datos de la Alternativa de Etapa Productiva</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="alternativaSeleccionada" class="form-label">Alternativa seleccionada<span class="required">*</span></label>
                                <select class="form-select" id="alternativaSeleccionada" name="alternativaSeleccionada" required>
                                    <option value="">SELECCIONE...</option>
                                    <% if (typeof opciones !== 'undefined' && opciones.alternativaSeleccionada) { %>
                                        <% opciones.alternativaSeleccionada.forEach(opcion => { %>
                                            <option value="<%= opcion.value %>"><%= opcion.label %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label for="documentoSoporte" class="form-label">Documento de soporte<span class="required">*</span></label>
                                <input type="file" class="form-control" id="documentoSoporte" name="documentoSoporte" accept=".pdf,.xls,.xlsx" required>
                                <small class="form-text text-muted">
                                    Formatos permitidos: PDF o Excel (XLS, XLSX) - Máximo 5MB
                                </small>
                                <small id="documentoSoporteHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-2">
                                <label for="areaFormacion" class="form-label">¿En el área de formación?<span class="required">*</span></label>
                                <select class="form-select" id="areaFormacion" name="areaFormacion" required>
                                    <% if (typeof opciones !== 'undefined' && opciones.areaFormacion) { %>
                                        <% opciones.areaFormacion.forEach(opcion => { %>
                                            <option value="<%= opcion.value %>"><%= opcion.label %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="fechaInicioProductiva" class="form-label">Fecha inicio etapa productiva<span class="required">*</span></label>
                                <input type="date" class="form-control" id="fechaInicioProductiva" name="fechaInicioProductiva" required>
                                <small id="fechaInicioProductivaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-3">
                                <label for="fechaFinProductiva" class="form-label">Fecha fin etapa productiva<span class="required">*</span></label>
                                <input type="date" class="form-control" id="fechaFinProductiva" name="fechaFinProductiva" required>
                                <small id="fechaFinProductivaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="empresaPatrocinadora" class="form-label">Empresa patrocinadora<span class="required">*</span></label>
                                <input type="text" class="form-control" id="empresaPatrocinadora" name="empresaPatrocinadora" required placeholder="Ej: EMPRESA ABC S.A.S">
                                <small id="empresaPatrocinadoraHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="areaPractica" class="form-label">Área donde realiza la práctica<span class="required">*</span></label>
                                <input type="text" class="form-control" id="areaPractica" name="areaPractica" required placeholder="Ej: DESARROLLO DE SOFTWARE">
                                <small id="areaPracticaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="jefeInmediato" class="form-label">Nombre del jefe inmediato<span class="required">*</span></label>
                                <input type="text" class="form-control" id="jefeInmediato" name="jefeInmediato" required placeholder="Ej: ANA MARTÍNEZ">
                                <small id="jefeInmediatoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="telefonoEmpresa" class="form-label">Teléfono fijo</label>
                                <input type="tel" class="form-control" id="telefonoEmpresa" name="telefonoEmpresa" placeholder="Ej: 6012345678" minlength="10" maxlength="10" pattern="\d{10}" title="Debe contener exactamente 10 dígitos">
                                <small id="telefonoEmpresaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="celularEmpresa" class="form-label">Celular<span class="required">*</span></label>
                                <input type="tel" class="form-control" id="celularEmpresa" name="celularEmpresa" required placeholder="Ej: 3001234567" minlength="10" maxlength="10" pattern="\d{10}" title="Debe contener exactamente 10 dígitos">
                                <small id="celularEmpresaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="direccionEmpresa" class="form-label">Dirección de la empresa<span class="required">*</span></label>
                                <input type="text" class="form-control" id="direccionEmpresa" name="direccionEmpresa" required placeholder="Ej: CRA 15 #25-30">
                                <small id="direccionEmpresaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="correoEmpresa" class="form-label">Correo de la empresa<span class="required">*</span></label>
                                <input type="email" class="form-control" id="correoEmpresa" name="correoEmpresa" required placeholder="Ej: contacto@empresa.com">
                                <small id="correoEmpresaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-4">
                                <label for="horario" class="form-label">Horario<span class="required">*</span></label>
                                <input type="text" class="form-control" id="horario" name="horario" required placeholder="Ej: L a V 8:00am a 5:00pm">
                                <small id="horarioHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary mt-4">Enviar</button>
                        <p class="mt-3" style="font-size:var(--font-size-sm);"><span class="required">*</span> Campos obligatorios</p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Popup Informativo -->
