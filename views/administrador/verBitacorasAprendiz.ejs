<%- contentFor('body') %>
<!-- Encabezado -->
<div class="container-fluid mt-4">
    <h2 class="mb-4">Bitácoras del Aprendiz</h2>
    <div class="card mb-4">
        <div class="card-header bg-primary">
            <h5 class="mb-0 text-white">Información del Aprendiz</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Nombre:</strong> <%= aprendiz.nombres %> <%= aprendiz.primerApellido %> <%= aprendiz.segundoApellido %></p>
                    <p><strong>Documento:</strong> <%= aprendiz.tipoDocumento %>: <%= aprendiz.numeroDocumento %></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Programa:</strong> <%= aprendiz.programaFormacion %></p>
                    <p><strong>Ficha:</strong> <%= aprendiz.numeroFicha %></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Análisis de Sentimientos -->
    <% if (erroresAnalisis && erroresAnalisis.length > 0) { %>
        <div class="alert alert-warning mb-4">
            <h5 class="mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Advertencias en el Análisis</h5>
            <ul class="mb-0">
                <% erroresAnalisis.forEach(error => { %>
                    <li>
                        <% if (error.bitacoraId) { %>
                            Error en bitácora #<%= error.bitacoraId %>: <%= error.error %>
                        <% } else { %>
                            <%= error.error %>
                            <% if (error.detalles) { %>
                                - <%= error.detalles %>
                            <% } %>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        </div>
    <% } %>

    <!-- Modal de Alertas -->
    <div class="modal fade" id="alertaCompromiso" tabindex="-1" aria-labelledby="alertaCompromisoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="alertaCompromisoLabel">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        Estado del Aprendiz
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="estadoAprendiz"></div>
                    <div class="mt-3">
                        <h6 class="mb-2">Acciones Recomendadas:</h6>
                        <ul id="accionesRecomendadas" class="list-group">
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <% if (analisisSentimientos && analisisSentimientos.sentimientoGeneral) { %>
        <!-- Dashboard Simplificado y Centrado en lo Esencial -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-gradient-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Estado del Aprendiz</h5>
                    </div>
                    <div class="card-body">
                        <!-- Indicador Principal Simplificado -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <%
                                let estadoClase = 'secondary';
                                let estadoIcono = '😐';
                                let estadoMensaje = 'Sin datos suficientes';
                                let estadoAccion = 'Continuar monitoreando';

                                const score = analisisSentimientos.scorePromedio || 0;
                                const compromiso = analisisSentimientos.nivelCompromiso || 0;
                                const tendencia = analisisSentimientos.tendencia || 'sin_datos';

                                if (score >= 2 && compromiso >= 70) {
                                    estadoClase = 'success';
                                    estadoIcono = '😊';
                                    estadoMensaje = 'Estado Excelente';
                                    estadoAccion = 'Mantener el buen trabajo';
                                } else if (score >= 0.5 && compromiso >= 50) {
                                    estadoClase = 'info';
                                    estadoIcono = '🙂';
                                    estadoMensaje = 'Estado Bueno';
                                    estadoAccion = 'Seguimiento regular';
                                } else if (score >= -1 && compromiso >= 30) {
                                    estadoClase = 'warning';
                                    estadoIcono = '😐';
                                    estadoMensaje = 'Requiere Atención';
                                    estadoAccion = 'Programar reunión';
                                } else {
                                    estadoClase = 'danger';
                                    estadoIcono = '😟';
                                    estadoMensaje = 'Estado Crítico';
                                    estadoAccion = 'Acción inmediata';
                                }
                                %>
                                <div class="estado-principal bg-<%= estadoClase %> text-white p-4 rounded-circle d-inline-block mb-3" style="width: 120px; height: 120px; font-size: var(--font-size-4xl); box-shadow: 0 4px 8px rgba(0,0,0,0.2);">
                                    <%= estadoIcono %>
                                </div>
                                <h4 class="text-<%= estadoClase %> fw-bold mb-2"><%= estadoMensaje %></h4>
                                <p class="lead mb-4"><%= estadoAccion %></p>
                            </div>
                        </div>

                        <!-- Indicadores Clave Simplificados -->
                        <div class="row text-center mb-4">
                            <div class="col-md-4">
                                <div class="metrica-card p-3 border rounded">
                                    <i class="fas fa-heart fa-2x text-<%= estadoClase %> mb-2"></i>
                                    <h6 class="fw-bold">Estado Emocional</h6>
                                    <span class="badge bg-<%= estadoClase %> fs-6">
                                        <%= analisisSentimientos.sentimientoGeneral.replace('_', ' ') %>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="metrica-card p-3 border rounded">
                                    <%
                                    let tendenciaIcono = 'fa-minus';
                                    let tendenciaColor = 'secondary';
                                    if (tendencia === 'mejorando') {
                                        tendenciaIcono = 'fa-arrow-up';
                                        tendenciaColor = 'success';
                                    } else if (tendencia === 'empeorando') {
                                        tendenciaIcono = 'fa-arrow-down';
                                        tendenciaColor = 'danger';
                                    }
                                    %>
                                    <i class="fas <%= tendenciaIcono %> fa-2x text-<%= tendenciaColor %> mb-2"></i>
                                    <h6 class="fw-bold">Tendencia</h6>
                                    <span class="badge bg-<%= tendenciaColor %> fs-6">
                                        <% if (tendencia === 'mejorando') { %>Mejorando<% } else if (tendencia === 'empeorando') { %>Empeorando<% } else { %>Estable<% } %>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="metrica-card p-3 border rounded">
                                    <%
                                    let compromisoIcono = 'fa-battery-half';
                                    let compromisoColor = 'warning';
                                    if (compromiso >= 70) {
                                        compromisoIcono = 'fa-battery-full';
                                        compromisoColor = 'success';
                                    } else if (compromiso < 40) {
                                        compromisoIcono = 'fa-battery-empty';
                                        compromisoColor = 'danger';
                                    }
                                    %>
                                    <i class="fas <%= compromisoIcono %> fa-2x text-<%= compromisoColor %> mb-2"></i>
                                    <h6 class="fw-bold">Compromiso</h6>
                                    <span class="badge bg-<%= compromisoColor %> fs-6"><%= Math.round(compromiso) %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Gráfico de Evolución de Métricas -->
                        <% if (analisisSentimientos && analisisSentimientos.analisisDetallado && Array.isArray(analisisSentimientos.analisisDetallado) && analisisSentimientos.analisisDetallado.length > 1) { %>
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="fas fa-chart-line me-2"></i>Evolución de Estado Emocional y Compromiso</h6>
                                    </div>
                                    <div class="card-body">
                                        <div style="height: 200px;">
                                            <canvas id="metricasChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>

                        <!-- Acciones Recomendadas Simplificadas -->
                        <%
                        let accionesRecomendadas = [];
                        if (score < -1) {
                            accionesRecomendadas.push({
                                icono: 'fas fa-user-friends',
                                texto: 'Programar reunión personal con el aprendiz',
                                prioridad: 'danger'
                            });
                        }
                        if (compromiso < 50) {
                            accionesRecomendadas.push({
                                icono: 'fas fa-tasks',
                                texto: 'Revisar carga de trabajo y motivación',
                                prioridad: 'warning'
                            });
                        }
                        if (tendencia === 'empeorando') {
                            accionesRecomendadas.push({
                                icono: 'fas fa-search',
                                texto: 'Identificar factores de estrés',
                                prioridad: 'warning'
                            });
                        }
                        if (score >= 2 && compromiso >= 70) {
                            accionesRecomendadas.push({
                                icono: 'fas fa-star',
                                texto: 'Reconocer buen desempeño',
                                prioridad: 'success'
                            });
                        }
                        if (accionesRecomendadas.length === 0) {
                            accionesRecomendadas.push({
                                icono: 'fas fa-check-circle',
                                texto: 'Mantener seguimiento regular',
                                prioridad: 'info'
                            });
                        }
                        %>

                        <% if (accionesRecomendadas.length > 0) { %>
                        <div class="acciones-recomendadas bg-light p-3 rounded mb-3">
                            <h6 class="fw-bold mb-3"><i class="fas fa-clipboard-check me-2"></i>Acciones Recomendadas</h6>
                            <div class="row">
                                <% accionesRecomendadas.forEach((accion, index) => { %>
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-center">
                                        <%
                                        let colorClass = '';
                                        let colorStyle = '';
                                        if (accion.prioridad === 'danger') {
                                            colorClass = 'text-danger';
                                            colorStyle = 'color: #dc3545 !important;';
                                        } else if (accion.prioridad === 'warning') {
                                            colorClass = 'text-warning';
                                            colorStyle = 'color: #ffc107 !important;';
                                        } else if (accion.prioridad === 'success') {
                                            colorClass = 'text-success';
                                            colorStyle = 'color: #28a745 !important;';
                                        } else if (accion.prioridad === 'info') {
                                            colorClass = 'text-info';
                                            colorStyle = 'color: #17a2b8 !important;';
                                        }
                                        %>
                                        <i class="<%= accion.icono %> <%= colorClass %> me-2" style="<%= colorStyle %>"></i>
                                        <small class="flex-grow-1 <%= colorClass %>"><%= accion.texto %></small>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                        <% } %>

                    </div>
                </div>
            </div>
        </div>

    <% } else { %>
        <% if (!bitacoras || bitacoras.length === 0) { %>
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>Este aprendiz no tiene bitácoras registradas.
            </div>
        <% } else if (bitacoras && bitacoras.length > 0) { %>
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>El análisis de sentimientos no está disponible en este momento. Las bitácoras se muestran sin análisis.
            </div>
        <% } %>
    <% } %>

    <!-- Lista de Bitácoras -->
    <% /* Comentada la restricción de 15 días para pruebas */ %>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 text-white"><i class="fas fa-list me-2 text-white"></i>Bitácoras Registradas</h5>
                </div>
                <div class="card-body">
                    <div class="accordion" id="bitacorasAccordion">
                        <% bitacoras.forEach(function(b, idx) { %>
                            <div class="accordion-item mb-2">
                                <h2 class="accordion-header" id="heading-<%= b.id %>">
                                    <button class="accordion-button <%= idx !== 0 ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= b.id %>" aria-expanded="<%= idx === 0 ? 'true' : 'false' %>" aria-controls="collapse-<%= b.id %>">
                                        <strong>Bitácora del <%= new Date(b.fechaCreacion).toLocaleDateString() %></strong>
                                        <% if (b.sentimiento_general && b.sentimiento_general !== 'neutral') { %>
                                            &nbsp;| Estado: <span class="badge bg-<%= b.sentimiento_general === 'positivo' || b.sentimiento_general === 'muy_positivo' ? 'success' : (b.sentimiento_general === 'negativo' || b.sentimiento_general === 'muy_negativo' ? 'danger' : 'warning') %>"><%= b.sentimiento_general.replace('_', ' ') %></span>
                                        <% } %>
                                    </button>
                                </h2>
                                <div id="collapse-<%= b.id %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>" aria-labelledby="heading-<%= b.id %>" data-bs-parent="#bitacorasAccordion">
                                    <div class="accordion-body">
                                        <div class="card shadow-sm mb-3 border-primary">
                                            <div class="card-body">
                                                <h5 class="card-title mb-3 text-primary"><i class="fas fa-user-edit me-2"></i>Respuestas del Aprendiz</h5>
                                                <div class="row">
                                                    <div class="col-md-4 mb-2">
                                                        <strong>Desafío:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.respuesta_desafio %></p>
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <strong>Logro:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.respuesta_logro %></p>
                                                    </div>
                                                    <div class="col-md-4 mb-2">
                                                        <strong>Comunicación:</strong>
                                                        <p class="bg-light rounded p-2"><%= b.respuesta_comunicacion %></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script src="/js/utilidades/themeToggle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Gráfico de evolución de métricas
        if (document.getElementById('metricasChart')) {
            const analisisData = <%- JSON.stringify(analisisSentimientos ? analisisSentimientos.analisisDetallado || [] : []) %>;

            if (analisisData && analisisData.length > 1) {
                // Preparar datos para el gráfico
                const labels = analisisData.map((item, index) => `Bitácora ${index + 1}`);
                const estadoEmocional = analisisData.map(item => item.scorePromedio || 0);
                const compromiso = analisisData.map(item => item.nivelCompromiso || 0);

                // Crear gráfico de líneas
                const ctx = document.getElementById('metricasChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Estado Emocional',
                            data: estadoEmocional,
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.1)',
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgb(75, 192, 192)',
                            yAxisID: 'y'
                        }, {
                            label: 'Compromiso (%)',
                            data: compromiso,
                            borderColor: 'rgb(255, 99, 132)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgb(255, 99, 132)',
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Estado Emocional (-5 a 5)'
                                },
                                min: -5,
                                max: 5,
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Compromiso (%)'
                                },
                                min: 0,
                                max: 100,
                                grid: {
                                    drawOnChartArea: false,
                                },
                            }
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) {
                                            label += ': ';
                                        }
                                        if (context.datasetIndex === 0) {
                                            // Estado emocional
                                            label += context.parsed.y.toFixed(1);
                                        } else {
                                            // Compromiso
                                            label += context.parsed.y + '%';
                                        }
                                        return label;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }
    });
</script>
