<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script type="module" src="/js/formValidation.js"></script>
<script src="/js/utilidades/utils.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', async function() {

        // Función para mostrar mensajes de error/éxito
        function mostrarMensaje(mensaje, tipo = 'danger') {
            const messageContainer = document.getElementById('messageContainer');
            messageContainer.innerHTML = `
                <div class="alert alert-${tipo} alert-dismissible fade show" role="alert">
                    <i class="fas ${tipo === 'danger' ? 'fa-exclamation-circle' : tipo === 'success' ? 'fa-check-circle' : 'fa-info-circle'}"></i>
                    ${mensaje}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            // Auto-ocultar después de 10 segundos para mensajes de error
            if (tipo === 'danger') {
                setTimeout(() => {
                    const alert = messageContainer.querySelector('.alert');
                    if (alert) alert.remove();
                }, 10000);
            }
        }

        // Función para validar duplicados en tiempo real
        async function validarDuplicados(campo, valor) {
            if (!valor || valor.trim() === '') return;
            
            try {
                const response = await fetch('/verificar-duplicado', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        campo: campo,
                        valor: campo === 'correoElectronico' ? valor.toLowerCase() : valor.toUpperCase()
                    })
                });

                const data = await response.json();
                
                const mensaje = campo === 'correoElectronico'
                    ? 'Este correo electrónico ya está registrado'
                    : 'Este número de documento ya está registrado';

                if (data.existe) {
                    const fieldElement = document.getElementById(campo);
                    fieldElement.classList.add('is-invalid');
                    fieldElement.classList.remove('is-valid');
                    const helpElement = document.getElementById(campo + 'Help');
                    if (helpElement) {
                        helpElement.style.display = 'block';
                        helpElement.textContent = mensaje;
                        helpElement.classList.add('text-danger');
                        helpElement.classList.remove('text-success');
                    }
                    return false;
                } else {
                    const fieldElement = document.getElementById(campo);
                    fieldElement.classList.remove('is-invalid');
                    fieldElement.classList.add('is-valid');
                    const helpElement = document.getElementById(campo + 'Help');
                    if (helpElement) {
                        helpElement.style.display = 'none';
                        helpElement.textContent = '';
                        helpElement.classList.remove('text-danger', 'text-success');
                    }
                    return true;
                }
            } catch (error) {
                console.error('Error validando duplicados:', error);
                return true; // En caso de error, permitir continuar
            }
        }

        // Debounce function para evitar demasiadas peticiones
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Validación en tiempo real para correo electrónico
        const correoInput = document.getElementById('correoElectronico');
        if (correoInput) {
            const validarCorreoDebounced = debounce(async (event) => {
                const valor = event.target.value.trim();
                if (valor && valor.includes('@')) {
                    await validarDuplicados('correoElectronico', valor);
                }
            }, 1000);

            correoInput.addEventListener('blur', validarCorreoDebounced);
            correoInput.addEventListener('input', function() {
                this.classList.remove('is-invalid', 'is-valid');
                const helpElement = document.getElementById('correoElectronicoHelp');
                if (helpElement) helpElement.style.display = 'none';
            });
        }

        // Validación en tiempo real para número de documento
        const documentoInput = document.getElementById('numeroDocumento');
        if (documentoInput) {
            const validarDocumentoDebounced = debounce(async (event) => {
                const valor = event.target.value.trim();
                
                // Primero validar longitud y formato
                if (valor) {
                    const helpElement = document.getElementById('numeroDocumentoHelp');
                    
                    if (valor.length < 7) {
                        documentoInput.classList.add('is-invalid');
                        documentoInput.classList.remove('is-valid');
                        if (helpElement) {
                            helpElement.style.display = 'block';
                            helpElement.textContent = 'El número de documento debe tener entre 7 y 10 dígitos';
                            helpElement.classList.add('text-danger');
                        }
                        return;
                    }
                    
                    if (valor.length > 10) {
                        documentoInput.classList.add('is-invalid');
                        documentoInput.classList.remove('is-valid');
                        if (helpElement) {
                            helpElement.style.display = 'block';
                            helpElement.textContent = 'El número de documento no puede tener más de 10 dígitos';
                            helpElement.classList.add('text-danger');
                        }
                        return;
                    }
                    
                    if (!/^\d{7,10}$/.test(valor)) {
                        documentoInput.classList.add('is-invalid');
                        documentoInput.classList.remove('is-valid');
                        if (helpElement) {
                            helpElement.style.display = 'block';
                            helpElement.textContent = 'El número de documento solo debe contener dígitos';
                            helpElement.classList.add('text-danger');
                        }
                        return;
                    }
                    
                    // Si pasa las validaciones de formato, verificar duplicados
                    if (valor.length >= 7 && valor.length <= 10) {
                        await validarDuplicados('numeroDocumento', valor);
                    }
                }
            }, 1000);

            documentoInput.addEventListener('blur', validarDocumentoDebounced);
            documentoInput.addEventListener('input', function() {
                this.classList.remove('is-invalid', 'is-valid');
                const helpElement = document.getElementById('numeroDocumentoHelp');
                if (helpElement) helpElement.style.display = 'none';
            });
        }

        // Interceptar el envío del formulario para validar duplicados
        const form = document.getElementById('aprendizForm');
        if (form) {
            // El formulario será manejado por formValidation.js
            console.log('Formulario encontrado, será manejado por formValidation.js');
            
            // Configurar manejo del modal de éxito
            const modal = document.getElementById('modalRegistroExitoso');
            const btnContinuar = document.getElementById('btnContinuarCrearPassword');
            
            if (modal && btnContinuar) {
                console.log('Modal de registro exitoso encontrado');
                
                // Escuchar cuando se muestre el modal
                modal.addEventListener('shown.bs.modal', function () {
                    console.log('Modal mostrado exitosamente');
                    btnContinuar.focus();
                });
                
                // Configurar el botón de continuar
                btnContinuar.addEventListener('click', function(e) {
                    console.log('Botón continuar clickeado');
                    e.preventDefault();
                    
                    // Cerrar el modal y redirigir
                    const bootstrapModal = bootstrap.Modal.getInstance(modal);
                    if (bootstrapModal) {
                        bootstrapModal.hide();
                    }
                    
                    setTimeout(() => {
                        console.log('Redirigiendo a crear contraseña...');
                        window.location.href = '/crear-contrasena';
                    }, 300);
                });
            } else {
                console.warn('Modal o botón de continuar no encontrado');
            }
        }

        // Manejo del popup
        const setupPopup = () => {
            const btnInfo = document.getElementById('btnInfo');
            const popupInfo = document.getElementById('popupInfo');
            const popupOverlay = document.getElementById('popupOverlay');
            const btnCerrarPopup = document.getElementById('btnCerrarPopup');
            const linkAlternativas = document.querySelector('.link-alternativas');

            if (btnInfo) {
                btnInfo.addEventListener('click', () => {
                    popupInfo.classList.add('active');
                    popupOverlay.classList.add('active');
                });
            }

            if (btnCerrarPopup) {
                btnCerrarPopup.addEventListener('click', () => {
                    popupInfo.classList.remove('active');
                    popupOverlay.classList.remove('active');
                });
            }

            if (popupOverlay) {
                popupOverlay.addEventListener('click', () => {
                    popupInfo.classList.remove('active');
                    popupOverlay.classList.remove('active');
                });
            }

            if (linkAlternativas) {
                linkAlternativas.addEventListener('click', () => {
                    popupInfo.classList.remove('active');
                    popupOverlay.classList.remove('active');
                    window.open('/imagenes/pdf/alternativas/alternativas-etapa-productiva.pdf', '_blank');
                });
            }
        };

        // Cargar datos de ubicación
        const cargarDatosUbicacion = async () => {
            try {
                console.log('Iniciando carga de datos...');
                const response = await fetch('/data/colombia.json');

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                console.log('Datos cargados:', data);

                const departamentoSelect = document.getElementById('departamento');
                const municipioSelect = document.getElementById('municipio');

                if (!departamentoSelect || !municipioSelect) {
                    console.error('Selectores no encontrados');
                    return;
                }

                // Cargar departamentos
                departamentoSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                data.forEach(item => {
                    if (item && item.departamento) {
                        const option = document.createElement('option');
                        option.value = item.departamento;
                        option.textContent = item.departamento.toUpperCase(); // Mostrar en mayúsculas
                        departamentoSelect.appendChild(option);
                    }
                });

                // Evento change para departamentos
                departamentoSelect.addEventListener('change', function() {
                    const selectedDep = this.value;
                    console.log('Departamento seleccionado:', selectedDep);

                    municipioSelect.innerHTML = '<option value="">SELECCIONE UN MUNICIPIO...</option>';
                    if (!selectedDep) return;

                    const departamento = data.find(d => d.departamento === selectedDep);
                    if (departamento?.ciudades) {
                        departamento.ciudades.forEach(ciudad => {
                            const option = document.createElement('option');
                            option.value = ciudad;
                            option.textContent = ciudad.toUpperCase(); // Mostrar en mayúsculas
                            municipioSelect.appendChild(option);
                        });
                    }
                });
            } catch (error) {
                console.error('Error cargando datos:', error);
            }
        };

        // Cargar datos estáticos que no estén ya cargados
        const cargarDatosEstaticos = () => {
            // Verificar que los selectores de tipo documento y EPS tengan opciones
            const tipoDocSelect = document.getElementById('tipoDocumento');
            const epsSelect = document.getElementById('eps');
            
            if (tipoDocSelect && tipoDocSelect.options.length <= 1) {
                console.log('Cargando opciones de tipo documento...');
                const opciones = [
                    { value: 'CC', text: 'CÉDULA DE CIUDADANÍA' },
                    { value: 'TI', text: 'TARJETA DE IDENTIDAD' },
                    { value: 'CE', text: 'CÉDULA DE EXTRANJERÍA' },
                    { value: 'PEP', text: 'PEP' },
                    { value: 'PPT', text: 'PERMISO DE PROTECCIÓN TEMPORAL' }
                ];
                
                opciones.forEach(opcion => {
                    const option = document.createElement('option');
                    option.value = opcion.value;
                    option.textContent = opcion.text;
                    tipoDocSelect.appendChild(option);
                });
            }
            
            // Establecer valor por defecto para areaFormacion si no está seleccionado
            const areaFormacionSelect = document.getElementById('areaFormacion');
            if (areaFormacionSelect && !areaFormacionSelect.value) {
                areaFormacionSelect.selectedIndex = 1; // Seleccionar "SÍ" por defecto
            }
        };

        // Inicializar
        setupPopup();
        cargarDatosEstaticos();
        await cargarDatosUbicacion();

        // Cargar lista de administradores para instructor productiva
        const cargarAdministradores = async () => {
            try {
                const response = await fetch('/api/administradores');
                const data = await response.json();

                if (data.success) {
                    const select = document.getElementById('instructorProductiva');
                    data.administradores.forEach(admin => {
                        const option = document.createElement('option');
                        option.value = admin.nombreCompleto;
                        option.textContent = admin.nombreCompleto;
                        select.appendChild(option);
                    });
                } else {
                    console.error('Error al cargar administradores:', data.message);
                }
            } catch (error) {
                console.error('Error al cargar administradores:', error);
            }
        };

        await cargarAdministradores();

        // Normalizar inputs y selects a mayúsculas en frontend (EXCEPTO EMAIL)
        const upperCaseInputs = document.querySelectorAll('input[type="text"], input[type="tel"]');
        upperCaseInputs.forEach(input => {
            input.style.textTransform = 'uppercase';
            input.addEventListener('input', function() {
                this.value = this.value.toUpperCase();
            });
        });

        // Manejar email por separado (convertir a minúsculas)
        const emailInput = document.querySelector('input[type="email"]');
        if (emailInput) {
            emailInput.style.textTransform = 'lowercase';
            emailInput.addEventListener('input', function() {
                this.value = this.value.toLowerCase();
            });
        }

        // Normalizar selects a mayúsculas visualmente
        const selects = document.querySelectorAll('select');
        selects.forEach(select => {
            select.style.textTransform = 'uppercase';
        });

        // Restringir entrada en campos de texto (solo letras, espacios y caracteres especiales), excepto dirección y horario
        const textInputs = document.querySelectorAll('input[type="text"]:not([name="numeroDocumento"]):not([name="numeroFicha"]):not([name="direccion"]):not([name="direccionEmpresa"]):not([name="horario"])');
        textInputs.forEach(input => {
            input.addEventListener('input', function() {
                this.value = this.value.replace(/[^a-zA-Z\sáéíóúÁÉÍÓÚñÑ]/g, '');
            });
        });

        // Restringir entrada en campos numéricos (solo dígitos)
        const numberInputs = document.querySelectorAll('input[type="tel"], input[name="numeroDocumento"], input[name="numeroFicha"]');
        numberInputs.forEach(input => {
            input.addEventListener('input', function() {
                this.value = this.value.replace(/\D/g, '');
            });
        });

        // Validación del archivo de soporte
        const documentoSoporteInput = document.getElementById('documentoSoporte');
        if (documentoSoporteInput) {
            documentoSoporteInput.addEventListener('change', function() {
                const file = this.files[0];
                const helpElement = document.getElementById('documentoSoporteHelp');
                
                if (file) {
                    // Validar tamaño (5MB máximo)
                    const maxSize = 5 * 1024 * 1024; // 5MB en bytes
                    if (file.size > maxSize) {
                        this.classList.add('is-invalid');
                        this.classList.remove('is-valid');
                        if (helpElement) {
                            helpElement.style.display = 'block';
                            helpElement.textContent = 'El archivo no puede superar los 5MB';
                        }
                        this.value = ''; // Limpiar el input
                        return;
                    }
                    
                    // Validar formato
                    const allowedExtensions = ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png'];
                    const fileExtension = file.name.split('.').pop().toLowerCase();
                    
                    if (!allowedExtensions.includes(fileExtension)) {
                        this.classList.add('is-invalid');
                        this.classList.remove('is-valid');
                        if (helpElement) {
                            helpElement.style.display = 'block';
                            helpElement.textContent = 'Formato no permitido. Use: PDF, DOC, DOCX, JPG o PNG';
                        }
                        this.value = ''; // Limpiar el input
                        return;
                    }
                    
                    // Si todo está bien
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    if (helpElement) {
                        helpElement.style.display = 'none';
                    }
                }
            });
        }

        // ========== MANEJO DE FOTO DE PERFIL ==========
        const fotoPerfilInput = document.getElementById('fotoPerfil');
        const photoPreview = document.getElementById('photoPreview');
        const photoImage = document.getElementById('photoImage');
        const removePhotoBtn = document.getElementById('removePhoto');
        const photoPlaceholder = photoPreview?.querySelector('.profile-photo-placeholder');

        if (fotoPerfilInput && photoPreview && photoImage) {
            // Cuando se selecciona una foto
            fotoPerfilInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                
                if (file) {
                    // Validar tipo de archivo
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
                    if (!validTypes.includes(file.type)) {
                        mostrarMensaje('Por favor selecciona una imagen válida (JPG, JPEG o PNG)', 'warning');
                        this.value = '';
                        this.classList.add('is-invalid');
                        return;
                    }
                    
                    // Validar tamaño (2MB máximo)
                    const maxSize = 2 * 1024 * 1024; // 2MB en bytes
                    if (file.size > maxSize) {
                        mostrarMensaje('La imagen no debe superar los 2MB', 'warning');
                        this.value = '';
                        this.classList.add('is-invalid');
                        return;
                    }
                    
                    // Marcar como válido
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    
                    // Mostrar preview
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        photoImage.src = e.target.result;
                        photoImage.classList.add('active');
                        if (photoPlaceholder) {
                            photoPlaceholder.style.display = 'none';
                        }
                        if (removePhotoBtn) {
                            removePhotoBtn.classList.add('active');
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Cuando se elimina la foto
            if (removePhotoBtn) {
                removePhotoBtn.addEventListener('click', function() {
                    fotoPerfilInput.value = '';
                    fotoPerfilInput.classList.remove('is-valid');
                    photoImage.src = '';
                    photoImage.classList.remove('active');
                    if (photoPlaceholder) {
                        photoPlaceholder.style.display = 'flex';
                    }
                    removePhotoBtn.classList.remove('active');
                });
            }
            
            // Validación antes de enviar el formulario
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (!fotoPerfilInput.files || fotoPerfilInput.files.length === 0) {
                        e.preventDefault();
                        mostrarMensaje('La foto de perfil es obligatoria. Por favor selecciona una imagen.', 'danger');
                        fotoPerfilInput.classList.add('is-invalid');
                        
                        // Scroll hacia la foto de perfil
                        photoPreview.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return false;
                    }
                });
            }
        }
    });
</script>