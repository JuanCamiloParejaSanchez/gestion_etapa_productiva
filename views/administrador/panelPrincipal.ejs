<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<style>
    /* Estilos para el modal de chat */
    #modalChat .modal-dialog {
        max-width: 600px;
    }

    @media (max-width: 768px) {
        #modalChat .modal-dialog {
            max-width: 95%;
            margin: 1rem auto;
        }
    }

    .chat-messages {
        max-height: 400px;
        overflow-y: auto;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .dark-mode .chat-messages {
        background-color: #1e1e1e;
        color: #e6edf3;
    }

    .chat-message {
        margin-bottom: 1rem;
        padding: 0.75rem;
        border-radius: 8px;
        max-width: 80%;
        word-wrap: break-word;
    }

    .chat-message.sent {
        background-color: #007bff;
        color: white;
        margin-left: auto;
        text-align: right;
    }

    .chat-message.received {
        background-color: #e9ecef;
        color: #333;
    }

    .dark-mode .chat-message.received {
        background-color: #2d3748;
        color: #e6edf3;
    }

    .chat-message .sender {
        font-weight: bold;
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
    }

    .chat-message .timestamp {
        font-size: 0.75rem;
        opacity: 0.7;
        margin-top: 0.25rem;
    }

    .chat-input-area {
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .chat-input {
        flex: 1;
        border-radius: 20px;
        padding: 0.5rem 1rem;
        border: 1px solid #ced4da;
        resize: none;
        min-height: 38px;
        max-height: 100px;
    }

    .dark-mode .chat-input {
        background-color: #2d3748;
        border-color: #475569;
        color: #e6edf3 !important;
    }

    .chat-input:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
    }

    .dark-mode .chat-input:focus {
        border-color: #58a6ff;
        box-shadow: 0 0 0 0.2rem rgba(88, 166, 255, 0.25);
    }

    .btn-send-chat {
        border-radius: 50%;
        width: 38px;
        height: 38px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chat-empty {
        text-align: center;
        padding: 2rem;
        color: #6c757d;
    }

    .dark-mode .chat-empty {
        color: #8b949e;
    }

    .bg-success-chat {
        background-color: #39a900 !important;
    }

    html.dark-mode #modalChat .modal-header.bg-success-chat {
        background-color: #2d7d00 !important;
    }

    .dark-mode .modal-footer {
        background-color: #21262d;
        border-color: #30363d;
    }

    .dark-mode .text-muted,
    .dark-mode small.text-muted {
        color: #8b949e !important;
    }

    /* Variante de éxito para notificaciones */
    .success-popup-overlay {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        animation: slideInRight 0.3s ease-out forwards;
    }

    @keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes slideOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }

    .success-popup {
        background: white;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        border-left: 4px solid #28a745;
    }

    .dark-mode .success-popup {
        background: #161b22;
        border-left-color: #4caf50;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .success-popup-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4edda 0%, #28a745 100%);
        color: #155724;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .dark-mode .success-popup-icon {
        background: linear-gradient(135deg, #0f3d1a 0%, #28a745 100%);
        color: #4caf50;
    }

    .success-popup-content {
        flex: 1;
    }

    .success-popup-title {
        font-weight: 600;
        color: #155724;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
    }

    .dark-mode .success-popup-title {
        color: #4caf50;
    }

    .success-popup-message {
        color: #666;
        font-size: 0.9rem;
        margin: 0;
    }

    .dark-mode .success-popup-message {
        color: #8b949e;
    }
</style>

