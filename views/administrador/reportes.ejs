<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<%- contentFor('body') %>
<div class="container-fluid mt-4">
    <h1 class="display-6">Reportes y Estadísticas</h1>
    <hr class="my-4">

    <!-- KPIs Generales -->
    <div class="row mb-4">
        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="kpi-card">
                <div class="kpi-value"><%= estadisticasGenerales.total_aprendices %></div>
                <div class="kpi-label">Total Aprendices</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="kpi-card">
                <div class="kpi-value"><%= estadisticasGenerales.activos %></div>
                <div class="kpi-label">Aprendices Activos</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="kpi-card">
                <div class="kpi-value"><%= estadisticasGenerales.inactivos %></div>
                <div class="kpi-label">Aprendices Inactivos</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="kpi-card">
                <div class="kpi-value"><%= estadisticasGenerales.aplazados %></div>
                <div class="kpi-label">Aprendices Aplazados</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
            <div class="kpi-card">
                <div class="kpi-value"><%= estadisticasGenerales.retirados %></div>
                <div class="kpi-label">Aprendices Retirados</div>
            </div>
        </div>
    </div>

    <!-- Botones de Exportación -->
    <div class="export-buttons">
        <button class="export-btn btn-png" onclick="exportarGrafico('programasChart', 'programas')">📊 Programas</button>
        <button class="export-btn btn-png" onclick="exportarGrafico('estadosChart', 'estados')">📈 Estados</button>
        <button class="export-btn btn-png" onclick="exportarGrafico('alternativasChart', 'alternativas')">🥧 Alternativas</button>
        <button class="export-btn btn-png" onclick="exportarGrafico('documentosChart', 'documentos')">📄 Documentos</button>
        <button class="export-btn btn-png" onclick="exportarGrafico('seguimientoChart', 'seguimiento')">📝 Seguimiento</button>
        <button class="export-btn btn-pdf" onclick="exportarTodosPDF()">📄 Todo (PDF)</button>
    </div>

    <div class="row">
        <!-- Gráfico 1: Aprendices por Programa -->
        <div class="col-lg-7 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Aprendices por Programa de Formación
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="programasChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico 2: Aprendices por Estado -->
        <div class="col-lg-5 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Estado General de Aprendices
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="estadosChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Nueva Fila para el Gráfico de Alternativas -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Aprendices por Alternativa de Etapa Productiva
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="alternativasChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nueva Fila para Gráficos Adicionales -->
    <div class="row">
        <!-- Gráfico 4: Cumplimiento de Documentos -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Cumplimiento de Gestión Documental
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="documentosChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico 5: Cumplimiento de Seguimiento -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Cumplimiento de Seguimiento Etapa Productiva
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="seguimientoChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nueva Fila para Gráfico de Departamentos -->
    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Distribución Geográfica - Top 10 Departamentos
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="departamentosChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- GRÁFICO 1: PROGRAMAS (Gráfico de Barras) ---
        try {
            const datosProgramas = JSON.parse('<%- datosProgramas %>');
            const ctxProgramas = document.getElementById('programasChart').getContext('2d');
            new Chart(ctxProgramas, {
                type: 'bar',
                data: {
                    labels: datosProgramas.labels,
                    datasets: [{
                        label: 'Aprendices',
                        data: datosProgramas.data,
                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: { 
                    responsive: true, 
                    maintainAspectRatio: false, 
                    scales: { y: { beginAtZero: true } }, 
                    plugins: { legend: { display: false } } 
                }
            });
        } catch (e) { 
            console.error("Error al renderizar gráfico de programas:", e); 
            document.getElementById('programasChart').innerHTML = '<p class="text-center text-muted">Error al cargar el gráfico</p>';
        }

        // --- GRÁFICO 2: ESTADOS (Gráfico de Dona) ---
        try {
            const datosEstados = JSON.parse('<%- datosEstados %>');
            const ctxEstados = document.getElementById('estadosChart').getContext('2d');
            new Chart(ctxEstados, {
                type: 'doughnut',
                data: {
                    labels: datosEstados.labels,
                    datasets: [{
                        label: 'Estado de Aprendices',
                        data: datosEstados.data,
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)'
                        ],
                        hoverOffset: 4
                    }]
                },
                options: { 
                    responsive: true, 
                    maintainAspectRatio: false, 
                    plugins: { legend: { position: 'top' } } 
                }
            });
        } catch (e) { 
            console.error("Error al renderizar gráfico de estados:", e); 
            document.getElementById('estadosChart').innerHTML = '<p class="text-center text-muted">Error al cargar el gráfico</p>';
        }
        
        // --- GRÁFICO 3: ALTERNATIVAS (Gráfico de Torta) ---
        try {
            const datosAlternativas = JSON.parse('<%- datosAlternativas %>');
            const ctxAlternativas = document.getElementById('alternativasChart').getContext('2d');
            new Chart(ctxAlternativas, {
                type: 'pie',
                data: {
                    labels: datosAlternativas.labels,
                    datasets: [{
                        label: 'Alternativas de Etapa Productiva',
                        data: datosAlternativas.data,
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)'
                        ],
                        hoverOffset: 4
                    }]
                },
                options: { 
                    responsive: true, 
                    maintainAspectRatio: false, 
                    plugins: { legend: { position: 'top' } } 
                }
            });
        } catch (e) {
            console.error("Error al renderizar gráfico de alternativas:", e);
            document.getElementById('alternativasChart').innerHTML = '<p class="text-center text-muted">Error al cargar el gráfico</p>';
        }

        // --- GRÁFICO 4: DOCUMENTOS (Gráfico de Dona) ---
        try {
            const datosDocumentos = JSON.parse('<%- datosDocumentos %>');
            const ctxDocumentos = document.getElementById('documentosChart').getContext('2d');
            new Chart(ctxDocumentos, {
                type: 'doughnut',
                data: {
                    labels: datosDocumentos.labels,
                    datasets: [{
                        label: 'Aprendices',
                        data: datosDocumentos.data,
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.7)', // Verde para "Al día"
                            'rgba(255, 99, 132, 0.7)'  // Rojo para "Pendiente"
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 2,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        } catch (e) {
            console.error("Error al renderizar gráfico de documentos:", e);
            document.getElementById('documentosChart').innerHTML = '<p class="text-center text-muted">Error al cargar el gráfico</p>';
        }

        // --- GRÁFICO 5: SEGUIMIENTO (Gráfico de Dona) ---
        try {
            const datosSeguimiento = JSON.parse('<%- datosSeguimiento %>');
            const ctxSeguimiento = document.getElementById('seguimientoChart').getContext('2d');
            new Chart(ctxSeguimiento, {
                type: 'doughnut',
                data: {
                    labels: datosSeguimiento.labels,
                    datasets: [{
                        label: 'Aprendices',
                        data: datosSeguimiento.data,
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.7)', // Verde para "Al día"
                            'rgba(255, 99, 132, 0.7)'  // Rojo para "Pendiente"
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 2,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        } catch (e) {
            console.error("Error al renderizar gráfico de seguimiento:", e);
            document.getElementById('seguimientoChart').innerHTML = '<p class="text-center text-muted">Error al cargar el gráfico</p>';
        }

        // --- GRÁFICO 6: DEPARTAMENTOS (Gráfico de Barras) ---
        try {
            const datosDepartamentos = JSON.parse('<%- datosDepartamentos %>');
            const ctxDepartamentos = document.getElementById('departamentosChart').getContext('2d');
            new Chart(ctxDepartamentos, {
                type: 'bar',
                data: {
                    labels: datosDepartamentos.labels,
                    datasets: [{
                        label: 'Aprendices',
                        data: datosDepartamentos.data,
                        backgroundColor: 'rgba(153, 102, 255, 0.7)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        } catch (e) {
            console.error("Error al renderizar gráfico de departamentos:", e);
            document.getElementById('departamentosChart').innerHTML = '<p class="text-center text-muted">Error al cargar el gráfico</p>';
        }
    });

    // --- FUNCIONES DE EXPORTACIÓN ---

    // Función para exportar gráfico individual como PNG
    function exportarGrafico(chartId, nombreArchivo) {
        const canvas = document.getElementById(chartId);
        if (!canvas) {
            alert('Gráfico no encontrado');
            return;
        }

        // Crear enlace de descarga
        const link = document.createElement('a');
        link.download = `reporte_${nombreArchivo}_${new Date().toISOString().split('T')[0]}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
    }

    // Función para exportar todos los gráficos como PDF
    async function exportarTodosPDF() {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF('p', 'mm', 'a4');

        const chartIds = ['programasChart', 'estadosChart', 'alternativasChart', 'documentosChart', 'seguimientoChart', 'departamentosChart'];
        const titulos = [
            'Aprendices por Programa',
            'Estado General de Aprendices',
            'Alternativas de Etapa Productiva',
            'Cumplimiento de Gestión Documental',
            'Cumplimiento de Seguimiento Etapa Productiva',
            'Distribución Geográfica - Top Departamentos'
        ];

        try {
            for (let i = 0; i < chartIds.length; i++) {
                const canvas = document.getElementById(chartIds[i]);
                if (canvas) {
                    const imgData = canvas.toDataURL('image/png');

                    if (i > 0) pdf.addPage();

                    // Agregar título
                    pdf.setFontSize(16);
                    pdf.text(titulos[i], 20, 20);

                    // Agregar imagen del gráfico
                    const imgWidth = 170;
                    const imgHeight = 100;
                    pdf.addImage(imgData, 'PNG', 20, 30, imgWidth, imgHeight);
                }
            }

            // Agregar KPIs al final
            pdf.addPage();
            pdf.setFontSize(18);
            pdf.text('Resumen de KPIs', 20, 20);

            pdf.setFontSize(12);
            const estadisticas = JSON.parse('<%- JSON.stringify(estadisticasGenerales) %>');
            pdf.text(`Total de Aprendices: ${estadisticas.total_aprendices}`, 20, 40);
            pdf.text(`Aprendices Activos: ${estadisticas.activos}`, 20, 50);
            pdf.text(`Aprendices Inactivos: ${estadisticas.inactivos}`, 20, 60);
            pdf.text(`Aprendices Aplazados: ${estadisticas.aplazados}`, 20, 70);
            pdf.text(`Aprendices Retirados: ${estadisticas.retirados}`, 20, 80);

            pdf.save(`reporte_completo_${new Date().toISOString().split('T')[0]}.pdf`);
        } catch (error) {
            console.error('Error al exportar PDF:', error);
            alert('Error al generar el PDF. Intente nuevamente.');
        }
    }

    // Función para mostrar/ocultar tooltips mejorados
    function mejorarTooltips() {
        const charts = ['programasChart', 'estadosChart', 'alternativasChart', 'documentosChart', 'seguimientoChart', 'departamentosChart'];

        charts.forEach(chartId => {
            const chart = Chart.getChart(chartId);
            if (chart) {
                chart.options.plugins.tooltip = {
                    ...chart.options.plugins.tooltip,
                    callbacks: {
                        label: function(context) {
                            const label = context.label || '';
                            const value = context.parsed.y || context.parsed;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                            return `${label}: ${value} (${percentage}%)`;
                        }
                    }
                };
                chart.update();
            }
        });
    }

    // Mejorar tooltips después de que se carguen los gráficos
    setTimeout(mejorarTooltips, 1000);
</script>
