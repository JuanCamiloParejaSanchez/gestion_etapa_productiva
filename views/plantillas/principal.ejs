<!-- Ruta: views/plantillas/principal.ejs -->
<!-- Propósito: Layout principal que define la estructura base de todas las páginas del sistema -->

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <!-- CSP manejada por el servidor con Helmet -->

        <!-- Script inline para aplicar tema oscuro inmediatamente y evitar flash -->
        <script>
            (function() {
                const savedTheme = localStorage.getItem('sena-theme-preference');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                    document.documentElement.classList.add('dark-mode');
                }
            })();
        </script>

        <title><%= typeof title !== 'undefined' ? title : 'Gestión de Etapa Productiva - SENA' %></title>
        <link rel="icon" href="/imagenes/logos/sena-logo.svg" type="image/x-icon">

        <!-- Google Fonts - Inter -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;600;700;800;900&display=swap&v=1.1" rel="stylesheet">

        <!-- Bootstrap y Font Awesome -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        
        <!-- DataTables CSS -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
        <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">

        <!-- Estilos base y específicos de la página -->
        <link rel="stylesheet" href="/estilos/base/reset.css?v=1.3">
        <link rel="stylesheet" href="/estilos/base/variables.css?v=1.3">
        <link rel="stylesheet" href="/estilos/base/typography.css?v=1.3">
        <link rel="stylesheet" href="/estilos/base/layout.css?v=1.3">
        <link rel="stylesheet" href="/estilos/components/navbar.css?v=1.3">
        <link rel="stylesheet" href="/estilos/components/buttons.css?v=1.3">
        <link rel="stylesheet" href="/estilos/components/forms.css?v=1.3">
        <link rel="stylesheet" href="/estilos/components/tables.css?v=1.3">
        <link rel="stylesheet" href="/estilos/general/estilosBase.css?v=1.3">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.12.0/dist/sweetalert2.min.css">
        <%- defineContent('styles') %>
    </head>
    <body>

        <%- include('../compartido/encabezadoAdmin') %>

        <!-- Slot para la barra de navegación -->
        <%- defineContent('navigation') %>

        <main class="app-main">
            <%- body %>
        </main>

        <!-- Footer SENA -->
        <footer class="sena-footer mt-auto">
            <div class="footer-content">
                <div class="logo-container">
                    <!-- Los logos se repiten 6 veces según el diseño original -->
                    <% for(let i = 0; i < 6; i++) { %>
                        <img src="/imagenes/logos/sena-logo.svg" alt="Logo SENA" class="footer-logo">
                    <% } %>
                </div>
                <div class="footer-text">
                    <p>Servicio Nacional de Aprendizaje SENA - Centro de Servicios de Salud - Regional Antioquia</p>
                    <p>Dirección: Calle 51 N. 57 - 70 Torre Sur Piso 9o</p>
                    <p>El SENA brinda a la ciudadanía, atención presencial en las 33 Regionales y 117 Centros de Formación</p>
                    <p>Línea de atención al ciudadano, empresario y línea PQRS: Bogotá: +(57) 601 7366060</p>
                    <p>Línea gratuita y resto del País: 018000 910270</p>
                </div>
            </div>
        </footer>

        <!-- Scripts globales -->
        <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        
        <!-- DataTables y Extensiones -->
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

        <!-- Scripts específicos por vista -->
        <%- defineContent('scripts') %>

        <!-- Script para verificar carga de fuente Inter -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                console.log('🔤 Verificando carga de fuente Inter...');

                // Verificar si la fuente Inter está disponible
                if (document.fonts) {
                    document.fonts.ready.then(function() {
                        const interFonts = Array.from(document.fonts).filter(font => font.family.includes('Inter'));
                        console.log('🔤 Fuentes Inter encontradas:', interFonts.length);

                        if (interFonts.length > 0) {
                            console.log('✅ Fuente Inter cargada correctamente');
                        } else {
                            console.log('❌ Fuente Inter NO encontrada en document.fonts');
                        }
                    }).catch(function(error) {
                        console.log('⚠️ Error al verificar fuentes:', error);
                    });
                } else {
                    console.log('⚠️ API document.fonts no disponible');
                }

                // Verificar carga después de un tiempo
                setTimeout(function() {
                    const computedFont = window.getComputedStyle(document.body).fontFamily;
                    console.log('🔤 Font-family aplicada en body (delayed):', computedFont);

                    if (computedFont.includes('Inter')) {
                        console.log('✅ Inter aplicada en body (delayed check)');
                    } else {
                        console.log('❌ Inter NO aplicada en body (delayed check), usando:', computedFont);
                    }
                }, 2000);

                // Verificar aplicación en body
                const computedFont = window.getComputedStyle(document.body).fontFamily;
                console.log('🔤 Font-family aplicada en body:', computedFont);

                if (computedFont.includes('Inter')) {
                    console.log('✅ Inter aplicada en body');
                } else {
                    console.log('❌ Inter NO aplicada en body, usando:', computedFont);
                }
            });
        </script>
        <!-- Script para el tema oscuro (disponible en todas las páginas) -->
        <script src="/js/utilidades/themeToggle.js?v=1.1"></script>

        <!-- Datos globales -->
        <script>
            window.appData = {
                user: <%- JSON.stringify(locals.user || null).replace(/</g, '\u003c') %>,
                userRole: <%- JSON.stringify(locals.userRole || null).replace(/</g, '\u003c') %>
            };
        </script>
    </body>
</html>
