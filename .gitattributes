# Asegurar que los archivos de script usen LF en todos los sistemas
*.sh text eol=lf
*.bash text eol=lf

# Archivos de configuración
.deployment text eol=lf
.nvmrc text eol=lf

# Archivos de código
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
