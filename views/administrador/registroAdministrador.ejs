<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/components/forms.css">
<link rel="stylesheet" href="/estilos/components/tables.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<style>
    .is-valid {
        border-color: #28a745 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='m2.3 6.73.8.78 4.05-4.05-.78-.78L3.09 5.9z'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right calc(0.375em + 0.1875rem) center !important;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem) !important;
    }

    .is-invalid {
        border-color: #dc3545 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 4.6 2.4 2.4m-2.4 0 2.4-2.4'/%3e%3c/svg%3e") !important;
        background-repeat: no-repeat !important;
        background-position: right calc(0.375em + 0.1875rem) center !important;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem) !important;
    }

    .form-text.text-danger {
        display: none;
        margin-top: 0.25rem;
        font-size: 0.875em;
        color: #dc3545 !important;
    }
</style>

<%- contentFor('navigation') %>
<!-- Barra de navegación -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar
            </a>
        </div>
    </div>
</nav>

<%- contentFor('body') %>
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="form-header mb-0">REGISTRO DE ADMINISTRADOR</h2>
                </div>
                <div class="card-body">
                    <div id="messageContainer" class="mb-3"></div>
                    <form id="adminForm" action="/registrar-administrador" method="POST">
                        <h3 class="form-subheader mt-4">Datos Personales</h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="nombreCompleto" class="form-label">Nombre completo <span class="required">*</span></label>
                                <input type="text" class="form-control" id="nombreCompleto" name="nombreCompleto" required placeholder="Ej: JUAN CARLOS PÉREZ GÓMEZ">
                                <small id="nombreCompletoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="correoInstitucional" class="form-label">Correo institucional <span class="required">*</span></label>
                                <input type="email" class="form-control" id="correoInstitucional" name="correoInstitucional" required placeholder="Ej: juan.perez@sena.edu.co">
                                <small id="correoInstitucionalHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="numeroIdentificacion" class="form-label">Número de identificación <span class="required">*</span></label>
                                <input type="text" class="form-control" id="numeroIdentificacion" name="numeroIdentificacion" required placeholder="Ej: 1234567890">
                                <small id="numeroIdentificacionHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="telefono" class="form-label">Teléfono de contacto <span class="required">*</span></label>
                                <input type="tel" class="form-control" id="telefono" name="telefono" required placeholder="Ej: 3001234567" minlength="10" maxlength="10" pattern="\d{10}" title="Debe contener exactamente 10 dígitos">
                                <small id="telefonoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="departamento" class="form-label">Departamento o área <span class="required">*</span></label>
                                <input type="text" class="form-control" id="departamento" name="departamento" required placeholder="Ej: TECNOLOGÍA DE LA INFORMACIÓN">
                                <small id="departamentoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="cargo" class="form-label">Cargo o rol <span class="required">*</span></label>
                                <input type="text" class="form-control" id="cargo" name="cargo" required placeholder="Ej: COORDINADOR ACADÉMICO">
                                <small id="cargoHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                        </div>
                        <h3 class="form-subheader mt-4">Credenciales de Acceso</h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="contrasena" class="form-label">Contraseña <span class="required">*</span></label>
                                <input type="password" class="form-control" id="contrasena" name="contrasena" required placeholder="Mínimo 12 caracteres, mayúscula, minúscula, número y símbolo">
                                <small id="contrasenaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                            <div class="col-md-6">
                                <label for="confirmarContrasena" class="form-label">Confirmar contraseña <span class="required">*</span></label>
                                <input type="password" class="form-control" id="confirmarContrasena" name="confirmarContrasena" required placeholder="Repita la contraseña">
                                <small id="confirmarContrasenaHelp" class="form-text text-danger" style="display:none;"></small>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-4">Registrar Administrador</button>
                        <p class="mt-3" style="font-size:var(--font-size-sm);"><span class="required">*</span> Campos obligatorios</p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Registro Exitoso -->
<div class="modal fade" id="modalRegistroExitosoAdmin" tabindex="-1" aria-labelledby="modalRegistroExitosoAdminLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalRegistroExitosoAdminLabel">
                    <i class="fas fa-check-circle me-2"></i>
                    ¡Registro Exitoso!
                </h5>
            </div>
            <div class="modal-body text-center p-4">
                <div class="mb-4">
                    <svg class="text-success" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h4 class="mb-3">¡Administrador registrado correctamente!</h4>
                <p class="mb-4">
                    El registro del administrador ha sido procesado exitosamente.
                    Ahora puedes proceder a la selección de rol.
                </p>
                <div class="alert alert-info">
                    <small>
                        <strong>Siguiente paso:</strong> Seleccionar el rol para continuar
                    </small>
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-primary btn-lg" id="btnContinuarSeleccionRol">
                    <i class="fas fa-user-check me-2"></i>
                    Ir a Selección de Rol
                </button>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script type="module" src="/js/adminFormValidation.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para validar duplicados en tiempo real
    async function validarDuplicados(campo, valor) {
        if (!valor || valor.trim() === '') return;

        try {
            const response = await fetch('/verificar-duplicado', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    campo: campo,
                    valor: campo === 'correoInstitucional' ? valor.toLowerCase() : valor.toUpperCase()
                })
            });

            const data = await response.json();

            const mensaje = campo === 'correoInstitucional'
                ? 'Este correo electrónico ya está registrado'
                : 'Este número de documento ya está registrado';

            if (data.existe) {
                const fieldElement = document.getElementById(campo);
                fieldElement.classList.add('is-invalid');
                fieldElement.classList.remove('is-valid');
                const helpElement = document.getElementById(campo + 'Help');
                if (helpElement) {
                    helpElement.style.display = 'block';
                    helpElement.textContent = mensaje;
                    helpElement.classList.add('text-danger');
                    helpElement.classList.remove('text-success');
                }
                return false;
            } else {
                const fieldElement = document.getElementById(campo);
                fieldElement.classList.remove('is-invalid');
                fieldElement.classList.add('is-valid');
                const helpElement = document.getElementById(campo + 'Help');
                if (helpElement) {
                    helpElement.style.display = 'none';
                    helpElement.textContent = '';
                    helpElement.classList.remove('text-danger', 'text-success');
                }
                return true;
            }
        } catch (error) {
            console.error('Error validando duplicados:', error);
            return true; // En caso de error, permitir continuar
        }
    }

    // Debounce function para evitar demasiadas peticiones
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    // Validación en tiempo real para correo institucional
    const correoInput = document.getElementById('correoInstitucional');
    if (correoInput) {
        const validarCorreoDebounced = debounce(async (event) => {
            const valor = event.target.value.trim();
            if (valor && valor.includes('@')) {
                await validarDuplicados('correoInstitucional', valor);
            }
        }, 1000);

        correoInput.addEventListener('blur', validarCorreoDebounced);
        correoInput.addEventListener('input', function() {
            this.classList.remove('is-invalid', 'is-valid');
            const helpElement = document.getElementById('correoInstitucionalHelp');
            if (helpElement) helpElement.style.display = 'none';
        });
    }

    // Validación en tiempo real para número de identificación
    const documentoInput = document.getElementById('numeroIdentificacion');
    if (documentoInput) {
        const validarDocumentoDebounced = debounce(async (event) => {
            const valor = event.target.value.trim();
            if (valor && valor.length >= 7) {
                await validarDuplicados('numeroIdentificacion', valor);
            }
        }, 1000);

        documentoInput.addEventListener('blur', validarDocumentoDebounced);
        documentoInput.addEventListener('input', function() {
            this.classList.remove('is-invalid', 'is-valid');
            const helpElement = document.getElementById('numeroIdentificacionHelp');
            if (helpElement) helpElement.style.display = 'none';
        });
    }

    // Normalizar inputs a mayúsculas en frontend (EXCEPTO EMAIL)
    const upperCaseInputs = document.querySelectorAll('input[type="text"], input[type="tel"]');
    upperCaseInputs.forEach(input => {
        input.style.textTransform = 'uppercase';
        input.addEventListener('input', function() {
            this.value = this.value.toUpperCase();
        });
    });

    // Manejar email por separado (convertir a minúsculas)
    const emailInput = document.querySelector('input[type="email"]');
    if (emailInput) {
        emailInput.style.textTransform = 'lowercase';
        emailInput.addEventListener('input', function() {
            this.value = this.value.toLowerCase();
        });
    }

    // Restringir entrada en campos de texto (solo letras, espacios y caracteres especiales)
    const textInputs = document.querySelectorAll('input[type="text"]:not([name="numeroIdentificacion"])');
    textInputs.forEach(input => {
        input.addEventListener('input', function() {
            this.value = this.value.replace(/[^a-zA-Z\sáéíóúÁÉÍÓÚñÑ]/g, '');
        });
    });

    // Restringir entrada en campos numéricos (solo dígitos)
    const numberInputs = document.querySelectorAll('input[type="tel"], input[name="numeroIdentificacion"]');
    numberInputs.forEach(input => {
        input.addEventListener('input', function() {
            this.value = this.value.replace(/\D/g, '');
        });
    });

    // Configurar manejo del modal de éxito
    const modalAdmin = document.getElementById('modalRegistroExitosoAdmin');
    const btnContinuar = document.getElementById('btnContinuarSeleccionRol');

    if (modalAdmin && btnContinuar) {
        console.log('Modal de registro exitoso de administrador encontrado');

        // Escuchar cuando se muestre el modal
        modalAdmin.addEventListener('shown.bs.modal', function () {
            console.log('Modal de administrador mostrado exitosamente');
            btnContinuar.focus();
        });

        // Configurar el botón de continuar
        btnContinuar.addEventListener('click', function(e) {
            console.log('Botón continuar clickeado');
            e.preventDefault();

            // Cerrar el modal y redirigir
            const bootstrapModal = bootstrap.Modal.getInstance(modalAdmin);
            if (bootstrapModal) {
                bootstrapModal.hide();
            }

            setTimeout(() => {
                console.log('Redirigiendo a selección de rol...');
                window.location.href = '/';
            }, 300);
        });
    } else {
        console.warn('Modal o botón de continuar no encontrado');
    }
});
</script>
