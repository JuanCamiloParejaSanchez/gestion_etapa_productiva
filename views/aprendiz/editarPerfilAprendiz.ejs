<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/components/forms.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<style>
    /* Estilos específicos para editar perfil de aprendiz */
    .edit-profile-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    .edit-header {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        border-radius: 10px 10px 0 0;
        padding: 1.5rem;
        text-align: center;
    }
    .form-section {
        border-left: 4px solid #007bff;
        background: #f8f9fa;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 0 8px 8px 0;
    }
    .section-title {
        color: #007bff;
        font-weight: 600;
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }
    .btn-save-profile {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s;
    }
    .btn-save-profile:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40,167,69,0.3);
    }
    .btn-cancel {
        border: 2px solid #6c757d;
        border-radius: 25px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        color: #6c757d;
        background: transparent;
        transition: all 0.3s;
    }
    .btn-cancel:hover {
        background: #6c757d;
        color: white;
        transform: translateY(-2px);
    }

    /* Estilos para modo oscuro */
    html.dark-mode .edit-profile-card {
        background-color: #1e293b;
        color: #f1f5f9;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    html.dark-mode .edit-header {
        background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
    }

    html.dark-mode .form-section {
        background: #334155;
        border-left-color: #60a5fa;
    }

    html.dark-mode .section-title {
        color: #60a5fa;
    }
</style>

<%- contentFor('body') %>

<!-- Barra de navegación -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <div class="d-flex">
            <a href="/aprendiz/perfil" class="btn btn-primary btn-navbar">
