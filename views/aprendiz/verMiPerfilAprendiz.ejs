<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<style>
html.dark-mode .fas.fa-edit {
    color: #ffffff;
}

html.dark-mode .btn-primary {
    color: #ffffff !important;
}

html.dark-mode .btn-primary:hover {
    color: #ffffff !important;
    background-color: #0b5ed7 !important;
    border-color: #0b5ed7 !important;
}

/* Estilos para la foto de perfil */
.profile-photo-section {
    display: flex;
    justify-content: center;
    margin-bottom: 30px;
    padding: 20px;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border-radius: 15px;
}

html.dark-mode .profile-photo-section {
    background: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);
}

.profile-photo-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
}

.profile-photo-display {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 5px solid #007bff;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 25px rgba(0, 123, 255, 0.3);
    transition: all 0.3s ease;
}

.profile-photo-display:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 35px rgba(0, 123, 255, 0.5);
}

.profile-photo-display img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-photo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-align: center;
    padding: 20px;
}

.profile-photo-placeholder i {
    font-size: 60px;
    margin-bottom: 10px;
    opacity: 0.7;
}

.profile-photo-placeholder span {
    font-size: 14px;
    font-weight: 500;
}

@media (max-width: 768px) {
    .profile-photo-display {
        width: 140px;
        height: 140px;
    }
    
    .profile-photo-placeholder i {
        font-size: 48px;
    }
}
</style>

<%
// Función auxiliar para formatear fechas correctamente (sin problemas de zona horaria)
function formatearFechaLocal(fecha) {
    if (!fecha) return 'N/A';
    
    // Si es string, parsearlo como fecha local
    let date;
    if (typeof fecha === 'string') {
        const [year, month, day] = fecha.split('T')[0].split('-');
        date = new Date(year, month - 1, day);
    } else {
        date = new Date(fecha);
    }
    
    // Verificar si la fecha es válida
    if (isNaN(date.getTime())) return 'N/A';
    
    return date.toLocaleDateString('es-ES', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}

// Función auxiliar para formatear fecha y hora
function formatearFechaHoraLocal(fecha) {
    if (!fecha) return 'N/A';
    
    const date = new Date(fecha);
    if (isNaN(date.getTime())) return 'N/A';
    
    return date.toLocaleString('es-ES', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });
}
%>

<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex">
            <a class="btn btn-primary btn-navbar" href="/aprendiz/dashboard">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar al Dashboard
            </a>
        </div>
    </div>
</nav>

<%- contentFor('body') %>
<div class="container mt-4 mb-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Mi Perfil de Aprendiz</h2>
        </div>
        <div class="card-body">
            <% if (typeof aprendiz !== 'undefined' && aprendiz) { %>
                
                <!-- Sección de Foto de Perfil -->
                <div class="profile-photo-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-display">
                            <% 
                            // Construir la ruta correcta de la foto
                            let rutaFoto = null;
                            if (aprendiz.fotoPerfilPath) {
                                // Si tiene fotoPerfilPath, usarla (puede ser ruta relativa ya correcta)
                                rutaFoto = aprendiz.fotoPerfilPath.startsWith('/') ? aprendiz.fotoPerfilPath : '/' + aprendiz.fotoPerfilPath;
                            } else if (aprendiz.fotoPerfil) {
                                // Si solo tiene fotoPerfil (nombre del archivo), construir ruta completa
                                rutaFoto = `/uploads/fotos/optimized/${aprendiz.fotoPerfil}`;
                            }
                            %>
                            
                            <% if (rutaFoto) { %>
                                <img src="<%= rutaFoto %>" alt="Foto de perfil de <%= aprendiz.nombres %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="profile-photo-placeholder" style="display: none;">
                                    <i class="fas fa-user"></i>
                                    <span>Sin foto</span>
                                </div>
                            <% } else { %>
                                <div class="profile-photo-placeholder">
                                    <i class="fas fa-user"></i>
                                    <span>Sin foto</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <p><strong>Nombres:</strong> <%= aprendiz.nombres || 'N/A' %></p>
                <p><strong>Primer Apellido:</strong> <%= aprendiz.primerApellido || 'N/A' %></p>
                <p><strong>Segundo Apellido:</strong> <%= aprendiz.segundoApellido || 'N/A' %></p>
                <p><strong>Tipo de Documento:</strong> <%= aprendiz.tipoDocumento || 'N/A' %></p>
                <p><strong>Número de Documento:</strong> <%= aprendiz.numeroDocumento || 'N/A' %></p>
                <p><strong>Correo Electrónico:</strong> <%= aprendiz.correoElectronico || 'N/A' %></p>
                <p><strong>Teléfono Fijo:</strong> <%= aprendiz.telefonoFijo || 'N/A' %></p>
                <p><strong>Número de Celular:</strong> <%= aprendiz.celular || 'N/A' %></p>
                <p><strong>Dirección:</strong> <%= aprendiz.direccion || 'N/A' %></p>
                <p><strong>Barrio:</strong> <%= aprendiz.barrio || 'N/A' %></p>
                <p><strong>Departamento:</strong> <%= aprendiz.departamento || 'N/A' %></p>
                <p><strong>Municipio:</strong> <%= aprendiz.municipio || 'N/A' %></p>
                <p><strong>Fecha de Nacimiento:</strong> <%= formatearFechaLocal(aprendiz.fechaNacimiento) %></p>
                <p><strong>Género:</strong> <%= aprendiz.genero || 'N/A' %></p>
                <p><strong>Programa de Formación:</strong> <%= aprendiz.programaFormacion || 'N/A' %></p>
                <p><strong>Ficha:</strong> <%= aprendiz.numeroFicha || 'N/A' %></p>
                <p><strong>Estado de Formación:</strong> <%= aprendiz.estadoFormacion ? aprendiz.estadoFormacion.charAt(0).toUpperCase() + aprendiz.estadoFormacion.slice(1) : 'N/A' %></p>
                <p><strong>Alternativa Seleccionada:</strong> <%= aprendiz.alternativaSeleccionada ? aprendiz.alternativaSeleccionada.toUpperCase() : 'N/A' %></p>
                <p><strong>EPS:</strong> <%= aprendiz.eps || 'N/A' %></p>
                <p><strong>Fecha Inicio Etapa Lectiva:</strong> <%= formatearFechaLocal(aprendiz.fechaInicioLectiva) %></p>
                <p><strong>Fecha Fin Etapa Lectiva:</strong> <%= formatearFechaLocal(aprendiz.fechaFinLectiva) %></p>
                <p><strong>Instructor Etapa Lectiva:</strong> <%= aprendiz.instructorLectiva || 'N/A' %></p>
                <p><strong>Instructor Etapa Productiva:</strong> <%= aprendiz.instructorProductiva || 'N/A' %></p>
                <p><strong>Área de Formación:</strong> <%= aprendiz.areaFormacion ? aprendiz.areaFormacion.toUpperCase() : 'N/A' %></p>
                <p><strong>Fecha Inicio Etapa Productiva:</strong> <%= formatearFechaLocal(aprendiz.fechaInicioProductiva) %></p>
                <p><strong>Fecha Fin Etapa Productiva:</strong> <%= formatearFechaLocal(aprendiz.fechaFinProductiva) %></p>
                <p><strong>Empresa Patrocinadora:</strong> <%= aprendiz.empresaPatrocinadora || 'N/A' %></p>
                <p><strong>Área donde Realiza la Práctica:</strong> <%= aprendiz.areaPractica || 'N/A' %></p>
                <p><strong>Nombre del Jefe Inmediato:</strong> <%= aprendiz.jefeInmediato || 'N/A' %></p>
                <p><strong>Teléfono Fijo Empresa:</strong> <%= aprendiz.telefonoEmpresa || 'N/A' %></p>
                <p><strong>Celular Empresa:</strong> <%= aprendiz.celularEmpresa || 'N/A' %></p>
                <p><strong>Dirección Empresa:</strong> <%= aprendiz.direccionEmpresa || 'N/A' %></p>
                <p><strong>Correo Empresa:</strong> <%= aprendiz.correoEmpresa || 'N/A' %></p>
                <p><strong>Horario:</strong> <%= aprendiz.horario || 'N/A' %></p>
                <p><strong>Fecha de Registro:</strong> <%= formatearFechaHoraLocal(aprendiz.created_at) %></p>

                <div class="mt-4 text-center">
                    <a href="/aprendiz/perfil/editar" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Editar Perfil
                    </a>
                </div>

            <% } else { %>
                <div class="alert alert-danger">
                    No se encontró información para su perfil.
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
