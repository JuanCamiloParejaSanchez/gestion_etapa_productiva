<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <ul class="navbar-nav me-auto">
             <li class="nav-item">
                <a class="nav-link" href="/administrador/listar-aprendices">
                    <i class="fas fa-arrow-left me-2"></i>
                    Regresar al Listado
                </a>
            </li>
        </ul>
        <!-- El botón de cerrar sesión ha sido eliminado de esta vista -->
    </div>
</nav>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>

<%- contentFor('body') %>

<div class="container-fluid mt-4">
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">Información del Aprendiz</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title"><%= aprendiz.nombres %> <%= aprendiz.primerApellido %> <%= aprendiz.segundoApellido %></h5>
            <p class="card-text"><strong>Documento:</strong> <%= aprendiz.tipoDocumento %> - <%= aprendiz.numeroDocumento %></p>
            <p class="card-text"><strong>Programa de Formación:</strong> <%= aprendiz.programaFormacion %></p>
            <p class="card-text"><strong>Email:</strong> <%= aprendiz.correoElectronico %></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Documentos Entregados</h4>
        </div>
        <div class="card-body">
            <% if (documentos && documentos.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Tipo de Documento</th>
                                <th>Descripción</th>
                                <th>Nombre del Archivo</th>
                                <th>Fecha de Subida</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% documentos.forEach(doc => { %>
                                <%
                                    // Hacemos el código robusto para aceptar tanto camelCase como snake_case
                                    const tipoDocumento = doc.tipoDocumento || doc.tipo_documento;
                                    const descripcion = doc.descripcion;
                                    const nombreOriginal = doc.nombreOriginal || doc.nombre_original;
                                    const fechaSubida = doc.fechaSubida || doc.fecha_subida;
                                    const nombreGuardado = doc.nombreGuardado || doc.nombre_guardado;
                                %>
                                <tr>
                                    <td><%= tipoDocumento %></td>
                                    <td><%= descripcion || 'N/A' %></td>
                                    <td><%= nombreOriginal %></td>
                                    <td><%= new Date(fechaSubida).toLocaleDateString() %></td>
                                    <td>
                                        <a href="/uploads/documentos/<%= nombreGuardado %>" class="btn btn-primary btn-sm" target="_blank" title="Ver Documento">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-warning" role="alert">
                    El aprendiz aún no ha subido ningún documento.
                </div>
            <% } %>
        </div>
    </div>
</div>
