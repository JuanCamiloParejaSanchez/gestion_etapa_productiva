{
  "name": "gestion-etapa-productiva",
  "version": "1.0.0",
  "description": "Sistema de gestión para la etapa productiva del SENA",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "nodemon src/servidor.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:opciones": "node scripts/test-opciones-centralizadas.js",
    "start-sync": "browser-sync start --proxy \"localhost:3000\" --files views,public --ui-port 3100",
    "pm2:start": "pm2 start ecosystem.config.js --env development",
    "pm2:start:dev": "pm2 start ecosystem.config.js --only gestion-etapa-productiva-dev",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "kill-port": "scripts\\kill-port.bat",
    "kill-ports": "scripts\\kill-node-ports.bat",
    "clean": "npm run kill-ports && npm run pm2:delete",
    "dev:clean": "npm run clean && npm run pm2:start:dev",
    "prod:start": "npm run pm2:start -- --env production"
  },
  "keywords": [
    "sena",
    "etapa-productiva",
    "aprendices",
    "gestion"
  ],
  "author": "JuanBogotá",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.1",
    "archiver": "^6.0.1",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "ibm-watson": "^12.1.1",
    "joi": "^18.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "natural": "^6.12.0",
    "nodemailer": "^7.0.10",
    "redis": "^5.8.2",
    "sentiment": "^5.0.2",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.0.13",
    "docx": "^9.5.1",
    "eslint": "^9.37.0",
    "jest": "^30.1.3",
    "markdown-it": "^14.1.0",
    "marked": "^16.4.1",
    "nodemon": "^3.0.2",
    "puppeteer": "^24.28.0",
    "supertest": "^7.1.4"
  }
}
