                            <p><strong>Nombre:</strong> ${nombreCompleto}</p>
                            <p><strong>Documento:</strong> ${tipoYDocumento}</p>
                            <p><strong>Programa:</strong> ${aprendizInfo.programaFormacion || 'No especificado'}</p>
                            ${aprendizInfo.correoElectronico ? `<p><strong>Email:</strong> ${aprendizInfo.correoElectronico}</p>` : ''}
                        </div>

                        <div class="resumen">
                            <div class="resumen-item">
                                <h3>${numSubidos}</h3>
                                <p>Docs Subidos</p>
                            </div>
                            <div class="resumen-item">
                                <h3>${numPendientes}</h3>
                                <p>Docs Pendientes</p>
