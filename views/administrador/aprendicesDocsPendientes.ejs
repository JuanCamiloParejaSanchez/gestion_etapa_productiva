        // Función para cargar documentos del aprendiz
        async function cargarDocumentosAprendiz(numeroDocumento) {
            try {
                const response = await fetch(`/administrador/aprendiz/${numeroDocumento}/documentos`, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error(`Error: ${response.status}`);
                }

                const data = await response.json();
                return data;
            } catch (error) {
                console.error('Error al cargar documentos:', error);
                throw error;
            }
        }

        // Función para formatear fecha
        function formatearFechaModal(fecha) {
            if (!fecha) return '';
            const date = new Date(fecha);
            return date.toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }

        // Función para mostrar documentos en el modal
        function mostrarDocumentosEnModal(documentosData, aprendizInfo) {
            // Usar información del aprendiz desde la respuesta del servidor si está disponible
            const infoAprendiz = documentosData.aprendiz || aprendizInfo;
            
            // Construir nombre completo
            const nombreCompleto = `${infoAprendiz.nombres} ${infoAprendiz.primerApellido} ${infoAprendiz.segundoApellido || ''}`.trim();
            
            // Construir información adicional
            const tipoYNumeroDoc = `${infoAprendiz.tipoDocumento} - ${infoAprendiz.numeroDocumento}`;
            const programa = infoAprendiz.programaFormacion || 'Programa no especificado';
            
            // Actualizar información del aprendiz en el modal
            document.getElementById('aprendizNombre').textContent = nombreCompleto;
            document.getElementById('aprendizInfo').textContent = `${tipoYNumeroDoc} • ${programa}`;

            // Separar documentos subidos y pendientes
            const documentosSubidos = documentosData.subidos || [];
            const documentosPendientes = documentosData.pendientes || [];

            // Actualizar contadores
            document.getElementById('contadorSubidos').textContent = documentosSubidos.length;
            document.getElementById('contadorPendientes').textContent = documentosPendientes.length;

            // Contenedores
            const contenedorSubidos = document.getElementById('documentosSubidos');
            const contenedorPendientes = document.getElementById('documentosPendientes');

            // Limpiar contenedores
            contenedorSubidos.innerHTML = '';
            contenedorPendientes.innerHTML = '';

            // Mostrar documentos subidos
            if (documentosSubidos.length > 0) {
                documentosSubidos.forEach(doc => {
                    const fechaSubida = doc.fechaSubida || doc.fecha_subida;
                    const nombreOriginal = doc.nombreOriginal || doc.nombre_original;
                    const nombreGuardado = doc.nombreGuardado || doc.nombre_guardado;
                    const tipoDocumento = doc.tipoDocumento || doc.tipo_documento;
                    const descripcion = doc.descripcion || '';
                    const tamanoBytes = doc.tamanoBytes || doc.tamano_bytes || 0;

                    // Calcular tamaño en MB
                    const tamanoMB = (tamanoBytes / (1024 * 1024)).toFixed(2);

                    // Determinar tipo de archivo para el icono
                    const extension = nombreOriginal.split('.').pop()?.toLowerCase() || '';
                    let iconoArchivo = 'fas fa-file';
                    let colorIcono = '#6c757d';
                    
                    switch(extension) {
                        case 'pdf':
                            iconoArchivo = 'fas fa-file-pdf';
                            colorIcono = '#dc3545';
                            break;
                        case 'doc':
                        case 'docx':
                            iconoArchivo = 'fas fa-file-word';
                            colorIcono = '#0d6efd';
                            break;
                        case 'xls':
                        case 'xlsx':
                            iconoArchivo = 'fas fa-file-excel';
                            colorIcono = '#198754';
                            break;
                        case 'jpg':
                        case 'jpeg':
                        case 'png':
                            iconoArchivo = 'fas fa-file-image';
                            colorIcono = '#fd7e14';
                            break;
                    }

                    const docElement = document.createElement('div');
                    docElement.className = 'documento-item subido';
                    docElement.innerHTML = `
                        <i class="${iconoArchivo}" style="color: ${colorIcono}; font-size: var(--font-size-2xl);"></i>
                        <div class="documento-info">
                            <div class="documento-nombre">${nombreOriginal}</div>
                            <div class="documento-tipo">${tipoDocumento}</div>
                            ${descripcion ? `<div class="documento-descripcion">${descripcion}</div>` : ''}
                            <div class="documento-detalles">
                                <small>${tamanoMB} MB</small>
                            </div>
                        </div>
                        <div class="documento-estado">
                            <span class="estado-badge subido">Subido</span>
                            <div class="documento-fecha">${formatearFechaModal(fechaSubida)}</div>
                        </div>
                        <div class="documento-acciones">
                            <a href="/uploads/documentos/${nombreGuardado}"
                               class="btn-documento btn-ver"
                               target="_blank"
                               title="Ver documento">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    `;
                    contenedorSubidos.appendChild(docElement);
                });
            } else {
                contenedorSubidos.innerHTML = `
                    <div class="documentos-vacio">
                        <i class="fas fa-folder-open"></i>
                        <p>No hay documentos subidos</p>
                    </div>
                `;
            }

            // Mostrar documentos pendientes
            if (documentosPendientes.length > 0) {
                documentosPendientes.forEach(doc => {
                    const docElement = document.createElement('div');
                    docElement.className = 'documento-item pendiente';
                    docElement.innerHTML = `
                        <i class="fas fa-exclamation-circle" style="color: #dc3545; font-size: var(--font-size-2xl);"></i>
                        <div class="documento-info">
                            <div class="documento-nombre">${doc.nombre}</div>
                            <div class="documento-tipo">${doc.tipo}</div>
                        </div>
                        <div class="documento-estado">
                            <span class="estado-badge pendiente">Pendiente</span>
                            <div class="documento-fecha">Sin subir</div>
                        </div>
                    `;
                    contenedorPendientes.appendChild(docElement);
                });
            } else {
                contenedorPendientes.innerHTML = `
                    <div class="documentos-vacio">
                        <i class="fas fa-check-circle"></i>
                        <p>Todos los documentos han sido subidos</p>
                    </div>
                `;
            }

            // Configurar botón "Exportar PDF"
            document.getElementById('btnExportarPDF').onclick = function() {
                exportarModalAPDF(infoAprendiz);
            };
        }

        // Evento para abrir modal de documentos
        $(document).on('click', '.btn-ver-documentos', async function() {
            const boton = this;
            const numeroDocumento = boton.dataset.aprendizId;
            
            // Información básica del aprendiz desde los atributos del botón (fallback)
            const aprendizInfoFallback = {
                nombres: boton.dataset.aprendizNombre?.split(' ')[0] || '',
                primerApellido: boton.dataset.aprendizNombre?.split(' ')[1] || '',
                segundoApellido: boton.dataset.aprendizNombre?.split(' ').slice(2).join(' ') || '',
                tipoDocumento: boton.dataset.aprendizDocumento?.split(' - ')[0] || '',
                numeroDocumento: numeroDocumento,
                programaFormacion: boton.dataset.aprendizPrograma || '',
                correoElectronico: boton.dataset.aprendizEmail || ''
            };

            // Mostrar loading
            const modal = new bootstrap.Modal(document.getElementById('modalDocumentosAprendiz'));
            modal.show();

            // Mostrar estado de carga
            document.getElementById('aprendizNombre').textContent = 'Cargando...';
            document.getElementById('aprendizInfo').textContent = 'Obteniendo información...';
            document.getElementById('documentosSubidos').innerHTML = `
                <div class="loading-documentos">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p>Cargando documentos...</p>
                </div>
            `;
            document.getElementById('documentosPendientes').innerHTML = '';

            try {
                const documentosData = await cargarDocumentosAprendiz(numeroDocumento);
                
                // Si el servidor devolvió la información del aprendiz, usarla; si no, usar el fallback
                const infoCompleta = documentosData.aprendiz || aprendizInfoFallback;
                
                mostrarDocumentosEnModal(documentosData, infoCompleta);
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('aprendizNombre').textContent = 'Error';
                document.getElementById('aprendizInfo').textContent = 'No se pudo cargar la información';
                document.getElementById('documentosSubidos').innerHTML = `
                    <div class="documentos-vacio">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p>Error al cargar los documentos. Intente nuevamente.</p>
                    </div>
                `;
                document.getElementById('documentosPendientes').innerHTML = '';
            }
        });
    });
</script>