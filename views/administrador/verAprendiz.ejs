<!-- Ruta: vistas/administrador/verAprendiz.ejs -->
<!-- Propósito: Muestra los detalles completos de un aprendiz seleccionado en un formato legible.
     Permite visualizar toda la información registrada de un aprendiz específico. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<%- contentFor('styles') %>

<%- contentFor('body') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <ul class="navbar-nav">
            <li class="nav-item">
                <!-- <a class="nav-link" href="/administrador/listar-aprendices">Regresar</a> -->
                <a href="/administrador/listar-aprendices" class="btn btn-primary">
                    <i class="fas fa-arrow-left me-2"></i>
                    Regresar
                </a>
            </li>
        </ul>
    </div>
</nav>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Detalles del Aprendiz</h2>
        </div>
        <div class="card-body">
            <% for (let key in aprendiz) { %>
                <% if (key !== 'id' && key !== 'created_at') { %>
                    <div class="mb-3">
                        <strong><%= key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1').trim() %>:</strong>
                        <% if (key.toLowerCase().includes('fecha')) { %>
                            <%= new Date(aprendiz[key]).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                        <% } else { %>
                            <%= aprendiz[key] %>
                        <% } %>
                    </div>
                <% } %>
            <% } %>
        </div>
        <div class="card-footer">
            <a href="/administrador/listar-aprendices" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>