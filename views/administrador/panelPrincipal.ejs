<!-- Ruta: vistas/administrador/panelPrincipal.ejs -->
<!-- Propósito: Panel principal del administrador con acceso a las funcionalidades clave. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">

<%- contentFor('navigation') %>
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-end">
             <a href="#" class="btn btn-primary btn-navbar" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                <i class="fas fa-sign-out-alt me-2"></i>
                Cerrar Sesión
            </a>
        </div>
    </div>
</nav>


<%- contentFor('body') %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12 mb-4">
            <h1 class="mb-0">Bienvenido, <%= user.name %>!</h1>
            <p class="lead">Gestiona y supervisa la información de los aprendices y del sistema.</p>
        </div>
    </div>
    
    <div class="row">
        <!-- Tarjeta de Mi Información Personal -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-orange text-white">
                    <h5 class="card-title mb-0">Mi Información Personal</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Accede y actualiza tus datos de contacto y detalles personales como administrador.</p>
                    <a href="/administrador/perfil" class="btn btn-orange w-100 mt-3">
                        <i class="fas fa-user-edit me-2"></i>
                        Ver Mi Perfil
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Gestión de Aprendices -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Gestión de Aprendices</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Visualiza, edita y gestiona la información de todos los aprendices registrados.</p>
                    <a href="/administrador/listar-aprendices" class="btn btn-primary w-100 mt-3">
                        <i class="fas fa-users me-2"></i>
                        Listar Aprendices
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Documentos Pendientes del Aprendiz -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-warning text-white">
                    <h5 class="card-title mb-0">Documentos Pendientes del Aprendiz</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Revisa y gestiona los documentos pendientes de entrega por parte de los aprendices.</p>
                    <a href="/administrador/alertas/bitacora" class="btn btn-warning w-100 mt-3">
                        <i class="fas fa-book me-2"></i>
                        Ver Documentos Pendientes
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Reportes y Estadísticas -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">Reportes y Estadísticas</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Analiza datos y visualiza métricas clave sobre el progreso de los aprendices.</p>
                    <a href="/administrador/reportes" class="btn btn-info w-100 mt-3">
                        <i class="fas fa-chart-pie me-2"></i>
                        Ver Reportes
                    </a>
                </div>
            </div>
        </div>
        <!-- Tarjeta para Gestión de Administradores -->
        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">Gestión de Administradores</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Visualiza y gestiona la información de todos los administradores registrados.</p>
                    <a href="/administrador/listar-administradores" class="btn btn-success w-100 mt-3">
                        <i class="fas fa-user-shield me-2"></i>
                        Listar Administradores
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Prevenir cualquier inicialización de DataTables en el panel principal
        window.skipDataTableInit = true;
        
        // Limpiar cualquier tabla DataTable residual
        if ($.fn.DataTable && $.fn.DataTable.isDataTable('#aprendicesTable')) {
            $('#aprendicesTable').DataTable().destroy();
            console.log('Tabla DataTable residual eliminada');
        }
        
        // Evitar que se ejecuten scripts de ordenamiento de tabla
        if (window.OrdenamientoTabla) {
            console.log('Prevención de inicialización de OrdenamientoTabla en panel principal');
            return;
        }
        
        // Lógica específica del panel principal
        console.log('Panel principal cargado correctamente');
        
        // Verificar que no hay elementos de tabla que no deberían estar aquí
        const tablaAprendices = document.getElementById('aprendicesTable');
        if (tablaAprendices) {
            console.warn('¡ADVERTENCIA! Se encontró tabla aprendicesTable en panel principal');
            tablaAprendices.remove();
        }
    });
</script>

<!-- Modal de Confirmación de Cierre de Sesión -->
<div class="modal fade confirm-logout-modal" id="confirmLogoutModal" tabindex="-1" aria-labelledby="confirmLogoutModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmLogoutModalLabel">
          <i class="fas fa-sign-out-alt me-2"></i>
          Confirmar Cierre de Sesión
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <i class="fas fa-question-circle text-warning" style="font-size: 4rem;"></i>
        </div>
        <h4 class="text-warning mb-3">¿Estás seguro?</h4>
        <p class="mb-0">¿Estás seguro de que deseas cerrar sesión?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
          <i class="fas fa-times me-2"></i>
          Cancelar
        </button>
        <button type="button" class="btn btn-warning px-4" id="confirmLogoutBtn">
          <i class="fas fa-sign-out-alt me-2"></i>
          Cerrar Sesión
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('confirmLogoutBtn').addEventListener('click', function() {
  window.location.href = '/auth/logout';
});
</script>
