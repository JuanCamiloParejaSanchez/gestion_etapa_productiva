<!-- Ruta: vistas/administrador/editarAprendiz.ejs -->
<!-- Propósito: Interfaz para modificar la información de un aprendiz existente.
     Permite actualizar todos los campos del registro de un aprendiz. -->

<%- contentFor('styles') %>
<link rel="stylesheet" href="/estilos/base/variables.css">
<link rel="stylesheet" href="/estilos/base/layout.css">
<link rel="stylesheet" href="/estilos/components/navbar.css">
<link rel="stylesheet" href="/estilos/components/buttons.css">
<link rel="stylesheet" href="/estilos/components/forms.css">
<link rel="stylesheet" href="/estilos/general/estilosBase.css">
<%- contentFor('styles') %>

<%- contentFor('body') %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <div class="d-flex w-100 justify-content-start">
            <a class="btn btn-primary btn-navbar" href="/administrador/listar-aprendices">
                <i class="fas fa-arrow-left me-2"></i>
                Regresar a la lista
            </a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">Editar Aprendiz</h2>
        </div>
        <div class="card-body">
            <div id="messageContainer"></div>

            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <%= successMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <%= errorMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

    <% if (typeof aprendiz !== 'undefined') { %>
                <form id="editarAprendizForm"
                      data-tipo="admin"
                      method="POST"
                      action="/administrador/aprendiz/actualizar/<%= aprendiz.id %>">
            
            <!-- Nombres -->
            <div class="mb-3">
                <label for="nombres" class="form-label">Nombres</label>
                <input type="text" class="form-control" id="nombres" name="nombres" value="<%= aprendiz.nombres || '' %>">
            </div>

            <!-- Primer Apellido -->
            <div class="mb-3">
                <label for="primerApellido" class="form-label">Primer Apellido</label>
                <input type="text" class="form-control" id="primerApellido" name="primerApellido" value="<%= aprendiz.primerApellido || '' %>">
            </div>

            <!-- Segundo Apellido -->
            <div class="mb-3">
                <label for="segundoApellido" class="form-label">Segundo Apellido</label>
                <input type="text" class="form-control" id="segundoApellido" name="segundoApellido" value="<%= aprendiz.segundoApellido || '' %>">
            </div>

            <!-- Tipo de Documento -->
            <div class="mb-3">
                <label for="tipoDocumento" class="form-label">Tipo de Documento</label>
                <select class="form-select" id="tipoDocumento" name="tipoDocumento">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- Número de Documento -->
            <div class="mb-3">
                <label for="numeroDocumento" class="form-label">Número de Documento</label>
                <input type="text" class="form-control" id="numeroDocumento" name="numeroDocumento" value="<%= aprendiz.numeroDocumento || '' %>">
            </div>

            <!-- Correo Electrónico -->
            <div class="mb-3">
                <label for="correoElectronico" class="form-label">Correo Electrónico</label>
                <input type="text" class="form-control" id="correoElectronico" name="correoElectronico" value="<%= aprendiz.correoElectronico || '' %>">
            </div>

            <!-- Teléfono Fijo -->
            <div class="mb-3">
                <label for="telefonoFijo" class="form-label">Teléfono Fijo</label>
                <input type="tel" class="form-control" id="telefonoFijo" name="telefonoFijo" 
                       value="<%= aprendiz.telefonoFijo || '' %>" 
                       minlength="10" maxlength="10" pattern="\d{10}" 
                       title="Debe contener exactamente 10 dígitos">
            </div>

            <!-- Número de Celular -->
            <div class="mb-3">
                <label for="celular" class="form-label">Número de Celular</label>
                <input type="tel" class="form-control" id="celular" name="celular" 
                       value="<%= aprendiz.celular || '' %>" 
                       minlength="10" maxlength="10" pattern="\d{10}" 
                       title="Debe contener exactamente 10 dígitos">
            </div>

            <!-- Dirección -->
            <div class="mb-3">
                <label for="direccion" class="form-label">Dirección</label>
                <input type="text" class="form-control" id="direccion" name="direccion" value="<%= aprendiz.direccion || '' %>">
            </div>

            <!-- Barrio -->
            <div class="mb-3">
                <label for="barrio" class="form-label">Barrio</label>
                <input type="text" class="form-control" id="barrio" name="barrio" value="<%= aprendiz.barrio || '' %>">
            </div>

            <!-- Departamento -->
            <div class="mb-3">
                <label for="departamento" class="form-label">Departamento</label>
                <select class="form-select" id="departamento" name="departamento">
                    <option value="">SELECCIONE...</option>
                </select>
            </div>

            <!-- Municipio -->
            <div class="mb-3">
                <label for="municipio" class="form-label">Municipio</label>
                <select class="form-select" id="municipio" name="municipio">
                    <option value="">SELECCIONE UN MUNICIPIO...</option>
                </select>
            </div>

            <!-- Fecha de Nacimiento -->
            <div class="mb-3">
                <label for="fechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                <input type="date" class="form-control" id="fechaNacimiento" name="fechaNacimiento" 
                       value="<%= aprendiz.fechaNacimiento ? new Date(aprendiz.fechaNacimiento).toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Género -->
            <div class="mb-3">
                <label for="genero" class="form-label">Género</label>
                <select class="form-select" id="genero" name="genero">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- Programa de Formación -->
            <div class="mb-3">
                <label for="programaFormacion" class="form-label">Programa de Formación</label>
                <select class="form-select" id="programaFormacion" name="programaFormacion">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- Ficha -->
            <div class="mb-3">
                <label for="numeroFicha" class="form-label">Ficha</label>
                <input type="text" class="form-control" id="numeroFicha" name="numeroFicha" value="<%= aprendiz.numeroFicha || '' %>">
            </div>

            <!-- Estado de Formación -->
            <div class="mb-3">
                <label for="estadoFormacion" class="form-label">Estado de Formación</label>
                <select class="form-select" id="estadoFormacion" name="estadoFormacion">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- Alternativa Seleccionada -->
            <div class="mb-3">
                <label for="alternativaSeleccionada" class="form-label">Alternativa Seleccionada</label>
                <select class="form-select" id="alternativaSeleccionada" name="alternativaSeleccionada">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- EPS -->
            <div class="mb-3">
                <label for="eps" class="form-label">EPS</label>
                <select class="form-select" id="eps" name="eps">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- Fecha Inicio Etapa Lectiva -->
            <div class="mb-3">
                <label for="fechaInicioLectiva" class="form-label">Fecha Inicio Etapa Lectiva</label>
                <input type="date" class="form-control" id="fechaInicioLectiva" name="fechaInicioLectiva" 
                       value="<%= aprendiz.fechaInicioLectiva ? new Date(aprendiz.fechaInicioLectiva).toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Fecha Fin Etapa Lectiva -->
            <div class="mb-3">
                <label for="fechaFinLectiva" class="form-label">Fecha Fin Etapa Lectiva</label>
                <input type="date" class="form-control" id="fechaFinLectiva" name="fechaFinLectiva" 
                       value="<%= aprendiz.fechaFinLectiva ? new Date(aprendiz.fechaFinLectiva).toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Instructor Etapa Lectiva -->
            <div class="mb-3">
                <label for="instructorLectiva" class="form-label">Instructor Etapa Lectiva</label>
                <input type="text" class="form-control" id="instructorLectiva" name="instructorLectiva" value="<%= aprendiz.instructorLectiva || '' %>">
            </div>

            <!-- Instructor Etapa Productiva -->
            <div class="mb-3">
                <label for="instructorProductiva" class="form-label">Instructor Etapa Productiva</label>
                <input type="text" class="form-control" id="instructorProductiva" name="instructorProductiva" value="<%= aprendiz.instructorProductiva || '' %>">
            </div>

            <!-- Área de Formación -->
            <div class="mb-3">
                <label for="areaFormacion" class="form-label">Área de Formación</label>
                <select class="form-select" id="areaFormacion" name="areaFormacion">
                    <option value="">SELECCIONE...</option>
                    <!-- Las opciones se cargarán dinámicamente -->
                </select>
            </div>

            <!-- Fecha Inicio Etapa Productiva -->
            <div class="mb-3">
                <label for="fechaInicioProductiva" class="form-label">Fecha Inicio Etapa Productiva</label>
                <input type="date" class="form-control" id="fechaInicioProductiva" name="fechaInicioProductiva" 
                       value="<%= aprendiz.fechaInicioProductiva ? new Date(aprendiz.fechaInicioProductiva).toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Fecha Fin Etapa Productiva -->
            <div class="mb-3">
                <label for="fechaFinProductiva" class="form-label">Fecha Fin Etapa Productiva</label>
                <input type="date" class="form-control" id="fechaFinProductiva" name="fechaFinProductiva" 
                       value="<%= aprendiz.fechaFinProductiva ? new Date(aprendiz.fechaFinProductiva).toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Empresa Patrocinadora -->
            <div class="mb-3">
                <label for="empresaPatrocinadora" class="form-label">Empresa Patrocinadora</label>
                <input type="text" class="form-control" id="empresaPatrocinadora" name="empresaPatrocinadora" value="<%= aprendiz.empresaPatrocinadora || '' %>">
            </div>

            <!-- Área donde Realiza la Práctica -->
            <div class="mb-3">
                <label for="areaPractica" class="form-label">Área donde Realiza la Práctica</label>
                <input type="text" class="form-control" id="areaPractica" name="areaPractica" value="<%= aprendiz.areaPractica || '' %>">
            </div>

            <!-- Nombre del Jefe Inmediato -->
            <div class="mb-3">
                <label for="jefeInmediato" class="form-label">Nombre del Jefe Inmediato</label>
                <input type="text" class="form-control" id="jefeInmediato" name="jefeInmediato" value="<%= aprendiz.jefeInmediato || '' %>">
            </div>

            <!-- Teléfono Fijo Empresa -->
            <div class="mb-3">
                <label for="telefonoEmpresa" class="form-label">Teléfono Fijo Empresa</label>
                <input type="tel" class="form-control" id="telefonoEmpresa" name="telefonoEmpresa" 
                       value="<%= aprendiz.telefonoEmpresa || '' %>" 
                       minlength="10" maxlength="10" pattern="\d{10}" 
                       title="Debe contener exactamente 10 dígitos">
            </div>

            <!-- Celular Empresa -->
            <div class="mb-3">
                <label for="celularEmpresa" class="form-label">Celular Empresa</label>
                <input type="tel" class="form-control" id="celularEmpresa" name="celularEmpresa" 
                       value="<%= aprendiz.celularEmpresa || '' %>" 
                       minlength="10" maxlength="10" pattern="\d{10}" 
                       title="Debe contener exactamente 10 dígitos">
            </div>

            <!-- Dirección Empresa -->
            <div class="mb-3">
                <label for="direccionEmpresa" class="form-label">Dirección Empresa</label>
                <input type="text" class="form-control" id="direccionEmpresa" name="direccionEmpresa" value="<%= aprendiz.direccionEmpresa || '' %>">
            </div>

            <!-- Correo Empresa -->
            <div class="mb-3">
                <label for="correoEmpresa" class="form-label">Correo Empresa</label>
                <input type="text" class="form-control" id="correoEmpresa" name="correoEmpresa" value="<%= aprendiz.correoEmpresa || '' %>">
            </div>

            <!-- Horario -->
            <div class="mb-3">
                <label for="horario" class="form-label">Horario</label>
                <input type="text" class="form-control" id="horario" name="horario" value="<%= aprendiz.horario || '' %>">
            </div>

            <!-- Fecha creación de usuario (solo lectura) -->
            <div class="mb-3">
                <label for="created_at" class="form-label">Fecha creación de usuario</label>
                <input type="text" class="form-control" id="created_at" name="created_at" 
                       value="<%= aprendiz.created_at ? new Date(aprendiz.created_at).toLocaleString('es-ES', {
                           weekday: 'long',
                           year: 'numeric',
                           month: 'long',
                           day: 'numeric',
                           hour: '2-digit',
                           minute: '2-digit',
                           second: '2-digit'
                       }) : '' %>" 
                       readonly>
            </div>

            <!-- Fecha última actualización (solo lectura) -->
            <div class="mb-3">
                <label for="updated_at" class="form-label">Fecha última actualización</label>
                <input type="text" class="form-control" id="updated_at" name="updated_at" 
                       value="<%= aprendiz.updated_at ? new Date(aprendiz.updated_at).toLocaleString('es-ES', {
                           weekday: 'long',
                           year: 'numeric',
                           month: 'long',
                           day: 'numeric',
                           hour: '2-digit',
                           minute: '2-digit',
                           second: '2-digit'
                       }) + ' - Usuario: ' + (typeof userName !== 'undefined' ? userName : 'Administrador') : '' %>" 
                       readonly>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>
                    Guardar Cambios
                </button>
                <a href="/administrador/listar-aprendices" class="btn btn-secondary btn-cancel-editar">Cancelar</a>
            </div>
        </form>
    <% } else { %>
        <div class="alert alert-danger">
            No se encontraron datos del aprendiz.
        </div>
            <% } %>
        </div>
    </div>
</div>
<!-- Modal de Éxito -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle me-2"></i>
                    ¡Éxito!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-check-circle text-success" style="font-size: var(--font-size-5xl);"></i>
                </div>
                <h4 class="text-success mb-3">Aprendiz Actualizado</h4>
                <p class="mb-0">La información del aprendiz ha sido actualizada exitosamente.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success px-4" id="confirmButton">
                    <i class="fas fa-check me-2"></i>
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Error -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error de Validación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size: var(--font-size-5xl);"></i>
                </div>
                <h4 class="text-danger mb-3">Fechas Inválidas</h4>
                <div id="errorModalBody"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>


<%- contentFor('scripts') %>
<script src="/js/utilidades/sessionTimeout.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('editarAprendizForm');
        const messageContainer = document.getElementById('messageContainer');
        
        // Variable para controlar si las opciones ya se cargaron
        let opcionesCargadas = false;

        // Animación de entrada
        document.querySelector('.container').style.opacity = '0';
        document.querySelector('.container').style.transform = 'translateY(20px)';

        setTimeout(() => {
            document.querySelector('.container').style.transition = 'all 0.5s ease-in-out';
            document.querySelector('.container').style.opacity = '1';
            document.querySelector('.container').style.transform = 'translateY(0)';
        }, 100);

        // ========================================
        // CARGAR OPCIONES DE FORMULARIO DINÁMICAMENTE
        // ========================================
        async function cargarOpcionesFormulario() {
            try {
                const response = await fetch('/administrador/opciones-filtros');
                
                if (!response.ok) {
                    throw new Error(`Error al cargar opciones: ${response.status}`);
                }
                
                const resultado = await response.json();
                
                if (resultado.success && resultado.data) {
                    const valorActual = {
                        tipoDocumento: '<%= aprendiz.tipoDocumento %>',
                        genero: '<%= aprendiz.genero %>',
                        eps: '<%= aprendiz.eps %>',
                        programaFormacion: '<%= aprendiz.programaFormacion %>',
                        alternativaSeleccionada: '<%= aprendiz.alternativaSeleccionada %>',
                        estadoFormacion: '<%= aprendiz.estadoFormacion %>',
                        areaFormacion: '<%= aprendiz.areaFormacion %>'
                    };
                    
                    // Cargar Tipo de Documento
                    const tipoDocSelect = document.getElementById('tipoDocumento');
                    if (tipoDocSelect && resultado.data.tipoDocumento) {
                        tipoDocSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        resultado.data.tipoDocumento.forEach((tipo) => {
                            const option = document.createElement('option');
                            option.value = tipo.value;
                            option.textContent = tipo.label;
                            if (tipo.value === valorActual.tipoDocumento) {
                                option.selected = true;
                            }
                            tipoDocSelect.appendChild(option);
                        });
                    }
                    
                    // Cargar Género
                    const generoSelect = document.getElementById('genero');
                    if (generoSelect && resultado.data.genero) {
                        generoSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        resultado.data.genero.forEach((gen) => {
                            const option = document.createElement('option');
                            option.value = gen.value;
                            option.textContent = gen.label;
                            if (gen.value === valorActual.genero) {
                                option.selected = true;
                            }
                            generoSelect.appendChild(option);
                        });
                    }
                    
                    // Cargar EPS
                    const epsSelect = document.getElementById('eps');
                    if (epsSelect && resultado.data.eps) {
                        epsSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        resultado.data.eps.forEach((eps) => {
                            const option = document.createElement('option');
                            option.value = eps.value;
                            option.textContent = eps.label;
                            if (eps.value === valorActual.eps) {
                                option.selected = true;
                            }
                            epsSelect.appendChild(option);
                        });
                    }
                    
                    // Cargar Programa de Formación
                    const programaSelect = document.getElementById('programaFormacion');
                    if (programaSelect && (resultado.data.programas || resultado.data.programaFormacion)) {
                        const programasData = resultado.data.programas || resultado.data.programaFormacion;
                        programaSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        
                        programasData.forEach((programa) => {
                            const option = document.createElement('option');
                            option.value = programa.value;
                            option.textContent = programa.label;
                            // Comparación case-insensitive
                            if (programa.value.toLowerCase() === valorActual.programaFormacion.toLowerCase()) {
                                option.selected = true;
                            }
                            programaSelect.appendChild(option);
                        });
                    }
                    
                    // Cargar Alternativa Seleccionada
                    const alternativaSelect = document.getElementById('alternativaSeleccionada');
                    if (alternativaSelect && (resultado.data.alternativas || resultado.data.alternativaSeleccionada)) {
                        const alternativasData = resultado.data.alternativas || resultado.data.alternativaSeleccionada;
                        alternativaSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        
                        alternativasData.forEach((alternativa) => {
                            const option = document.createElement('option');
                            option.value = alternativa.value;
                            option.textContent = alternativa.label;
                            // Comparación case-insensitive
                            if (alternativa.value.toLowerCase() === valorActual.alternativaSeleccionada.toLowerCase()) {
                                option.selected = true;
                            }
                            alternativaSelect.appendChild(option);
                        });
                    }
                    
                    // Cargar Estado de Formación
                    const estadoSelect = document.getElementById('estadoFormacion');
                    if (estadoSelect && resultado.data.estadoFormacion) {
                        estadoSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        resultado.data.estadoFormacion.forEach((estado) => {
                            const option = document.createElement('option');
                            option.value = estado.value;
                            option.textContent = estado.label;
                            if (estado.value === valorActual.estadoFormacion) {
                                option.selected = true;
                            }
                            estadoSelect.appendChild(option);
                        });
                    }
                    
                    // Cargar Área de Formación
                    const areaFormacionSelect = document.getElementById('areaFormacion');
                    if (areaFormacionSelect && resultado.data.areaFormacion) {
                        areaFormacionSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                        
                        resultado.data.areaFormacion.forEach((area) => {
                            const option = document.createElement('option');
                            option.value = area.value;
                            option.textContent = area.label;
                            // Comparación case-insensitive
                            if (area.value.toLowerCase() === valorActual.areaFormacion.toLowerCase()) {
                                option.selected = true;
                            }
                            areaFormacionSelect.appendChild(option);
                        });
                    }
                    
                    // Marcar que las opciones ya se cargaron
                    opcionesCargadas = true;
                } else {
                    console.error('Error: La respuesta no contiene datos válidos');
                }
            } catch (error) {
                console.error('Error al cargar opciones del formulario:', error);
                messageContainer.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        No se pudieron cargar algunas opciones del formulario. Por favor, recargue la página.
                    </div>
                `;
            }
        }
        
        // Cargar opciones al iniciar
        cargarOpcionesFormulario();

        if (form) {
            form.addEventListener('submit', async function(event) {
                event.preventDefault();
                
                // Verificar que las opciones se hayan cargado
                if (!opcionesCargadas) {
                    messageContainer.innerHTML = `
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Por favor espere a que se carguen todas las opciones del formulario.
                        </div>
                    `;
                    return;
                }
                
                // Validar que los campos de select tengan valores
                const camposRequeridos = [
                    { id: 'tipoDocumento', nombre: 'Tipo de Documento' },
                    { id: 'genero', nombre: 'Género' },
                    { id: 'eps', nombre: 'EPS' },
                    { id: 'programaFormacion', nombre: 'Programa de Formación' },
                    { id: 'alternativaSeleccionada', nombre: 'Alternativa Seleccionada' },
                    { id: 'estadoFormacion', nombre: 'Estado de Formación' },
                    { id: 'areaFormacion', nombre: 'Área de Formación' },
                    { id: 'departamento', nombre: 'Departamento' },
                    { id: 'municipio', nombre: 'Municipio' }
                ];
                
                let camposSinSeleccionar = [];
                camposRequeridos.forEach(campo => {
                    const elemento = document.getElementById(campo.id);
                    if (elemento && (!elemento.value || elemento.value === '')) {
                        camposSinSeleccionar.push(campo.nombre);
                    }
                });
                
                if (camposSinSeleccionar.length > 0) {
                    messageContainer.innerHTML = `
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Por favor complete los siguientes campos:</strong>
                            <ul class="mb-0 mt-2">
                                ${camposSinSeleccionar.map(campo => `<li>${campo}</li>`).join('')}
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    `;
                    // Scroll hacia el mensaje
                    messageContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }

                const submitButton = form.querySelector('button[type="submit"]');
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...';

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok) {
                        // Mostrar modal de éxito
                        const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                        successModal.show();

                        // Configurar el botón de aceptar para recargar la página
                        document.getElementById('confirmButton').addEventListener('click', function() {
                            window.location.reload();
                        });
                    } else {
                        throw new Error(result.message || 'Ocurrió un error en el servidor.');
                    }
                } catch (error) {
                    console.error('Error al enviar el formulario:', error);
                    messageContainer.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
                    submitButton.disabled = false;
                    submitButton.innerHTML = '<i class="fas fa-save me-2"></i> Guardar Cambios';
                }
            });
        } else {
            console.error('ERROR: El formulario no fue encontrado');
        }

        console.log('Formulario de edición de aprendiz cargado correctamente');

        // Cargar datos de ubicación para edición
        const cargarDatosUbicacionEdicion = async () => {
            try {
                const response = await fetch('/data/colombia.json');

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();

                const departamentoSelect = document.getElementById('departamento');
                const municipioSelect = document.getElementById('municipio');

                if (!departamentoSelect || !municipioSelect) {
                    console.error('Selectores de ubicación no encontrados');
                    return;
                }

                // Cargar departamentos
                departamentoSelect.innerHTML = '<option value="">SELECCIONE...</option>';
                const departamentoActual = '<%= aprendiz.departamento %>';
                
                data.forEach(item => {
                    if (item && item.departamento) {
                        const option = document.createElement('option');
                        option.value = item.departamento;
                        option.textContent = item.departamento.toUpperCase();
                        // Comparación case-insensitive
                        if (item.departamento.toLowerCase() === departamentoActual.toLowerCase()) {
                            option.selected = true;
                        }
                        departamentoSelect.appendChild(option);
                    }
                });

                // Evento change para departamentos
                departamentoSelect.addEventListener('change', function() {
                    const selectedDep = this.value;

                    municipioSelect.innerHTML = '<option value="">SELECCIONE UN MUNICIPIO...</option>';
                    if (!selectedDep) return;

                    const departamento = data.find(d => d.departamento === selectedDep);
                    if (departamento?.ciudades) {
                        departamento.ciudades.forEach(ciudad => {
                            const option = document.createElement('option');
                            option.value = ciudad;
                            option.textContent = ciudad.toUpperCase();
                            municipioSelect.appendChild(option);
                        });
                    }
                });

                // Cargar municipios del departamento actual si existe
                const currentDep = '<%= aprendiz.departamento %>';
                const currentMun = '<%= aprendiz.municipio %>';
                
                if (currentDep) {
                    // Buscar departamento con comparación case-insensitive
                    const departamento = data.find(d => d.departamento.toLowerCase() === currentDep.toLowerCase());
                    if (departamento?.ciudades) {
                        municipioSelect.innerHTML = '<option value="">SELECCIONE UN MUNICIPIO...</option>';
                        
                        departamento.ciudades.forEach(ciudad => {
                            const option = document.createElement('option');
                            option.value = ciudad;
                            option.textContent = ciudad.toUpperCase();
                            // Comparación case-insensitive
                            if (ciudad.toLowerCase() === currentMun.toLowerCase()) {
                                option.selected = true;
                            }
                            municipioSelect.appendChild(option);
                        });
                    }
                }

            } catch (error) {
                console.error('Error cargando datos de ubicación:', error);
            }
        };

        // Inicializar carga de datos de ubicación
        cargarDatosUbicacionEdicion();

        // Restringir entrada en campos de teléfono (solo dígitos)
        const telefonoInputs = document.querySelectorAll('#telefonoFijo, #celular, #telefonoEmpresa, #celularEmpresa');
        telefonoInputs.forEach(input => {
            if (input) {
                // Convertir a mayúsculas y restringir a solo números
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/\D/g, '');
                });
            }
        });
    });
</script>
